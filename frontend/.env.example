# Copy this file to `frontend/.env` to wire the site to your backend and (optionally) Supabase Auth.
# These are PUBLIC values: Astro inlines anything prefixed PUBLIC_ into the browser bundle at build time,
# so never put a secret here. In particular the Supabase `service_role` key must NOT appear in this file.

# The Worker the staff/customer screens call. Leave unset to run the submit screen in demo mode.
PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# ── Supabase Auth (staff sign-in) ──────────────────────────────────────────────
# Both are browser-safe by design: the anon key only ever acts within Row Level Security, and the
# password goes directly from this page to Supabase — our Worker never sees or stores it.
# Set BOTH to enable live email + password sign-in. Leave PUBLIC_SUPABASE_URL empty and the login pages
# fall back to the Worker's in-memory dev login (admin / staff), so local dev and the test suite keep working.

# From Supabase: Project Settings -> API -> Project URL (the same URL you give the Worker).
PUBLIC_SUPABASE_URL=

# From Supabase: Project Settings -> API -> `anon` public key (NOT the service_role secret).
PUBLIC_SUPABASE_ANON_KEY=
