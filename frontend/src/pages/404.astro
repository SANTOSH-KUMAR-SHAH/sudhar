---
// Business: Lost visitors need one clear way back to help, not a dead end.
// Technical: Standalone page (no heavy layout) so it renders for any bad URL.
import { SITE_PHONE_HREF } from '../lib/site';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page not found — Sudhar Lab</title>
  <link rel="icon" type="image/png" href="/logo.png" />
</head>
<body>
  <main class="nf">
    <img src="/logo.png" alt="Sudhar Lab" width="72" height="72" />
    <p class="nf-code">404</p>
    <h1>This page does not exist</h1>
    <p>The link may be old or mistyped. Your appliance can still get help.</p>
    <div class="nf-actions">
      <a href="/" class="nf-btn nf-primary">Back to home</a>
      <a href="/#request" class="nf-btn">Get my appliance checked</a>
      <a href={SITE_PHONE_HREF} class="nf-btn">Call Sudhar Lab</a>
    </div>
  </main>
</body>
</html>
<style>
    .nf { min-height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; padding: 2rem 1.25rem; text-align: center; font-family: "Manrope", system-ui, sans-serif; background: #F7F6F2; color: #10263D; }
    .nf-code { font-family: "Fraunces", Georgia, serif; font-weight: 600; font-size: 3rem; color: #0C7C82; margin: 0; }
    .nf h1 { font-family: "Fraunces", Georgia, serif; font-weight: 600; font-size: 1.5rem; margin: 0; }
  .nf p { color: #4A4E52; margin: 0 0 0.5rem; }
  .nf-actions { display: flex; gap: 0.625rem; flex-wrap: wrap; justify-content: center; }
  .nf-btn { padding: 0.75rem 1.25rem; border-radius: 8px; font-weight: 700; font-size: 0.875rem; text-decoration: none; border: 1px solid #E0DDD7; color: #10263D; background: #fff; }
  .nf-primary { background: #0C7C82; border-color: #0C7C82; color: #fff; }
</style>
