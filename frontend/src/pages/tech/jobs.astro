---
import TechDashboardLayout from '../../layouts/TechDashboardLayout.astro';
import {
  DEMO_LOGGED_IN_TECH_ID,
  getDemoCustomer,
  requestsForTechnician,
  isRequestDone,
  statusLabel,
} from '../../lib/demo-data';

// Business: "My Jobs" is the technician's slice of the one request table — the
// same rows the dispatcher assigned on the admin side, no second feed of mocks.
// Technical: Filter membership is stamped into data-group at build time from the
// canonical status predicates; job-filters.ts only reads those attributes back.
const myJobs = requestsForTechnician(DEMO_LOGGED_IN_TECH_ID)
  .map((r) => ({
    r,
    cust: getDemoCustomer(r.customerId),
    done: isRequestDone(r.status),
    group: isRequestDone(r.status) ? 'completed' : 'today',
  }))
  .sort((a, b) => (a.done ? 1 : 0) - (b.done ? 1 : 0));
---

<TechDashboardLayout title="Jobs" activeNav="jobs">
  <div class="feed-container">
    
    <div class="page-header">
      <h2>My Jobs</h2>
    </div>

    <!-- Filter Pills (Scrollable) -->
    <div class="filter-scroll" role="tablist" aria-label="Filter jobs">
      <button type="button" class="pill active" data-filter="today" role="tab" aria-selected="true">Today</button>
      <button type="button" class="pill" data-filter="upcoming" role="tab" aria-selected="false">Upcoming</button>
      <button type="button" class="pill" data-filter="completed" role="tab" aria-selected="false">Completed</button>
      <button type="button" class="pill" data-filter="all" role="tab" aria-selected="false">All</button>
    </div>

    <!-- Job Feed -->
    <div class="job-list" id="jobList">
      {myJobs.map(({ r, cust, done, group }) => (
        <a href={`/tech/jobs/${r.id}`} class={`job-card${done ? ' completed' : ''}`} data-group={group}>
          <div class="card-header">
            <span class="req tnum">#{r.id}</span>
            <span class={`badge ${done ? 'completed' : 'active'}`}>{done ? 'Completed' : statusLabel(r.status)}</span>
          </div>
          <div class="card-body">
            <div class="time">Today &middot; {r.visitTime}</div>
            <h3 class="appliance">{r.brand} {r.applianceType}</h3>
            <p class="location">{cust?.name ?? 'Customer'} &middot; {cust?.area ?? ''}</p>
          </div>
          {!done && (
            <div class="card-footer">
              <span class="action-text">Open Job</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </div>
          )}
        </a>
      ))}

      {myJobs.length === 0 && (
        <p class="jobs-empty">No jobs assigned yet. New visits from the dispatcher appear here.</p>
      )}
      <p id="jobsEmpty" class="jobs-empty" hidden>No jobs in this view.</p>
    </div>
  </div>
</TechDashboardLayout>

<script>
  import "../../features/technician/job-filters.ts";
</script>

<style is:global>
  .feed-container {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .page-header h2 {
    font-family: var(--font-h);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy);
  }

  /* Filters */
  .filter-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-top: -0.5rem;
    /* Hide scrollbar */
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .filter-scroll::-webkit-scrollbar {
    display: none;
  }

  .pill {
    padding: 0.5rem 1.25rem;
    background-color: var(--pure-white);
    border: 1px solid var(--border);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    font-family: inherit;
    color: var(--graphite-mid);
    white-space: nowrap;
    cursor: pointer;
  }
  .jobs-empty { text-align: center; color: var(--graphite-mid); font-size: 0.875rem; padding: 1.5rem 0; }

  .pill.active {
    background-color: var(--navy);
    color: var(--pure-white);
    border-color: var(--navy);
  }

  /* Job Cards */
  .job-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .job-card {
    background-color: var(--pure-white);
    border-radius: 16px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  
  .job-card:active {
    transform: scale(0.98);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--bg-off);
  }

  .req {
    font-family: var(--font-h);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--graphite-lt);
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 12px;
    text-transform: uppercase;
  }
  
  .badge.active { background-color: var(--teal-light); color: var(--teal); }
  .badge.upcoming { background-color: var(--gold-light); color: #9A6A00; }
  .badge.completed { background-color: var(--bg-off); color: var(--graphite-mid); }

  .card-body {
    padding: 1.25rem;
  }

  .time {
    font-size: 0.8125rem;
    color: var(--teal);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .appliance {
    font-family: var(--font-h);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.25rem;
  }

  .location {
    font-size: 0.875rem;
    color: var(--graphite-mid);
  }

  .card-footer {
    padding: 1rem 1.25rem;
    background-color: #FAFAFA;
    border-top: 1px solid var(--bg-off);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--teal);
  }

  .action-text {
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .job-card.completed .card-body {
    opacity: 0.6;
  }
</style>

