---
import TechDashboardLayout from '../../layouts/TechDashboardLayout.astro';
// Business: "My Jobs" is the technician's OWN slice of the one request table, read LIVE from the Worker.
// Business: Each card shows what the API really has — the request code, its status, the appliance, the
// Business: customer to visit and their area — and links to the same job detail the home hero opens.
// Business: The demo's invented "visit time" is gone; a real visit DATE is shown, else "to be scheduled".
// Technical: Always-emitted page. The shell ships empty; a module script fetches /me/jobs, derives rows
// (features/staff/tech-view) and paints. The filter pills act on data-group set at paint time.
---

<TechDashboardLayout title="Jobs - Sudhar Lab" activeNav="jobs">
  <div class="feed-container">
    <div class="page-header">
      <h2>My Jobs</h2>
    </div>

    <div class="filter-scroll" role="tablist" aria-label="Filter jobs">
      <button type="button" class="pill active" data-filter="all" role="tab" aria-selected="true">All</button>
      <button type="button" class="pill" data-filter="active" role="tab" aria-selected="false">Active</button>
      <button type="button" class="pill" data-filter="completed" role="tab" aria-selected="false">Completed</button>
    </div>

    <div class="jb-status" id="jbStatus">Loading your jobs…</div>

    <div class="job-list" id="jbList" hidden></div>
    <p id="jbEmpty" class="jobs-empty" hidden>No jobs in this view.</p>
  </div>
</TechDashboardLayout>

<script>
import { ApiError, staff, type ApiTechnicianJob } from '../../lib/api-client';
import { requireSession } from '../../lib/session';
import { toRows, visitLabel, type TechJobRow } from '../../features/staff/tech-view';
import { statusLabel } from '../../features/requests/queue';

const session = requireSession('technician');

const statusEl = document.getElementById('jbStatus') as HTMLElement;
const listEl = document.getElementById('jbList') as HTMLElement;
const emptyEl = document.getElementById('jbEmpty') as HTMLParagraphElement;
let rows: TechJobRow[] = [];

function esc(value: unknown): string {
  return String(value ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
}

function group(row: TechJobRow): string {
  if (row.active) return 'active';
  if (row.done) return 'completed';
  return 'other';
}

function card(row: TechJobRow): string {
  const job = row.job;
  const href = `/tech/jobs/detail?code=${encodeURIComponent(job.code)}`;
  const badge = row.done ? 'completed' : row.active ? 'active' : 'upcoming';
  const badgeText = row.done ? 'Completed' : statusLabel(job);
  const c = job.customer;
  const where = c ? `${esc(c.name)}${c.area ? ` &middot; ${esc(c.area)}` : ''}` : 'Customer being confirmed';
  return `<a href="${href}" class="job-card${row.done ? ' completed' : ''}" data-group="${group(row)}">
    <div class="card-header">
      <span class="req tnum">#${esc(job.code)}</span>
      <span class="badge ${badge}">${esc(badgeText)}</span>
    </div>
    <div class="card-body">
      <div class="time">${esc(visitLabel(job))}</div>
      <h3 class="appliance">${esc(job.appliance.brand)} ${esc(job.appliance.type)}</h3>
      <p class="location">${where}</p>
    </div>
    ${!row.done ? `<div class="card-footer"><span class="action-text">Open Job</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div>` : ''}
  </a>`;
}

function applyFilter(filter: string): void {
  const visible = rows.filter((row) => filter === 'all' || group(row) === filter);
  listEl.innerHTML = visible.map(card).join('');
  emptyEl.hidden = visible.length > 0;
}

function wirePills(): void {
  document.querySelectorAll('.pill').forEach((pill) => pill.addEventListener('click', () => {
    document.querySelectorAll('.pill').forEach((p) => {
      p.classList.toggle('active', p === pill);
      p.setAttribute('aria-selected', p === pill ? 'true' : 'false');
    });
    applyFilter(pill.getAttribute('data-filter') ?? 'all');
  }));
}

async function load(): Promise<void> {
  if (!session) return;
  try {
    const jobs: ApiTechnicianJob[] = await staff.myJobs();
    rows = toRows(jobs);
    statusEl.style.display = 'none';
    if (rows.length === 0) {
      listEl.hidden = false;
      listEl.innerHTML = '<p class="jobs-empty">No jobs assigned yet. New visits from the dispatcher appear here.</p>';
    } else {
      listEl.hidden = false;
      applyFilter('all');
      wirePills();
    }
  } catch (err) {
    if (err instanceof ApiError && err.status === 401) return;
    statusEl.textContent = 'Could not load your jobs. Please refresh.';
  }
}

if (session) void load();
</script>

<style is:global>
  .feed-container {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .jb-status { text-align: center; color: var(--graphite-mid); font-size: 0.875rem; }

  .page-header h2 {
    font-family: var(--font-h);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy);
  }

  /* Filters */
  .filter-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-top: -0.5rem;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .filter-scroll::-webkit-scrollbar {
    display: none;
  }

  .pill {
    padding: 0.5rem 1.25rem;
    background-color: var(--pure-white);
    border: 1px solid var(--border);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    font-family: inherit;
    color: var(--graphite-mid);
    white-space: nowrap;
    cursor: pointer;
  }
  .jobs-empty { text-align: center; color: var(--graphite-mid); font-size: 0.875rem; padding: 1.5rem 0; }

  .pill.active {
    background-color: var(--navy);
    color: var(--pure-white);
    border-color: var(--navy);
  }

  /* Job Cards */
  .job-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .job-card {
    background-color: var(--pure-white);
    border-radius: 16px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .job-card:active {
    transform: scale(0.98);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--bg-off);
  }

  .req {
    font-family: var(--font-h);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--graphite-lt);
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 12px;
    text-transform: uppercase;
  }

  .badge.active { background-color: var(--teal-light); color: var(--teal); }
  .badge.upcoming { background-color: var(--gold-light); color: #9A6A00; }
  .badge.completed { background-color: var(--bg-off); color: var(--graphite-mid); }

  .card-body {
    padding: 1.25rem;
  }

  .time {
    font-size: 0.8125rem;
    color: var(--teal);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .appliance {
    font-family: var(--font-h);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.25rem;
  }

  .location {
    font-size: 0.875rem;
    color: var(--graphite-mid);
  }

  .card-footer {
    padding: 1rem 1.25rem;
    background-color: #FAFAFA;
    border-top: 1px solid var(--bg-off);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--teal);
  }

  .action-text {
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .job-card.completed .card-body {
    opacity: 0.6;
  }
</style>
