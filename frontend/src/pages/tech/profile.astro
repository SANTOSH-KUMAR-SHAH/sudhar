---
import TechDashboardLayout from '../../layouts/TechDashboardLayout.astro';
// Business: The technician's own card, read LIVE from the Worker. It shows what the API really stores —
// Business: name, service area, skills and current availability — plus counts DERIVED from their jobs
// Business: (done this week, active, finished). The demo's invented fields (a subtitle, a "TECH-" code,
// Business: a join month, a fake dispatch phone) are gone: the backend never returns them, so we do not.
// Technical: Always-emitted page; module script fetches me + jobs and paints into the retained markup.
---

<TechDashboardLayout title="Profile - Sudhar Lab" activeNav="profile">
  <div class="feed-container">
    <div class="pf-status" id="pfStatus">Loading your profile…</div>

    <div id="pfRoot" hidden>
      <div class="profile-header" id="pfHead"></div>
      <div class="stats-row" id="pfStats"></div>
      <div class="menu-list">
        <a href="/tech/jobs" class="menu-item">
          <div class="icon-bg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
          <span>My Job History</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" class="chevron"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
      <a href="/tech/login" class="logout-btn" id="pfLogout">Log Out</a>
    </div>
  </div>
</TechDashboardLayout>

<script>
import { ApiError, staff, type ApiTechnician, type ApiTechnicianJob } from '../../lib/api-client';
import { requireSession, clearSession } from '../../lib/session';
import { avatarHueFor, initialsFor } from '../../features/staff/roster';
import { completedThisWeek } from '../../features/staff/tech-view';
import { isActive, isDone } from '../../features/requests/queue';

const session = requireSession('technician');

const statusEl = document.getElementById('pfStatus') as HTMLElement;
const root = document.getElementById('pfRoot') as HTMLElement;
const headEl = document.getElementById('pfHead') as HTMLElement;
const statsEl = document.getElementById('pfStats') as HTMLElement;

function esc(value: unknown): string {
  return String(value ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
}

function headHtml(tech: ApiTechnician): string {
  return `<div class="avatar" style="background-color:${esc(avatarHueFor(tech.id))}">${esc(initialsFor(tech.name))}</div>
    <h2>${esc(tech.name)}</h2>
    <p>Technician &middot; ${esc(tech.area)}</p>
    <p class="tech-code tnum">${esc(tech.id)} &middot; ${tech.availability === 'online' ? 'Online now' : 'Offline'}</p>
    ${tech.skills.length ? `<div class="skill-row">${tech.skills.map((s) => `<span class="skill-chip">${esc(s)}</span>`).join('')}</div>` : ''}`;
}

function statsHtml(jobs: ApiTechnicianJob[]): string {
  const boxes: Array<[number, string]> = [
    [completedThisWeek(jobs), 'Done This Week'],
    [jobs.filter(isActive).length, 'Active Jobs'],
    [jobs.filter(isDone).length, 'Done On Board'],
  ];
  return boxes.map(([n, label]) => `<div class="stat-box"><div class="stat-num tnum">${n}</div><div class="stat-label">${label}</div></div>`).join('');
}

async function load(): Promise<void> {
  if (!session) return;
  try {
    const [tech, jobs] = await Promise.all([staff.me(), staff.myJobs()]);
    headEl.innerHTML = headHtml(tech);
    statsEl.innerHTML = statsHtml(jobs);
    statusEl.style.display = 'none';
    root.hidden = false;
    const logout = document.getElementById('pfLogout');
    // Business: Signing out clears this device's token and returns to the technician sign-in page.
    if (logout) logout.addEventListener('click', () => clearSession());
  } catch (err) {
    if (err instanceof ApiError && err.status === 401) return;
    statusEl.textContent = 'Could not load your profile. Please refresh.';
  }
}

if (session) void load();
</script>

<style is:global>
  .feed-container {
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .pf-status { text-align: center; color: var(--graphite-mid); font-size: 0.875rem; }

  /* Profile Header */
  .profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .avatar {
    width: 96px;
    height: 96px;
    background-color: var(--navy);
    color: var(--pure-white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    font-family: var(--font-h);
    font-size: 2rem;
    font-weight: 700;
  }

  .profile-header h2 {
    font-family: var(--font-h);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy);
  }

  .profile-header p {
    font-size: 0.9375rem;
    color: var(--graphite-mid);
  }

  .tech-code {
    font-size: 0.8125rem;
    color: var(--graphite-lt);
    margin-top: 0.25rem;
  }

  .skill-row { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: 1rem; }
  .skill-chip { background-color: var(--teal-light); color: var(--teal); font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.7rem; border-radius: 12px; }

  /* Stats Row */
  .stats-row {
    display: flex;
    gap: 1rem;
  }

  .stat-box {
    flex: 1;
    background-color: var(--pure-white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .stat-num {
    font-family: var(--font-h);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--graphite-lt);
    text-transform: uppercase;
  }

  /* Menu List */
  .menu-list {
    background-color: var(--pure-white);
    border-radius: 16px;
    border: 1px solid var(--border);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .menu-item {
    display: flex;
    align-items: center;
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: var(--navy);
    border-bottom: 1px solid var(--bg-off);
    width: 100%;
    background: none;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }

  .menu-item:active {
    background-color: var(--bg-off);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  .icon-bg {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: var(--bg-off);
    color: var(--graphite-mid);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 1rem;
  }

  .menu-item span {
    flex: 1;
    font-weight: 600;
    font-size: 1rem;
  }

  .chevron {
    color: var(--graphite-lt);
  }

  /* Logout */
  .logout-btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: 1rem;
    color: #EF4444;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    background-color: rgba(239, 68, 68, 0.1);
    border-radius: 12px;
  }

  .logout-btn:active {
    background-color: rgba(239, 68, 68, 0.15);
  }
</style>
