---
import TechDashboardLayout from '../../layouts/TechDashboardLayout.astro';
// Business: The technician's home, LIVE and honest. This always-emitted page asks the Worker who I am
// Business: and what my jobs are, then paints the same day the dispatcher sees — next visit, later open
// Business: visits, finished visits — from the one joined job view. Nothing here is a stored or typed
// Business: mock: availability comes from the roster, counts from live jobs, the customer's phone from
// Business: their record. Fields the API does not return (a clock "visit time", photos) are simply absent.
// Technical: Static output cannot prerender a per-user page, so the shell ships empty and a module script
// fetches, derives (features/staff/tech-view) and renders. The availability flip is a REAL self-serve
// write (POST /me/availability); on failure the banner just reverts, never a fake local success.
---

<TechDashboardLayout title="Home - Sudhar Lab" activeNav="home">
  <div class="feed-container">
    <div class="tb-status" id="tbStatus">Loading your day…</div>

    <div id="tbRoot" hidden>
      <div id="tbBanner"></div>

      <div class="greeting">
        <h2 id="tbGreet">Hello</h2>
        <p id="tbToday"></p>
      </div>

      <div id="tbHero"></div>

      <div class="section-heading">Later Today</div>
      <div class="job-list" id="tbLater"></div>

      <div class="section-heading">Completed</div>
      <div class="job-list" id="tbCompleted"></div>
    </div>
  </div>
</TechDashboardLayout>

<script>
import { ApiError, staff, type ApiTechnician, type ApiTechnicianJob } from '../../lib/api-client';
import { requireSession } from '../../lib/session';
import { deriveBoard, visitLabel, type TechJobRow } from '../../features/staff/tech-view';
import { statusLabel } from '../../features/requests/queue';

const session = requireSession('technician');

const statusEl = document.getElementById('tbStatus') as HTMLElement;
const root = document.getElementById('tbRoot') as HTMLElement;
const bannerEl = document.getElementById('tbBanner') as HTMLElement;
const greetEl = document.getElementById('tbGreet') as HTMLElement;
const todayEl = document.getElementById('tbToday') as HTMLElement;
const heroEl = document.getElementById('tbHero') as HTMLElement;
const laterEl = document.getElementById('tbLater') as HTMLElement;
const completedEl = document.getElementById('tbCompleted') as HTMLElement;

let me: ApiTechnician | null = null;

function esc(value: unknown): string {
  return String(value ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
}

function firstName(tech: ApiTechnician): string {
  return tech.name.trim().split(/\s+/)[0] ?? 'Technician';
}

function greeting(tech: ApiTechnician): string {
  const h = new Date().getHours();
  const part = h < 12 ? 'morning' : h < 17 ? 'afternoon' : 'evening';
  return `Good ${part}, ${firstName(tech)}`;
}

const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" style="color:var(--green)"><polyline points="20 6 9 17 4 12"></polyline></svg>';
const CHEVRON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" style="color: var(--graphite-lt)"><polyline points="9 18 15 12 9 6"></polyline></svg>';
const WARN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>';

function bannerHtml(tech: ApiTechnician): string {
  const online = tech.availability === 'online';
  return `<div class="availability-banner ${online ? 'online' : 'offline'}" id="availBanner">
    <div class="avail-content"><div class="pulse-ring"></div><div class="status-dot"></div><span id="availLabel">You are ${online ? 'ONLINE' : 'OFFLINE'}</span></div>
    <button type="button" class="toggle-switch" id="availToggle">${online ? 'Go Offline' : 'Go Online'}</button>
  </div>`;
}

function customerLine(job: ApiTechnicianJob): string {
  const c = job.customer;
  if (!c) return 'Customer being confirmed';
  return `${esc(c.name)}${c.area ? ` &middot; ${esc(c.area)}` : ''}`;
}

function heroHtml(next: ApiTechnicianJob | null): string {
  if (!next) {
    return '<div class="hero-card"><div class="hero-empty">No open job right now. New assignments from the dispatcher appear here.</div></div>';
  }
  const detailHref = `/tech/jobs/detail?code=${encodeURIComponent(next.code)}`;
  return `<div class="hero-card">
    <div class="hero-header">
      <div class="badge assigned">Next Visit</div>
      <div class="time tnum" style="font-size:1.25rem">${esc(visitLabel(next))}</div>
    </div>
    <div class="hero-body">
      <h3 class="appliance">${esc(next.appliance.brand)} ${esc(next.appliance.type)}</h3>
      <p class="customer">${customerLine(next)}</p>
      <div class="problem-box">${WARN}${esc(next.problem)}</div>
    </div>
    <div class="hero-footer"><a href="${detailHref}" class="btn-primary massive">Open Job</a></div>
  </div>`;
}

function laterItem(row: TechJobRow): string {
  const href = `/tech/jobs/detail?code=${encodeURIComponent(row.job.code)}`;
  const area = row.job.customer?.area ?? statusLabel(row.job);
  return `<a href="${href}" class="job-item">
    <div class="time-col tnum">${esc(row.job.visitDate ? new Date(row.job.visitDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : '—')}</div>
    <div class="details-col"><h4>${esc(row.job.appliance.brand)} ${esc(row.job.appliance.type)}</h4><p>${esc(area)}</p></div>
    ${CHEVRON}
  </a>`;
}

function completedItem(row: TechJobRow): string {
  const href = `/tech/jobs/detail?code=${encodeURIComponent(row.job.code)}`;
  return `<a href="${href}" class="job-item completed">
    <div class="time-col">${CHECK}</div>
    <div class="details-col"><h4>${esc(row.job.appliance.brand)} ${esc(row.job.appliance.type)}</h4><p>${esc(row.job.customer?.area ?? '')}</p></div>
    ${CHEVRON}
  </a>`;
}

async function toggleAvailability(): Promise<void> {
  if (!me) return;
  const target = me.availability === 'online' ? 'offline' : 'online';
  const button = document.getElementById('availToggle') as HTMLButtonElement | null;
  if (button) button.disabled = true;
  try {
    me = await staff.setAvailability(target);
    bannerEl.innerHTML = bannerHtml(me);
    wireBanner();
  } catch (err) {
    if (err instanceof ApiError && err.status === 401) return;
    if (button) button.disabled = false; // revert: never claim a flip the server refused
  }
}

function wireBanner(): void {
  const button = document.getElementById('availToggle');
  if (button) button.addEventListener('click', () => void toggleAvailability());
}

function paint(jobs: ApiTechnicianJob[]): void {
  if (!me) return;
  const board = deriveBoard(jobs);
  bannerEl.innerHTML = bannerHtml(me);
  greetEl.textContent = greeting(me);
  todayEl.textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
  heroEl.innerHTML = heroHtml(board.next);
  laterEl.innerHTML = board.later.length
    ? board.later.map(laterItem).join('')
    : '<div class="list-empty">Nothing else scheduled for today.</div>';
  completedEl.innerHTML = board.completed.length
    ? board.completed.map(completedItem).join('')
    : '<div class="list-empty">No completed visits yet.</div>';
  wireBanner();
}

async function load(): Promise<void> {
  if (!session) return;
  try {
    const [tech, jobs] = await Promise.all([staff.me(), staff.myJobs()]);
    me = tech;
    statusEl.style.display = 'none';
    root.hidden = false;
    paint(jobs);
  } catch (err) {
    if (err instanceof ApiError && err.status === 401) return; // authorizedFetch already redirected
    statusEl.textContent = 'Could not load your dashboard. Please refresh.';
  }
}

if (session) void load();
</script>

<style is:global>
  .feed-container {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .tb-status { text-align: center; color: var(--graphite-mid); font-size: 0.875rem; padding: 1.5rem 0; }

  /* Availability Banner */
  .availability-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-radius: 12px;
    background-color: var(--pure-white);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }

  .availability-banner.online {
    border-color: rgba(34, 197, 94, 0.3);
    background-color: #FAFDFA;
  }

  .availability-banner.offline {
    border-color: var(--border);
    background-color: var(--pure-white);
  }

  .avail-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--navy);
    position: relative;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    background-color: var(--green);
    border-radius: 50%;
    z-index: 2;
  }

  .availability-banner.offline .status-dot {
    background-color: var(--graphite-lt);
  }

  .availability-banner.offline .pulse-ring {
    display: none;
  }

  .pulse-ring {
    position: absolute;
    left: -3px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    background-color: rgba(34, 197, 94, 0.3);
    border-radius: 50%;
    animation: pulse 2s infinite;
    z-index: 1;
  }

  @keyframes pulse {
    0% { transform: translateY(-50%) scale(0.8); opacity: 1; }
    100% { transform: translateY(-50%) scale(2.5); opacity: 0; }
  }

  .toggle-switch {
    background: none;
    border: 1px solid var(--border);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--graphite-mid);
    cursor: pointer;
    background-color: var(--pure-white);
  }
  .toggle-switch:disabled { opacity: 0.6; cursor: default; }

  /* Greeting */
  .greeting h2 {
    font-family: var(--font-h);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 0.25rem;
  }

  .greeting p {
    font-size: 0.875rem;
    color: var(--graphite-lt);
  }

  /* Hero Card */
  .hero-card {
    background-color: var(--pure-white);
    border-radius: 16px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .hero-header {
    background-color: var(--teal);
    color: var(--pure-white);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .badge.assigned {
    align-self: flex-start;
    background-color: rgba(255,255,255,0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-header .time {
    font-family: var(--font-h);
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .hero-body {
    padding: 1.5rem;
  }

  .hero-body .appliance {
    font-family: var(--font-h);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .hero-body .customer {
    font-size: 0.9375rem;
    color: var(--graphite-mid);
    margin-bottom: 1rem;
  }

  .problem-box {
    background-color: var(--gold-light);
    color: #9A6A00;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-footer {
    padding: 0 1.5rem 1.5rem 1.5rem;
  }

  .btn-primary.massive {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1.25rem;
    font-size: 1.125rem;
    font-weight: 700;
    background-color: var(--teal);
    color: var(--pure-white);
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.1s;
  }

  .btn-primary.massive:active {
    transform: scale(0.98);
  }

  .hero-empty {
    padding: 2rem 1.5rem;
    text-align: center;
    color: var(--graphite-mid);
    font-size: 0.9375rem;
  }

  .list-empty {
    background-color: var(--pure-white);
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 1rem;
    text-align: center;
    color: var(--graphite-mid);
    font-size: 0.875rem;
  }

  /* Lists */
  .section-heading {
    font-family: var(--font-h);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--navy);
    margin-top: 0.5rem;
  }

  .job-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .job-item {
    display: flex;
    align-items: center;
    background-color: var(--pure-white);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
  }

  .time-col {
    font-family: var(--font-h);
    font-weight: 700;
    color: var(--navy);
    width: 70px;
    flex-shrink: 0;
    font-size: 0.9375rem;
  }

  .details-col {
    flex: 1;
  }

  .details-col h4 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.125rem;
  }

  .details-col p {
    font-size: 0.8125rem;
    color: var(--graphite-mid);
  }

  .job-item.completed {
    background-color: #FAFAFA;
  }
  .job-item.completed h4 {
    color: var(--graphite-mid);
  }
</style>
