---
import AdminDashboardLayout from '../../../layouts/AdminDashboardLayout.astro';

const customers = [
  { id: 'HT', name: 'Hari Thapa',    phone: '98XX XXX XXX', area: 'Baneshwor',   appliances: 2, totalReqs: 3, lastOutcome: 'Active',             outcomeClass: 'badge-active',  lastDate: 'Today',        color: '#10263D' },
  { id: 'MS', name: 'Mina Shrestha', phone: '98XX XXX XXX', area: 'Lalitpur',    appliances: 1, totalReqs: 2, lastOutcome: 'Price Approval',     outcomeClass: 'badge-progress',lastDate: '2 hrs ago',    color: '#0C7C82' },
  { id: 'SR', name: 'Suresh Rai',    phone: '98XX XXX XXX', area: 'Koteshwor',   appliances: 3, totalReqs: 4, lastOutcome: 'Successful Repair',  outcomeClass: 'badge-done',    lastDate: 'Yesterday',    color: '#8B5CF6' },
  { id: 'AG', name: 'Anita Gurung',  phone: '98XX XXX XXX', area: 'Maharajgunj', appliances: 1, totalReqs: 1, lastOutcome: 'Customer Cancelled', outcomeClass: 'badge-cancel',  lastDate: 'September 10', color: '#4A4E52' },
  { id: 'BR', name: 'Bikash Rai',    phone: '98XX XXX XXX', area: 'Kirtipur',    appliances: 1, totalReqs: 1, lastOutcome: 'No Technician Visit', outcomeClass: 'badge-neutral', lastDate: 'September 8',  color: '#D97706' },
];
---

<AdminDashboardLayout title="Customers - Sudhar Lab Admin" activeNav="customers">

  <!-- HEADER -->
  <div class="cs-header">
    <div>
      <h1 class="cs-title">Customers</h1>
      <p class="cs-sub">Find any customer by name, phone, or area</p>
    </div>
    <button class="btn btn-secondary btn-sm" type="button" disabled title="Customer creation arrives with the backend API">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      Add Customer
    </button>
  </div>

  <!-- BIG SEARCH — main action on this page -->
  <div class="cs-search-card card card-pad">
    <div class="cs-search-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" class="cs-search" placeholder="Search by name, phone number, area, or appliance…" autofocus />
    </div>
    <div class="cs-search-meta">
      <span class="text-sm text-muted">248 customer records</span>
      <div class="cs-quick-filters">
        <button class="qf-btn active">All</button>
        <button class="qf-btn">Active requests</button>
        <button class="qf-btn">Completed</button>
        <button class="qf-btn">Cancelled</button>
      </div>
    </div>
  </div>

  <!-- CUSTOMER LIST -->
  <div class="cs-list card">
    {customers.map(cust => (
      <div class="cs-row" onclick={`window.location.href='/admin/customers/${cust.id}'`}>

        <!-- Left: Identity -->
        <div class="cs-identity">
          <div class="cs-avatar" style={`background: ${cust.color}`}>{cust.id}</div>
          <div>
            <div class="cs-name">{cust.name}</div>
            <div class="cs-meta">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              {cust.phone}
              <span class="dot-sep">·</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path></svg>
              {cust.area}
            </div>
          </div>
        </div>

        <!-- Middle: Stats -->
        <div class="cs-stats">
          <div class="cs-stat">
            <div class="cs-stat-num">{cust.appliances}</div>
            <div class="cs-stat-label">Appliances</div>
          </div>
          <div class="cs-stat">
            <div class="cs-stat-num">{cust.totalReqs}</div>
            <div class="cs-stat-label">Requests</div>
          </div>
        </div>

        <!-- Right: Last status + action -->
        <div class="cs-right">
          <div class="cs-last">
            <span class={`badge ${cust.outcomeClass}`}>{cust.lastOutcome}</span>
            <div class="cs-last-date">{cust.lastDate}</div>
          </div>
          <button class="btn btn-secondary btn-sm" onclick={`event.stopPropagation(); window.location.href='/admin/customers/${cust.id}'`}>
            Open Record
          </button>
        </div>

      </div>
    ))}
  </div>

</AdminDashboardLayout>

<style is:global>
  .cs-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 1.25rem;
  }
  .cs-title { font-family: var(--font-h); font-size: 1.75rem; font-weight: 800; color: var(--navy); }
  .cs-sub { color: var(--graphite-lt); font-size: 0.875rem; margin-top: 0.25rem; }

  /* Search card */
  .cs-search-card {
    margin-bottom: 1.25rem;
    display: flex; flex-direction: column; gap: 0.875rem;
  }
  .cs-search-wrap {
    display: flex; align-items: center; gap: 0.75rem;
  }
  .cs-search-wrap svg { color: var(--graphite-lt); flex-shrink: 0; }
  .cs-search {
    flex: 1; border: none; outline: none;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-b); font-size: 1.0625rem;
    color: var(--navy); background: transparent;
  }
  .cs-search::placeholder { color: var(--graphite-lt); }

  .cs-search-meta {
    display: flex; align-items: center; justify-content: space-between;
    padding-top: 0.75rem; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 0.5rem;
  }
  .cs-quick-filters { display: flex; gap: 0.375rem; }
  .qf-btn {
    padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600;
    background: var(--bg); border: 1px solid var(--border); color: var(--graphite-mid);
    cursor: pointer; transition: all 0.15s;
  }
  .qf-btn:hover { border-color: var(--teal); color: var(--teal); }
  .qf-btn.active { background: var(--teal-light); color: var(--teal); border-color: rgba(12,124,130,0.3); }

  /* Customer list */
  .cs-list { overflow: hidden; }
  .cs-row {
    display: flex; align-items: center; gap: 1.25rem;
    padding: 1.125rem 1.5rem;
    border-bottom: 1px solid var(--border);
    cursor: pointer; transition: background 0.12s;
  }
  .cs-row:last-child { border-bottom: none; }
  .cs-row:hover { background: #FAFBFC; }

  .cs-identity { display: flex; align-items: center; gap: 0.875rem; flex: 1; min-width: 0; }
  .cs-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    color: #fff; font-family: var(--font-h); font-size: 0.875rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .cs-name { font-size: 0.9375rem; font-weight: 700; color: var(--navy); }
  .cs-meta {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.75rem; color: var(--graphite-lt); margin-top: 0.125rem;
  }
  .dot-sep { color: var(--border); }

  .cs-stats { display: flex; gap: 1.5rem; flex-shrink: 0; }
  .cs-stat { text-align: center; }
  .cs-stat-num { font-family: var(--font-h); font-size: 1.125rem; font-weight: 700; color: var(--navy); }
  .cs-stat-label { font-size: 0.75rem; color: var(--graphite-lt); text-transform: uppercase; letter-spacing: 0.04em; }

  .cs-right {
    display: flex; align-items: center; gap: 1.25rem; flex-shrink: 0;
  }
  .cs-last { text-align: right; }
  .cs-last-date { font-size: 0.75rem; color: var(--graphite-lt); margin-top: 0.25rem; }

  @media (max-width: 767px) {
    .cs-header { flex-direction: column; gap: 0.75rem; }
    .cs-header .btn { align-self: flex-start; }
    /* Search card — bigger input on mobile */
    .cs-search { font-size: 0.9375rem; }
    .cs-search-meta { flex-direction: column; align-items: flex-start; gap: 0.625rem; }
    .cs-quick-filters { flex-wrap: wrap; gap: 0.375rem; }

    /* Each customer row simplifies on mobile */
    .cs-row {
      flex-wrap: wrap;
      padding: 0.875rem 1rem;
      gap: 0.75rem;
    }
    .cs-identity { flex: 1 1 100%; }  /* full width on top */

    /* Hide stats on smallest screens, keep on larger mobile */
    @media (max-width: 420px) {
      .cs-stats { display: none; }
    }

    /* Right side stacks below identity */
    .cs-right {
      flex: 1 1 100%;
      justify-content: space-between;
      align-items: center;
    }
    .cs-last { text-align: left; }

    /* Full-width button on mobile */
    .cs-right .btn { flex: 1; justify-content: center; }
  }

  @media (max-width: 420px) {
    .cs-header .btn { width: 100%; justify-content: center; }
    .cs-meta { flex-wrap: wrap; row-gap: 0.25rem; }
    .cs-right { align-items: stretch; flex-direction: column; }
    .cs-right .btn { width: 100%; }
  }
</style>
