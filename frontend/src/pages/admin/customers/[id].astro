        <div class="side-card-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
          <h3 class="side-card-title">Billing History</h3>
        </div>
        <div class="billing-stats">
          <div class="billing-stat">
            <div class="billing-stat-label">Inspection fees recorded</div>
            <div class="billing-stat-num">{customer.billing.recorded}</div>
          </div>
          <div class="billing-stat">
            <div class="billing-stat-label">Paid</div>
            <div class="billing-stat-num">{customer.billing.paid}</div>
          </div>
          <div class="billing-stat">
            <div class="billing-stat-label">Pending</div>
            <div class="billing-stat-num">{customer.billing.pending}</div>
