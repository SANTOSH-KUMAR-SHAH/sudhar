      </div>

      <!-- COMMUNICATION -->
      <div class="side-card">
        <div class="side-card-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          <h3 class="side-card-title">Communication</h3>
        </div>
        <div class="comm-list">
          {customer.communication.length === 0 && (
            <div class="empty-notes">No logged communication yet.</div>
          )}
          {customer.communication.map((entry) => (
            <div class="comm-row">
              <div class="comm-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div class="comm-text">{entry.type}</div>
              <div class="comm-date">{entry.date}</div>
            </div>
          ))}
        </div>
      </div>

    </div><!-- /side-col -->

  </div><!-- /content-grid -->

</AdminDashboardLayout>

<script is:inline>
// Business: History tabs filter to the outcomes this customer actually earned.
// Technical: Each row carries its group in data-sh (stamped at render) — the script
// compares strings and never interprets a status, so it can't drift from the data.
function setHistoryFilter(group) {
  document.querySelectorAll('.sh-tab').forEach((t) => t.classList.toggle('active', t.getAttribute('data-sh') === group));
  document.querySelectorAll('.sh-row').forEach((row) => {
    const g = row.getAttribute('data-sh');
    row.style.display = (group === 'All' || g === group) ? '' : 'none';
  });
}
document.querySelectorAll('.sh-tab').forEach((t) => t.addEventListener('click', () => setHistoryFilter(t.getAttribute('data-sh'))));
</script>

