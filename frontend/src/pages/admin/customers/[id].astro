---
import AdminDashboardLayout from '../../../layouts/AdminDashboardLayout.astro';
import StatusBadge from '../../../components/common/StatusBadge.astro';
import type { ServiceStatusKey } from '../../../lib/service-status';
import {
  DEMO_CUSTOMERS,
  getDemoCustomer,
  getDemoTechnician,
  isRequestActive,
  requestExists,
  requestsForCustomer,
  statusBadgeClass,
  statusLabel,
} from '../../../lib/demo-data';

// Business: Customer 360 is assembled, never stored twice — profile from the customer
// Business: table, open work joined from the request table, closed cases as history.
// Technical: Paths derive from DEMO_CUSTOMERS and unknown ids 404 like the request and
// technician pages, so a cross-link to a dead customer cannot ship in a build.
export function getStaticPaths() {
  return DEMO_CUSTOMERS.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const customer = getDemoCustomer(id ?? '');
if (!customer) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const openRequests = requestsForCustomer(customer.id);
const activeRequest = openRequests.find((r) => isRequestActive(r.status)) ?? null;
const activeTechnician = activeRequest?.technicianId ? getDemoTechnician(activeRequest.technicianId) : undefined;

// Business: The four numbers on this page are counts of real records, not typed figures.
const kpi = {
  active: openRequests.filter((r) => isRequestActive(r.status)).length,
  appliances: customer.appliances.length,
  totalRequests: openRequests.length + customer.history.length,
  successfulRepairs:
    openRequests.filter((r) => r.status === 'COMPLETED').length +
    customer.history.filter((h) => h.tone === 'success').length,
};

// Technical: Story words ("Repair Declined") keep their own wording; the tone recorded
// in the data maps onto canonical .badge-* colours so chips here match the requests queue.
const TONE_BADGE: Record<string, string> = {
  success: 'badge-done',
  warning: 'badge-cancel',
  danger: 'badge-cancel',
  neutral: 'badge-neutral',
  active: 'badge-progress',
};
const heroBadge = activeRequest
  ? { label: 'Active Request', cls: 'badge-progress' }
  : openRequests.length > 0
    ? { label: statusLabel(openRequests[0].status), cls: statusBadgeClass(openRequests[0].status) }
    : customer.history.length > 0
      ? { label: customer.history[0].outcome, cls: TONE_BADGE[customer.history[0].tone] ?? 'badge-neutral' }
      : { label: 'New customer', cls: 'badge-neutral' };

// Business: One history table — live requests first, then the closed archive.
// Technical: A uniform row shape keeps the table branch-free except for the badge,
// and each row's filter group is stamped as data-sh for the tab script below.
interface HistoryRowView {
  id: string;
  appliance: string;
  problem: string;
  date: string;
  technician: string;
  live: boolean;
  status: ServiceStatusKey | null;
  outcome: string;
  tone: string;
  group: string;
}
const historyRows: HistoryRowView[] = [
  ...openRequests.map((r): HistoryRowView => ({
    id: r.id,
    appliance: `${r.brand} ${r.applianceType}`,
    problem: r.problem,
    date: r.receivedAgo,
    technician: r.technicianId ? getDemoTechnician(r.technicianId)?.name ?? '—' : 'Not assigned yet',
    live: true,
    status: r.status,
    outcome: statusLabel(r.status),
    tone: '',
    group: isRequestActive(r.status) ? 'Active' : statusLabel(r.status),
  })),
  ...customer.history.map((h): HistoryRowView => ({
    id: h.id,
    appliance: h.appliance,
    problem: h.problem,
    date: h.date,
    technician: h.technician,
    live: false,
    status: null,
    outcome: h.outcome,
    tone: h.tone,
    group: h.outcome,
  })),
];
const historyTabs = ['All', ...new Set(historyRows.map((row) => row.group))];

// Business: Activity blends live request movement with logged calls. The real event
// log arrives with the backend; until then every line here is still derived, not typed.
const recentActivity = [
  ...openRequests.map((r) => ({ text: `${r.brand} ${r.applianceType} — ${statusLabel(r.status)}`, time: r.lastUpdated })),
  ...customer.communication.map((c) => ({ text: c.type, time: c.date })),
].slice(0, 6);

// Business: Per-appliance request counts join by appliance kind — no stored number to drift.
const applianceRequests = (name: string) =>
  openRequests.filter((r) => name.toLowerCase().includes(r.applianceType.toLowerCase())).length +
  customer.history.filter((h) => h.appliance.toLowerCase() === name.toLowerCase()).length;

const phoneHref = `tel:${customer.phone.replace(/\s/g, '')}`;
---

<AdminDashboardLayout title={`${customer.name} - Customers - Sudhar Lab`} activeNav="customers">

  <!-- BREADCRUMB -->
  <div class="breadcrumb-row">
    <a href="/admin/dashboard" class="breadcrumb-link">Operations</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
    <a href="/admin/customers" class="breadcrumb-link">Customers</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
    <span class="breadcrumb-current">{customer.name}</span>
  </div>

  <!-- HERO SECTION -->
  <div class="hero-card">
    <div class="hero-left">
      <div class="hero-avatar" style={`background-color: ${customer.avatarColor}`}>{customer.initials}</div>
      <div class="hero-info">
        <div class="hero-name-row">
          <h1 class="hero-name">{customer.name}</h1>
          <span class={`badge ${heroBadge.cls}`}>{heroBadge.label}</span>
        </div>
        <div class="hero-meta-list">
          <div class="hero-meta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            {customer.address}
          </div>
          <div class="hero-meta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            Customer since {customer.since}
          </div>
          <div class="hero-meta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            {customer.phone}
          </div>
        </div>
      </div>
    </div>
    <div class="hero-actions">
      <a class="btn-primary" href={phoneHref}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        Call Customer
      </a>
      <button class="btn-outline" type="button" disabled title="Customer editing arrives with the backend API">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        Edit Details
      </button>
      <button class="btn-outline" type="button" disabled title="Manual request entry arrives with the backend API">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Request
      </button>
    </div>
  </div>

  <!-- KPI CARDS -->
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
      </div>
      <div>
        <div class="kpi-num">{kpi.active}</div>
        <div class="kpi-label">Active Requests</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </div>
      <div>
        <div class="kpi-num">{kpi.appliances}</div>
        <div class="kpi-label">Appliances</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg>
      </div>
      <div>
        <div class="kpi-num">{kpi.totalRequests}</div>
        <div class="kpi-label">Total Requests</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon-wrap teal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <div>
        <div class="kpi-num">{kpi.successfulRepairs}</div>
        <div class="kpi-label">Successful Repairs</div>
      </div>
    </div>
  </div>

  <!-- ACTIVE REQUEST BANNER -->
  {activeRequest && (
    <div class="active-req-banner">
      <div class="banner-icon-wrap">
        <div class="banner-pulse"></div>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <div class="banner-label">Active service request</div>
      <div class="banner-sep"></div>
      <div class="banner-field"><div class="banner-key">Request No.</div><div class="banner-val tnum">{activeRequest.id}</div></div>
      <div class="banner-field"><div class="banner-key">Appliance</div><div class="banner-val">{activeRequest.brand} {activeRequest.applianceType}</div></div>
      <div class="banner-field">
        <div class="banner-key">Status</div>
        <div class="banner-val"><StatusBadge status={activeRequest.status} /></div>
      </div>
      <div class="banner-field"><div class="banner-key">Technician</div><div class="banner-val">{activeTechnician?.name ?? 'Not assigned yet'}</div></div>
      <div class="banner-field"><div class="banner-key">Visit</div><div class="banner-val">{activeRequest.visitTime}</div></div>
      <div class="banner-field"><div class="banner-key">Area</div><div class="banner-val">{customer.area}</div></div>
      <a class="btn-open-req" href={`/admin/requests/${activeRequest.id}`}>
        Open Request
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>
  )}

  <!-- NO ACTIVE REQUEST STATE (for customers without active requests) -->
  {!activeRequest && (
    <div class="no-request-banner">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <div>
        <div class="no-req-title">No active service request</div>
        <div class="no-req-desc">New requests from this customer will appear here.</div>
      </div>
    </div>
  )}

  <!-- MAIN CONTENT GRID: LEFT + RIGHT -->
  <div class="content-grid">

    <!-- LEFT / CENTER COLUMN -->
    <div class="main-col">

      <!-- CUSTOMER INFORMATION -->
      <div class="section-card">
        <div class="section-head">
          <div class="section-head-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <h2 class="section-title">Customer Information</h2>
          </div>
          <div class="section-head-right">
            {customer.internalNotes.length > 0 && (
              <div class="notes-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                {customer.internalNotes.length} internal notes
              </div>
            )}
            <button class="btn-link" type="button" disabled title="Customer editing arrives with the backend API">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              Edit Details
            </button>
          </div>
        </div>

        <div class="info-cols">
          <div class="info-col">
            <div class="info-field">
              <div class="info-label">Full name</div>
              <div class="info-val">{customer.name}</div>
            </div>
            <div class="info-field">
              <div class="info-label">Phone</div>
              <div class="info-val">{customer.phone}</div>
            </div>
            <div class="info-field">
              <div class="info-label">Address</div>
              <div class="info-val">{customer.address}</div>
            </div>
          </div>
          <div class="info-col">
            <div class="info-field">
              <div class="info-label">Area</div>
              <div class="info-val">{customer.area}</div>
            </div>
            <div class="info-field">
              <div class="info-label">Preferred contact</div>
              <div class="info-val">{customer.preferredContact}</div>
            </div>
            <div class="info-field">
              <div class="info-label">Customer created</div>
              <div class="info-val">{customer.since}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- APPLIANCES -->
      <div class="section-card">
        <div class="section-head">
          <div class="section-head-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline></svg>
            <div>
              <h2 class="section-title">Appliances</h2>
              <div class="section-desc">Appliances connected to this customer and their service history.</div>
            </div>
          </div>
        </div>

        <div class="appliance-grid">
          {customer.appliances.map((app) => (
            <div class="appliance-card">
              <div class="appliance-header">
                <div class="appliance-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="3" width="20" height="18" rx="2" ry="2"></rect><line x1="2" y1="9" x2="22" y2="9"></line><path d="M12 3v6"></path></svg>
                </div>
                <div class="appliance-name">{app.name}</div>
              </div>
              <div class="appliance-details">
                <div class="appl-detail">
                  <span class="appl-key">Model</span>
                  <span class="appl-val">{app.model}</span>
                </div>
                <div class="appl-detail">
                  <span class="appl-key">Last service</span>
                  <span class="appl-val">{app.lastService}</span>
                </div>
                <div class="appl-detail">
                  <span class="appl-key">Service requests</span>
                  <span class="appl-val">{applianceRequests(app.name)}</span>
                </div>
                <div class="appl-detail">
                  <span class="appl-key">Latest outcome</span>
                  <span class={`badge ${TONE_BADGE[app.tone] ?? 'badge-neutral'}`}>{app.outcome}</span>
                </div>
              </div>
              <a class="btn-view-history" href="#service-history">View History</a>
            </div>
          ))}

          {customer.appliances.length === 0 && (
            <div class="appliance-empty">No appliance records yet — appliances appear after the first request.</div>
          )}

          <!-- ADD APPLIANCE CARD -->
          <div class="appliance-add-card" title="Appliance records arrive with the backend API">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <div class="add-appliance-text">Add another appliance</div>
          </div>
        </div>
      </div>

      <!-- SERVICE HISTORY -->
      <div class="section-card" id="service-history">
        <div class="section-head">
          <div class="section-head-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            <h2 class="section-title">Service History</h2>
          </div>
        </div>

        <!-- SERVICE HISTORY TABS: derived from the outcomes this customer actually has -->
        <div class="sh-tabs">
          {historyTabs.map((tab, i) => (
            <button class={`sh-tab ${i === 0 ? 'active' : ''}`} type="button" data-sh={tab}>{tab}</button>
          ))}
        </div>

        {historyRows.length > 0 ? (
          <div class="sh-table-wrap">
            <table class="sh-table">
              <thead>
                <tr>
                  <th>Request</th>
                  <th>Appliance</th>
                  <th>Problem</th>
                  <th>Date</th>
                  <th>Technician</th>
                  <th>Outcome</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                {historyRows.map((row) => (
                  <tr class="sh-row" data-sh={row.group}>
                    <td><div class="req-id tnum">{row.id}</div></td>
                    <td><div class="cell-text">{row.appliance}</div></td>
                    <td><div class="cell-text">{row.problem}</div></td>
                    <td><div class="cell-text">{row.date}</div></td>
                    <td><div class="cell-text">{row.technician}</div></td>
                    <td>
                      {row.status
                        ? <StatusBadge status={row.status} />
                        : <span class={`badge ${TONE_BADGE[row.tone] ?? 'badge-neutral'}`}>{row.outcome}</span>}
                    </td>
                    <td>
                      <div class="action-cell">
                        {requestExists(row.id)
                          ? <a class="btn-link-sm" href={`/admin/requests/${row.id}`}>{row.live ? 'Open Request' : 'View Record'}</a>
                          : <span class="btn-link-sm btn-archived" title="Archived before the current record set">Record archived</span>}
                        <button class="btn-dots" type="button" disabled title="Row actions arrive with the backend API"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg></button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="sh-empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <div class="sh-empty-text">No service history yet.</div>
            <div class="sh-empty-desc">Requests from this customer will appear here.</div>
          </div>
        )}
      </div>

    </div><!-- /main-col -->

    <!-- RIGHT SIDEBAR COLUMN -->
    <div class="side-col">

      <!-- QUICK ACTIONS -->
      <div class="side-card">
        <div class="side-card-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          <h3 class="side-card-title">Quick Actions</h3>
        </div>
        <div class="quick-actions-list">
          <a class="qa-item" href={phoneHref}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Call Customer
          </a>
          <button class="qa-item" type="button" disabled title="Manual request entry arrives with the backend API">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Request
          </button>
          <button class="qa-item" type="button" disabled title="Customer editing arrives with the backend API">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Edit Details
          </button>
          {activeRequest && (
            <a class="qa-item" href={`/admin/requests/${activeRequest.id}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              View Active Request
            </a>
          )}
          <button class="qa-item" type="button" disabled title="Internal notes arrive with the backend API">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            Add Internal Note
          </button>
        </div>
      </div>

      <!-- RECENT ACTIVITY -->
      <div class="side-card">
        <div class="side-card-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <h3 class="side-card-title">Recent Activity</h3>
        </div>
        <div class="activity-timeline">
          {recentActivity.length === 0 && (
            <div class="empty-notes">No recent activity yet.</div>
          )}
          {recentActivity.map((act, i) => (
            <div class="act-row">
              <div class="act-node-wrap">
                <div class="act-node"></div>
                {i < recentActivity.length - 1 && <div class="act-line"></div>}
              </div>
              <div class="act-body">
                <div class="act-text">{act.text}</div>
                <div class="act-time">{act.time}</div>
              </div>
            </div>
          ))}
        </div>
