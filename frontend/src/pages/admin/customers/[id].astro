            <div class="billing-inv-val tnum">{cust.billing.latestInvoice}</div>
          </div>
          <div>
            <div class="billing-inv-label">Latest payment status</div>
            <span class={`status-badge badge-${cust.billing.paymentStatus === 'Paid' ? 'success' : 'warning'}`}>{cust.billing.paymentStatus}</span>
          </div>
        </div>
        <button class="btn-view-billing">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
          View Billing
        </button>
      </div>

      <!-- INTERNAL NOTES -->
      <div class="side-card">
        <div class="side-card-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
          <div class="side-card-header-right">
            <h3 class="side-card-title">Internal Notes</h3>
            <button class="btn-link-sm">+ Add Internal Note</button>
          </div>
        </div>
        {cust.internalNotes.length > 0 ? (
          <div class="notes-list">
            {cust.internalNotes.map((note: any) => (
              <div class="note-item">
                <div class="note-text">{note.text}</div>
                <div class="note-meta">Added by {note.author} · {note.date}</div>
              </div>
