      </div>

      <!-- COMMUNICATION -->
      <div class="side-card">
        <div class="side-card-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          <h3 class="side-card-title">Communication</h3>
        </div>
        <div class="comm-list">
          {cust.communication.map((c: any) => (
            <div class="comm-row">
              <div class="comm-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div class="comm-text">{c.type}</div>
              <div class="comm-date">{c.date}</div>
            </div>
          ))}
        </div>
      </div>

    </div><!-- /side-col -->

  </div><!-- /content-grid -->

</AdminDashboardLayout>

<style is:global>
