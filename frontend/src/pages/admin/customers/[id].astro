---
import AdminDashboardLayout from '../../../layouts/AdminDashboardLayout.astro';

export function getStaticPaths() {
  return [
    { params: { id: 'HT' } },
    { params: { id: 'MS' } },
    { params: { id: 'SR' } },
    { params: { id: 'AG' } },
    { params: { id: 'BR' } },
  ];
}

const { id } = Astro.params;

// Business: Customer 360 view must be typed so billing/activity cannot drift silently.
// Technical: Explicit detail shape replaces `any`; unknown IDs show a warning banner.
interface CustomerAppliance {
  name: string;
  icon: string;
  model: string;
  lastService: string;
  requests: number;
  outcome: string;
  outcomeClass: string;
}
interface HistoryRow {
  id: string;
  appliance: string;
  problem: string;
  date: string;
  technician: string;
  outcome: string;
  outcomeClass: string;
}
interface ActivityRow {
  icon: string;
  text: string;
  time: string;
}
interface CustomerDetailMock {
  name: string;
  avatarColor: string;
  statusBadge: string;
  statusClass: string;
  location: string;
  since: string;
  phone: string;
  fullName: string;
  area: string;
  preferredContact: string;
  address: string;
  customerCreated: string;
  internalNotesCount: number;
  kpi: { active: number; appliances: number; totalRequests: number; successfulRepairs: number };
  activeRequest: {
    id: string;
    appliance: string;
    status: string;
    statusClass: string;
    technician: string;
    visit: string;
    area: string;
  } | null;
  appliances: CustomerAppliance[];
  serviceHistory: HistoryRow[];
  recentActivity: ActivityRow[];
  billing: { recorded: number; paid: number; pending: number; latestInvoice: string; paymentStatus: string };
  internalNotes: Array<{ text: string; author: string; date: string }>;
  communication: Array<{ type: string; date: string }>;
}
const customerData: Record<string, CustomerDetailMock> = {
  'HT': {
    name: 'Hari Thapa',
    avatarColor: 'var(--navy)',
    statusBadge: 'Active Request',
    statusClass: 'active',
    location: 'Baneshwor, Kathmandu',
    since: 'September 2026',
    phone: '98XX XXX XXX',
    fullName: 'Hari Thapa',
    area: 'Baneshwor; Kathmandu',
    preferredContact: 'None',
    address: 'Near the main road, Baneshwor',
    customerCreated: 'September 2026',
    internalNotesCount: 2,
    kpi: { active: 1, appliances: 2, totalRequests: 3, successfulRepairs: 1 },
    activeRequest: {
      id: 'SL-000124', appliance: 'LG Washing Machine',
      status: 'Diagnosing', statusClass: 'active',
      technician: 'Ramesh', visit: 'Today, 11:30 AM', area: 'Baneshwor'
    },
    appliances: [
      { name: 'LG Washing Machine', icon: 'washer', model: 'FHM1207', lastService: 'Today', requests: 2, outcome: 'Successful Repair', outcomeClass: 'success' },
      { name: 'Samsung Refrigerator', icon: 'fridge', model: 'Not provided', lastService: 'August 29', requests: 1, outcome: 'Repair Declined', outcomeClass: 'warning' }
    ],
    serviceHistory: [
      { id: 'SL-000124', appliance: 'LG Washing Machine', problem: 'Not draining', date: 'Today', technician: 'Ramesh', outcome: 'Active — Diagnosing', outcomeClass: 'active' },
      { id: 'SL-000089', appliance: 'Samsung Refrigerator', problem: 'Not cooling', date: 'August 29', technician: 'Suman', outcome: 'Repair Declined', outcomeClass: 'warning' },
      { id: 'SL-000056', appliance: 'LG Washing Machine', problem: 'Water leakage', date: 'August 12', technician: 'Ramesh', outcome: 'Customer Cancelled', outcomeClass: 'danger' },
      { id: 'SL-000031', appliance: 'LG Washing Machine', problem: 'Drain pump blockage', date: 'July 20', technician: 'Ramesh', outcome: 'Successful Repair', outcomeClass: 'success' }
    ],
    recentActivity: [
      { icon: 'tech', text: 'Technician assigned: Ramesh', time: 'Today, 10:42 AM' },
      { icon: 'admin', text: 'Customer confirmation recorded by admin', time: 'Today, 9:35 AM' },
      { icon: 'req', text: 'Request submitted', time: 'Today, 9:12 AM' },
      { icon: 'x', text: 'Repair price declined by customer', time: 'August 29' },
      { icon: 'check', text: 'Previous service request completed', time: 'August 20' }
    ],
    billing: { recorded: 2, paid: 1, pending: 1, latestInvoice: 'INV-00031', paymentStatus: 'Pending' },
    internalNotes: [
      { text: 'Customer prefers phone calls.', author: 'Sudhar Lab Admin', date: 'Today' },
      { text: 'Customer has two appliances at the same address.', author: 'Sudhar Lab Admin', date: 'August 20' }
    ],
    communication: [
      { type: 'Phone call', date: 'Today' },
      { type: 'Confirmation discussion', date: 'Today' },
      { type: 'Price discussion', date: 'August 29' }
    ]
  },
  'MS': {
    name: 'Mina Shrestha',
    avatarColor: 'var(--teal)',
    statusBadge: 'Repair Declined',
    statusClass: 'warning',
    location: 'Lalitpur',
    since: 'July 2026',
    phone: '98XX XXX XXX',
    fullName: 'Mina Shrestha',
    area: 'Lalitpur',
    preferredContact: 'Phone',
    address: 'Pulchowk, Lalitpur',
    customerCreated: 'July 2026',
    internalNotesCount: 0,
    kpi: { active: 0, appliances: 1, totalRequests: 2, successfulRepairs: 1 },
    activeRequest: null,
    appliances: [
      { name: 'Samsung AC', icon: 'ac', model: 'AR18', lastService: 'Yesterday', requests: 2, outcome: 'Repair Declined', outcomeClass: 'warning' }
    ],
    serviceHistory: [
      { id: 'SL-000115', appliance: 'Samsung AC', problem: 'Not cooling', date: 'Yesterday', technician: 'Ramesh', outcome: 'Repair Declined', outcomeClass: 'warning' },
      { id: 'SL-000045', appliance: 'Samsung AC', problem: 'Gas refill', date: 'July 15', technician: 'Bikash', outcome: 'Successful Repair', outcomeClass: 'success' }
    ],
    recentActivity: [
      { icon: 'x', text: 'Repair price declined by customer', time: 'Yesterday' },
      { icon: 'tech', text: 'Technician visited for diagnosis', time: 'Yesterday' },
      { icon: 'check', text: 'Previous service request completed', time: 'July 15' }
    ],
    billing: { recorded: 1, paid: 1, pending: 0, latestInvoice: 'INV-00045', paymentStatus: 'Paid' },
    internalNotes: [],
    communication: [
      { type: 'Price discussion', date: 'Yesterday' }
    ]
  }
};

const rawCust: CustomerDetailMock | undefined = customerData[id ?? ""];
const isUnknownCustomer = !rawCust;
const cust: CustomerDetailMock = rawCust ?? customerData['HT'] as CustomerDetailMock;
---

<AdminDashboardLayout title={`${cust.name} - Customers - Sudhar Lab`} activeNav="customers">

  <!-- BREADCRUMB -->
  <div class="breadcrumb-row">
    <a href="/admin/dashboard" class="breadcrumb-link">Operations</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
    <a href="/admin/customers" class="breadcrumb-link">Customers</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
    <span class="breadcrumb-current">{cust.name}</span>
  </div>
  {isUnknownCustomer && (
    <p class="form-notice form-notice-info" role="status" style="display:block">Unknown demo customer — showing HT as a placeholder. Wire to GET /api/customers/:id when the backend exists.</p>
  )}

  <!-- HERO SECTION -->
  <div class="hero-card">
    <div class="hero-left">
      <div class="hero-avatar" style={`background-color: ${cust.avatarColor}`}>{id}</div>
      <div class="hero-info">
        <div class="hero-name-row">
          <h1 class="hero-name">{cust.name}</h1>
          <span class={`hero-badge badge-${cust.statusClass}`}>{cust.statusBadge}</span>
        </div>
        <div class="hero-meta-list">
          <div class="hero-meta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            {cust.location}
          </div>
          <div class="hero-meta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            Customer since {cust.since}
          </div>
          <div class="hero-meta">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            {cust.phone}
          </div>
        </div>
      </div>
    </div>
    <div class="hero-actions">
      <button class="btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        Call Customer
      </button>
      <button class="btn-outline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        Edit Details
      </button>
      <button class="btn-outline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Request
      </button>
    </div>
  </div>

  <!-- KPI CARDS -->
  <div class="kpi-grid">
    <div class="kpi-card">
      <div class="kpi-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
      </div>
      <div>
        <div class="kpi-num">{cust.kpi.active}</div>
        <div class="kpi-label">Active Requests</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </div>
      <div>
        <div class="kpi-num">{cust.kpi.appliances}</div>
        <div class="kpi-label">Appliances</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg>
      </div>
      <div>
        <div class="kpi-num">{cust.kpi.totalRequests}</div>
        <div class="kpi-label">Total Requests</div>
      </div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon-wrap teal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <div>
        <div class="kpi-num">{cust.kpi.successfulRepairs}</div>
        <div class="kpi-label">Successful Repairs</div>
      </div>
    </div>
  </div>

  <!-- ACTIVE REQUEST BANNER -->
  {cust.activeRequest && (
    <div class="active-req-banner">
      <div class="banner-icon-wrap">
        <div class="banner-pulse"></div>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <div class="banner-label">Active service request</div>
      <div class="banner-sep"></div>
      <div class="banner-field"><div class="banner-key">Request No.</div><div class="banner-val">{cust.activeRequest.id}</div></div>
      <div class="banner-field"><div class="banner-key">Appliance</div><div class="banner-val">{cust.activeRequest.appliance}</div></div>
      <div class="banner-field">
        <div class="banner-key">Status</div>
        <div class="banner-val"><span class={`status-badge badge-${cust.activeRequest.statusClass}`}>{cust.activeRequest.status}</span></div>
      </div>
      <div class="banner-field"><div class="banner-key">Technician</div><div class="banner-val">{cust.activeRequest.technician}</div></div>
      <div class="banner-field"><div class="banner-key">Visit</div><div class="banner-val">{cust.activeRequest.visit}</div></div>
      <div class="banner-field"><div class="banner-key">Area</div><div class="banner-val">{cust.activeRequest.area}</div></div>
      <button class="btn-open-req" onclick={`window.location.href='/admin/requests/${cust.activeRequest.id}'`}>
        Open Request
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  )}

  <!-- NO ACTIVE REQUEST STATE (for customers without active requests) -->
  {!cust.activeRequest && (
    <div class="no-request-banner">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      <div>
        <div class="no-req-title">No active service request</div>
        <div class="no-req-desc">New requests from this customer will appear here.</div>
      </div>
    </div>
  )}

  <!-- MAIN CONTENT GRID: LEFT + RIGHT -->
  <div class="content-grid">

    <!-- LEFT / CENTER COLUMN -->
    <div class="main-col">

      <!-- CUSTOMER INFORMATION -->
      <div class="section-card">
        <div class="section-head">
          <div class="section-head-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <h2 class="section-title">Customer Information</h2>
          </div>
          <div class="section-head-right">
            {cust.internalNotesCount > 0 && (
              <div class="notes-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                {cust.internalNotesCount} internal notes
              </div>
            )}
            <button class="btn-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              Edit Details
            </button>
          </div>
        </div>

        <div class="info-cols">
          <div class="info-col">
            <div class="info-field">
              <div class="info-label">Full name</div>
              <div class="info-val">{cust.fullName}</div>
            </div>
            <div class="info-field">
              <div class="info-label">Phone</div>
              <div class="info-val">{cust.phone}</div>
            </div>
            <div class="info-field">
              <div class="info-label">Address</div>
              <div class="info-val">{cust.address}</div>
            </div>
          </div>
          <div class="info-col">
            <div class="info-field">
              <div class="info-label">Area</div>
              <div class="info-val">{cust.area}</div>
            </div>
            <div class="info-field">
              <div class="info-label">Preferred contact</div>
              <div class="info-val">{cust.preferredContact}</div>
            </div>
            <div class="info-field">
              <div class="info-label">Customer created</div>
              <div class="info-val">{cust.customerCreated}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- APPLIANCES -->
      <div class="section-card">
        <div class="section-head">
          <div class="section-head-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline></svg>
            <div>
              <h2 class="section-title">Appliances</h2>
              <div class="section-desc">Appliances connected to this customer and their service history.</div>
            </div>
          </div>
        </div>

        <div class="appliance-grid">
          {cust.appliances.map((app: any) => (
            <div class="appliance-card">
              <div class="appliance-header">
                <div class="appliance-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><rect x="2" y="3" width="20" height="18" rx="2" ry="2"></rect><line x1="2" y1="9" x2="22" y2="9"></line><path d="M12 3v6"></path></svg>
                </div>
                <div class="appliance-name">{app.name}</div>
              </div>
              <div class="appliance-details">
                <div class="appl-detail">
                  <span class="appl-key">Model</span>
                  <span class="appl-val">{app.model}</span>
                </div>
                <div class="appl-detail">
                  <span class="appl-key">Last service</span>
                  <span class="appl-val">{app.lastService}</span>
                </div>
                <div class="appl-detail">
                  <span class="appl-key">Service requests</span>
                  <span class="appl-val">{app.requests}</span>
                </div>
                <div class="appl-detail">
                  <span class="appl-key">Latest outcome</span>
                  <span class={`status-badge badge-${app.outcomeClass}`}>{app.outcome}</span>
                </div>
              </div>
              <button class="btn-view-history">View History</button>
            </div>
          ))}

          <!-- ADD APPLIANCE CARD -->
          <div class="appliance-add-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <div class="add-appliance-text">Add another appliance</div>
          </div>
        </div>
      </div>

      <!-- SERVICE HISTORY -->
      <div class="section-card">
        <div class="section-head">
          <div class="section-head-left">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            <h2 class="section-title">Service History</h2>
          </div>
        </div>

        <!-- SERVICE HISTORY TABS -->
        <div class="sh-tabs">
          <button class="sh-tab active">All</button>
          <button class="sh-tab">Active</button>
          <button class="sh-tab">No Technician Visit</button>
          <button class="sh-tab">Customer Cancelled</button>
          <button class="sh-tab">Repair Declined</button>
          <button class="sh-tab">Successful Repair</button>
        </div>

        <div class="sh-table-wrap">
          <table class="sh-table">
            <thead>
              <tr>
                <th>Request</th>
                <th>Appliance</th>
                <th>Problem</th>
                <th>Date</th>
                <th>Technician</th>
                <th>Outcome</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {cust.serviceHistory.map((req: any) => (
                <tr class="sh-row">
                  <td><div class="req-id">{req.id}</div></td>
                  <td><div class="cell-text">{req.appliance}</div></td>
                  <td><div class="cell-text">{req.problem}</div></td>
                  <td><div class="cell-text">{req.date}</div></td>
                  <td><div class="cell-text">{req.technician}</div></td>
                  <td><span class={`status-badge badge-${req.outcomeClass}`}>{req.outcome}</span></td>
                  <td>
                    <div class="action-cell">
                      <button class="btn-link-sm" onclick={`window.location.href='/admin/requests/${req.id}'`}>
                        {req.outcomeClass === 'active' ? 'Open Request' : 'View Record'}
                      </button>
                      <button class="btn-dots"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="1"></circle><circle cx="12" cy="5" r="1"></circle><circle cx="12" cy="19" r="1"></circle></svg></button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- EMPTY STATE: No appliance records -->
        <div class="sh-empty-row">
          <div class="sh-empty-col">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <div class="sh-empty-text">No active service request</div>
            <div class="sh-empty-desc">New requests from this customer will appear here.</div>
          </div>
          <div class="sh-empty-col">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline></svg>
            <div class="sh-empty-text">No appliance records yet.</div>
            <div class="sh-empty-desc">Appliances will appear after the first request.</div>
          </div>
        </div>
      </div>

    </div><!-- /main-col -->

    <!-- RIGHT SIDEBAR COLUMN -->
    <div class="side-col">

      <!-- QUICK ACTIONS -->
      <div class="side-card">
        <div class="side-card-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          <h3 class="side-card-title">Quick Actions</h3>
