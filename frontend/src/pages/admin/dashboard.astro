---
import AdminDashboardLayout from '../../layouts/AdminDashboardLayout.astro';
// Business: The dashboard is a live read of the queue, never a second copy of it. After sign-in we fetch
// Business: technicians, customers and requests from the Worker, then group / count / join everything in the
// Business: browser. Static output means the shell renders empty; nothing is baked. Changing a request in the
// Business: backend updates this dashboard, the lists and the detail together — one truth, no demo drift.
// Technical: Group membership mirrors features/requests/queue status keys exactly; the technician rows reuse
// deriveRoster() so a card here and the roster page can never disagree. This file only paints.
---

<AdminDashboardLayout title="Home - Sudhar Lab Admin" activeNav="dashboard">

  <!-- TODAY'S DATE -->
  <div class="today-row">
    <div class="today-date" id="today-date"></div>
    <div class="today-stats">
      <div class="stat-chip chip-green">
        <span class="chip-dot"></span>
        <span id="chipOnline">— technicians online</span>
      </div>
      <div class="stat-chip chip-amber">
        <span class="chip-dot"></span>
        <span id="chipNew">— unassigned</span>
      </div>
    </div>
  </div>

  <!-- GROUP 1: Call & Confirm -->
  <div class="queue-group">
    <div class="group-header">
      <div class="group-title">
        <div class="group-dot red"></div>
        <span>Call &amp; Confirm</span>
        <span class="group-count" id="cCall">0</span>
      </div>
      <div class="group-sub">New requests waiting — call the customer and confirm the visit</div>
    </div>
    <div class="queue-cards" id="gCall"></div>
  </div>

  <!-- GROUP 2: Assign Technician -->
  <div class="queue-group">
    <div class="group-header">
      <div class="group-title">
        <div class="group-dot amber"></div>
        <span>Assign Technician</span>
        <span class="group-count" id="cAssign">0</span>
      </div>
      <div class="group-sub">Order confirmed — pick a technician and send them out</div>
    </div>
    <div class="queue-cards" id="gAssign"></div>
  </div>

  <!-- GROUP 3: Waiting for Customer -->
  <div class="queue-group">
    <div class="group-header">
      <div class="group-title">
        <div class="group-dot purple"></div>
        <span>Waiting for Customer</span>
        <span class="group-count" id="cWait">0</span>
      </div>
      <div class="group-sub">Diagnosis done — follow up with customer on repair price</div>
    </div>
    <div class="queue-cards" id="gWait"></div>
  </div>

  <!-- ═══════════════════════════════════ -->
  <!--  LIVE JOBS + TECHNICIAN STATUS     -->
  <!-- ═══════════════════════════════════ -->
  <div class="bottom-grid">

    <div class="card card-pad">
      <div class="section-head">
        <div class="section-title"><div class="live-dot"></div>Live Jobs</div>
        <a href="/admin/requests" class="see-all">See all →</a>
      </div>
      <div class="live-jobs-list" id="liveJobs"><div class="dash-empty">Loading…</div></div>
    </div>

    <div class="card card-pad">
      <div class="section-head">
        <div class="section-title">Technicians</div>
        <a href="/admin/technicians" class="see-all">Manage →</a>
      </div>
      <div class="tech-list" id="techList"><div class="dash-empty">Loading…</div></div>
    </div>

    <div class="card card-pad">
      <div class="section-head">
        <div class="section-title">Today</div>
      </div>
      <div class="summary-grid">
        <div class="sum-item"><div class="sum-num amber" id="sumNew">0</div><div class="sum-label">New Requests</div></div>
        <div class="sum-item"><div class="sum-num blue" id="sumAssign">0</div><div class="sum-label">To Assign</div></div>
        <div class="sum-item"><div class="sum-num purple" id="sumActive">0</div><div class="sum-label">Active Jobs</div></div>
        <div class="sum-item"><div class="sum-num green" id="sumDone">0</div><div class="sum-label">Completed</div></div>
      </div>
      <div class="divider" style="margin: 1rem 0;"></div>
      <div class="recently-done">
        <div class="rd-label">Completed today</div>
        <div id="recentDone"><div class="rd-detail">No completed visits yet today.</div></div>
      </div>
    </div>

  </div>

</AdminDashboardLayout>

<script>
import { ApiError, staff, type ApiRequest } from '../../lib/api-client';
import { requireSession } from '../../lib/session';
import { isActive, isDone, statusKey } from '../../features/requests/queue';
import { deriveRoster, initialsFor, avatarHueFor, type TechnicianCard } from '../../features/staff/roster';
import { getBadgeClass, SERVICE_STATUS_LABEL, type ServiceStatusKey } from '../../lib/service-status';

const session = requireSession('admin');

function esc(value: unknown): string {
  return String(value ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
}
const label = (status: string): string => SERVICE_STATUS_LABEL[status as ServiceStatusKey] ?? status;
const badgeCls = (status: string): string => getBadgeClass(status as ServiceStatusKey);
const npr = (amount: number): string => `NPR ${amount.toLocaleString('en-IN')}`;
const ago = (iso: string): string => {
  const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60_000);
  if (mins < 1) return 'Just now';
  if (mins < 60) return `${mins} min ago`;
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return `${hrs} hr${hrs === 1 ? '' : 's'} ago`;
  const days = Math.round(hrs / 24);
  if (days === 1) return 'Yesterday';
  if (days < 7) return `${days} days ago`;
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
};

const PHONE_I = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>';
const USER_I = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>';
const PIN_I = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>';
const INFO_I = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';

const APPLIANCE_SHORT: Record<string, string> = {
  'Washing machine': 'Washer', Refrigerator: 'Fridge', 'Air conditioner': 'AC', Television: 'TV',
};
const applianceShort = (type: string): string => APPLIANCE_SHORT[type] ?? type;

const detailHref = (code: string): string => `/admin/requests/detail?code=${encodeURIComponent(code)}`;

// Business: A queue card is real data + one honest next-step. The chips under "Assign" are derived live from
// Business: the roster (skill matches the appliance, online now, fewest open jobs) — the same rule the server
// Business: uses for its detail-page recommendations, so this preview and that page tell one story.
function card(req: ApiRequest, kind: 'call' | 'assign' | 'follow', roster: TechnicianCard[]): string {
  const href = detailHref(req.code);
  const custName = req.customer?.name ?? '—';
  const area = req.customer?.area ?? '';
  const initials = initialsFor(custName);
  const hue = avatarHueFor(req.customerId);
  const cust = `<div class="qc-customer"><div class="qc-avatar" style="background:${esc(hue)}">${esc(initials)}</div>
    <div><div class="qc-name">${esc(custName)}</div><div class="qc-meta">${PIN_I}${esc(area)} · ${esc(req.appliance.brand)} ${esc(req.appliance.type)}</div></div></div>`;

  const mainLabel = kind === 'call' ? 'Call &amp; Confirm' : kind === 'assign' ? 'Assign Technician' : 'Follow Up with Customer';
  const mainIcon = kind === 'assign' ? USER_I : PHONE_I;

  let extra = '';
  if (kind === 'assign') {
    const matches = roster
      .filter((t) => t.availability === 'online' && t.skills.some((s) => s.toLowerCase().includes(req.appliance.type.toLowerCase()) || req.appliance.type.toLowerCase().includes(s.toLowerCase())))
      .sort((a, b) => a.activeJobs - b.activeJobs)
      .slice(0, 3);
    const chips = matches.map((t) => {
      const first = t.name.split(' ')[0];
      const cls = t.currentJobId ? 'amber' : 'green';
      const text = t.currentJobId ? `${first} — ${label(t.currentJobStatus ?? '')}` : `${first} — Available`;
      return `<div class="avail-chip ${cls}"><span class="avail-dot"></span>${esc(text)}</div>`;
    }).join('');
    extra = `<div class="qc-avail-row">${chips || '<div class="dash-inline-empty">No online match on the roster yet</div>'}</div>`;
  } else if (kind === 'follow') {
    const fault = req.fault;
    const price = req.price ? npr(req.price.amount) : null;
    if (fault || price) {
      extra = `<div class="qc-diagnosis">${INFO_I}${esc(fault ?? 'Repair proposed')}${price ? ` — <strong>${esc(price)}</strong>` : ''}</div>`;
    }
  }

  return `<div class="queue-card${req.urgent ? ' urgent' : ''}">
    <div class="qc-top"><div class="qc-id tnum">${esc(req.code)}</div><span class="badge ${badgeCls(req.status)}">${esc(label(req.status))}</span><div class="qc-time">${esc(ago(req.createdAt))}</div></div>
    ${cust}
    ${kind === 'call' ? `<div class="qc-problem">&ldquo;${esc(req.problem)}&rdquo;</div>` : ''}
    ${extra}
    <div class="qc-actions">
      <a class="btn btn-primary btn-sm qc-main-btn" href="${href}">${mainIcon} ${mainLabel}</a>
      <a class="btn btn-secondary btn-sm" href="${href}">View</a>
    </div>
  </div>`;
}

function techRow(t: TechnicianCard): string {
  const statusText = t.currentJobId && t.currentJobStatus
    ? `${label(t.currentJobStatus)} — ${t.currentJobId}`
    : t.availability === 'offline' ? 'Offline' : 'Available';
  const badgeInfo = t.currentJobStatus
    ? { label: label(t.currentJobStatus), cls: badgeCls(t.currentJobStatus) }
    : t.availability === 'offline' ? { label: 'Offline', cls: 'badge-neutral' } : { label: 'Available', cls: 'badge-done' };
  return `<a class="tech-row" href="/admin/technicians/detail?id=${encodeURIComponent(t.id)}">
    <div class="tech-av-dot ${esc(t.availability)}"></div>
    <div class="tech-av" style="background:${esc(t.avatarHue)}">${esc(t.initials)}</div>
    <div class="tech-info"><div class="tech-name">${esc(t.name)}</div><div class="tech-status">${esc(statusText)}</div></div>
    <span class="badge ${badgeInfo.cls}">${esc(badgeInfo.label)}</span>
  </a>`;
}

function liveJobRow(r: ApiRequest): string {
  const first = r.technician?.name.split(' ')[0] ?? '—';
  const detail = `${first} · ${r.appliance.brand} ${r.appliance.type} · ${r.customer?.area ?? ''}`;
  return `<a class="live-job-row" href="${detailHref(r.code)}">
    <div class="live-job-info"><div class="lj-id tnum">${esc(r.code)}</div><div class="lj-detail">${esc(detail)}</div></div>
    <span class="badge ${badgeCls(r.status)}">${esc(label(r.status))}</span>
  </a>`;
}

function setText(id: string, value: string): void {
  const el = document.getElementById(id);
  if (el) el.textContent = value;
}

function fillGroup(id: string, countId: string, rows: ApiRequest[], kind: 'call' | 'assign' | 'follow', roster: TechnicianCard[]): void {
  setText(countId, String(rows.length));
  const el = document.getElementById(id);
  if (!el) return;
  el.innerHTML = rows.length === 0
    ? '<div class="dash-empty">Nothing here right now.</div>'
    : rows.map((r) => card(r, kind, roster)).join('');
}

async function load(): Promise<void> {
  if (!session) return;
  try {
    const [technicians, requests] = await Promise.all([staff.listTechnicians(), staff.listAdminRequests()]);
    const roster = deriveRoster(technicians, requests);

    const call = requests.filter((r) => statusKey(r) === 'NEW_REQUEST');
    const assign = requests.filter((r) => statusKey(r) === 'ORDER_CONFIRMED' && !r.technicianId);
    const waiting = requests.filter((r) => statusKey(r) === 'PRICE_APPROVAL');
    const live = requests.filter(isActive);
    const isToday = (iso: string): boolean => new Date(iso).toDateString() === new Date().toDateString();
    const completedToday = requests.filter((r) => isDone(r) && isToday(r.updatedAt));

    fillGroup('gCall', 'cCall', call, 'call', roster);
    fillGroup('gAssign', 'cAssign', assign, 'assign', roster);
    fillGroup('gWait', 'cWait', waiting, 'follow', roster);

    const online = roster.filter((t) => t.availability === 'online').length;
    setText('chipOnline', `${online} technician${online === 1 ? '' : 's'} online`);
    setText('chipNew', `${call.length} unassigned`);

    setText('sumNew', String(call.length));
    setText('sumAssign', String(assign.length));
    setText('sumActive', String(live.length));
    setText('sumDone', String(completedToday.length));

    const liveEl = document.getElementById('liveJobs');
    if (liveEl) liveEl.innerHTML = live.length === 0
      ? '<div class="dash-empty">No jobs in progress.</div>'
      : live.map(liveJobRow).join('');

    const techEl = document.getElementById('techList');
    if (techEl) techEl.innerHTML = roster.length === 0
      ? '<div class="dash-empty">No technicians yet.</div>'
      : roster.map(techRow).join('');

    const rdEl = document.getElementById('recentDone');
    if (rdEl) rdEl.innerHTML = completedToday.length === 0
      ? '<div class="rd-detail">No completed visits yet today.</div>'
      : completedToday.map((r) => `<div class="rd-row"><a class="lj-id tnum" style="font-size:0.75rem" href="${detailHref(r.code)}">${esc(r.code)}</a><span class="rd-detail">${esc(r.customer?.name ?? '—')} · ${esc(applianceShort(r.appliance.type))} · ${esc(r.customer?.area ?? '')}</span><span class="badge badge-done">Done</span></div>`).join('');
  } catch (err) {
    if (err instanceof ApiError && err.status === 401) return; // authorizedFetch already redirected to login
    document.querySelectorAll('.queue-cards, #liveJobs, #techList').forEach((el) => {
      if (el && (el.textContent || '').trim().toLowerCase().includes('loading')) el.innerHTML = '<div class="dash-empty">Could not load. Please refresh.</div>';
    });
  }
}

const dateEl = document.getElementById('today-date');
if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

if (session) void load();
</script>

<style is:global>
  /* Today row */
  .today-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 0.75rem; }
  .today-date { font-family: var(--font-h); font-size: 0.9375rem; font-weight: 600; color: var(--graphite-mid); }
  .today-stats { display: flex; gap: 0.625rem; }
  .stat-chip { display: flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: 20px; }
  .chip-green { background: #DCFCE7; color: #16A34A; }
  .chip-amber { background: #FEF3C7; color: #D97706; }
  .chip-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  /* Queue Groups */
  .queue-group { margin-bottom: 2rem; }
  .group-header { margin-bottom: 0.875rem; }
  .group-title { display: flex; align-items: center; gap: 0.625rem; font-family: var(--font-h); font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 0.25rem; }
  .group-dot { width: 10px; height: 10px; border-radius: 50%; }
  .group-dot.red    { background: #EF4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.15); }
  .group-dot.amber  { background: #F59E0B; box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }
  .group-dot.purple { background: #8B5CF6; box-shadow: 0 0 0 3px rgba(139,92,246,0.15); }
  .group-count { font-size: 0.75rem; font-weight: 700; background: var(--border); color: var(--graphite-mid); padding: 0.125rem 0.5rem; border-radius: 20px; }
  .group-sub { font-size: 0.8125rem; color: var(--graphite-lt); margin-left: 1.375rem; }

  /* Queue Cards */
  .queue-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, minmax(0, 1fr))); gap: 1rem; }
  .queue-card { background: var(--pure-white); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; display: flex; flex-direction: column; gap: 0.875rem; transition: box-shadow 0.15s; }
  .queue-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
  .queue-card.urgent { border-left: 3px solid #EF4444; }
  .qc-top { display: flex; align-items: center; gap: 0.625rem; }
  .qc-id { font-size: 0.8125rem; font-weight: 700; color: var(--teal); }
  .qc-time { margin-left: auto; font-size: 0.75rem; color: var(--graphite-lt); }
  .qc-customer { display: flex; align-items: center; gap: 0.75rem; }
  .qc-avatar { width: 36px; height: 36px; border-radius: 50%; color: #fff; font-family: var(--font-h); font-size: 0.8125rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .qc-name { font-size: 0.9375rem; font-weight: 700; color: var(--navy); }
  .qc-meta { display: flex; align-items: center; gap: 0.25rem; font-size: 0.75rem; color: var(--graphite-lt); margin-top: 0.125rem; }
  .qc-problem { font-size: 0.8125rem; color: var(--graphite-mid); background: var(--bg); border-radius: 6px; padding: 0.5rem 0.75rem; font-style: normal; }
  .qc-avail-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .avail-chip { display: flex; align-items: center; gap: 0.375rem; font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.625rem; border-radius: 20px; }
  .avail-chip.green { background: #DCFCE7; color: #16A34A; }
  .avail-chip.amber { background: #FEF3C7; color: #D97706; }
  .avail-chip.grey  { background: #F3F4F6; color: var(--graphite-mid); }
  .avail-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .qc-diagnosis { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--graphite-mid); background: var(--bg); border-radius: 6px; padding: 0.5rem 0.75rem; }
  .qc-actions { display: flex; gap: 0.5rem; }
  .qc-main-btn { flex: 1; justify-content: center; }
  .dash-empty, .dash-inline-empty { font-size: 0.8125rem; color: var(--graphite-lt); padding: 0.5rem 0; grid-column: 1 / -1; }
  .dash-inline-empty { padding: 0; }

  /* Bottom Grid */
  .bottom-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 0.8fr); gap: 1.25rem; margin-top: 0.5rem; }
  .section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .section-title { font-family: var(--font-h); font-size: 0.9375rem; font-weight: 700; color: var(--navy); display: flex; align-items: center; gap: 0.5rem; }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #EF4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.2); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  .see-all { font-size: 0.8125rem; font-weight: 600; color: var(--teal); text-decoration: none; }
  .see-all:hover { text-decoration: underline; }

  /* Live jobs */
  .live-jobs-list { display: flex; flex-direction: column; gap: 0; }
  .live-job-row { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid var(--border); }
  .live-job-row:last-child { border-bottom: none; }
  .lj-id { font-size: 0.8125rem; font-weight: 700; color: var(--teal); margin-bottom: 0.125rem; }
  .lj-detail { font-size: 0.75rem; color: var(--graphite-lt); }
  a.live-job-row, a.tech-row { color: inherit; text-decoration: none; }
  a.live-job-row:hover .lj-id, a.tech-row:hover .tech-name { text-decoration: underline; }
  a.lj-id:hover { text-decoration: underline; }

  /* Tech list */
  .tech-list { display: flex; flex-direction: column; gap: 0; }
  .tech-row { display: flex; align-items: center; gap: 0.625rem; padding: 0.625rem 0; border-bottom: 1px solid var(--border); position: relative; flex-wrap: nowrap; }
  .tech-row:last-child { border-bottom: none; }
  .tech-av { width: 30px; height: 30px; border-radius: 50%; color: #fff; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; position: relative; }
  .tech-av-dot { position: static; width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .tech-av-dot.online  { background: #16A34A; }
  .tech-av-dot.offline { background: #9CA3AF; }
  .tech-info { flex: 1; min-width: 0; }
  .tech-name { font-size: 0.8125rem; font-weight: 600; color: var(--navy); }
  .tech-status { font-size: 0.75rem; color: var(--graphite-lt); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Summary grid */
  .summary-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0.875rem; }
  .sum-item { background: var(--bg); border-radius: 8px; padding: 0.875rem; text-align: center; }
  .sum-num { font-family: var(--font-h); font-size: 1.75rem; font-weight: 800; line-height: 1; margin-bottom: 0.25rem; }
  .sum-num.amber  { color: #D97706; }
  .sum-num.blue   { color: #3B82F6; }
  .sum-num.purple { color: #8B5CF6; }
  .sum-num.green  { color: #16A34A; }
  .sum-label { font-size: 0.75rem; font-weight: 600; color: var(--graphite-lt); text-transform: uppercase; letter-spacing: 0.04em; }

  .recently-done { grid-column: 1 / -1; }
  .rd-label { font-size: 0.75rem; font-weight: 700; color: var(--graphite-lt); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.625rem; }
  .rd-row { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .rd-detail { font-size: 0.75rem; color: var(--graphite-mid); flex: 1; }

  @media (max-width: 1100px) {
    .bottom-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
