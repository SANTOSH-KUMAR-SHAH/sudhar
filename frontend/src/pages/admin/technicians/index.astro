---
import AdminDashboardLayout from '../../../layouts/AdminDashboardLayout.astro';
// Business: The roster is now LIVE — after sign-in we fetch technicians and the request queue from the
// Business: Worker and join each technician's current job / weekly completions in the browser. Because the
// Business: site builds statically, nothing can be baked here; the shell renders empty and fills client-side.
// Technical: The join lives in features/staff/roster.ts (pure). This page only guards the session and paints.
---

<AdminDashboardLayout title="Technicians - Sudhar Lab Admin" activeNav="technicians">

  <!-- HEADER -->
  <div class="tc-header">
    <div>
      <h1 class="tc-title">Technicians</h1>
      <p class="tc-sub">Manage availability and see who's where</p>
    </div>
    <div class="tc-hdr-right">
      <div class="tc-online-count">
        <div class="online-dot-big"></div>
        <span><strong id="tcOnlineCount">—</strong> online</span>
      </div>
      <button class="btn btn-secondary btn-sm" type="button" disabled title="Technician onboarding arrives with the backend API">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Technician
      </button>
    </div>
  </div>

  <!-- STATUS FILTER TABS -->
  <div class="tc-tabs">
    <button class="tc-tab active" id="tc-tab-all" onclick="switchTechTab('all')">All <span class="tc-tab-count" id="tc-count-all">0</span></button>
    <button class="tc-tab" id="tc-tab-online" onclick="switchTechTab('online')">Online <span class="tc-tab-count online-count" id="tc-count-online">0</span></button>
    <button class="tc-tab" id="tc-tab-offline" onclick="switchTechTab('offline')">Offline <span class="tc-tab-count" id="tc-count-offline">0</span></button>
  </div>

  <!-- TECHNICIAN CARD GRID (filled live by the script below) -->
  <div class="tc-grid" id="tcGrid">
    <div class="tc-status" style="grid-column: 1 / -1;">Loading the roster…</div>
  </div>

</AdminDashboardLayout>

<script>
// Business: Only a signed-in admin sees this roster, and what they see is the live Worker truth joined in
// Business: the browser — never a cached demo. The Online/Offline tabs then filter the same live cards.
// Technical: Astro bundles this as a module; we expose one global (switchTechTab) for the markup's inline
// handlers and paint cards from deriveRoster(). Real jobs open on the LIVE detail routes (?id / ?code).
import { ApiError, staff } from '../../../lib/api-client';
import { requireSession } from '../../../lib/session';
import { getBadgeClass, SERVICE_STATUS_LABEL, type ServiceStatusKey } from '../../../lib/service-status';
import { deriveRoster, type TechnicianCard } from '../../../features/staff/roster';

const session = requireSession('admin');

function esc(value: unknown): string {
  return String(value ?? '').replace(/[&<>"']/g, (c) =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c);
}

// Inline icons copied so the generated cards match the hand-authored markup one-for-one.
const PIN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="11" height="11"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>';
const CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><polyline points="20 6 9 17 4 12"></polyline></svg>';
const PHONE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6.51-7.23 19.79 19.79 0 0 1-3.07-8.63 2 2 0 0 1 2-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2.11z"></path></svg>';

const statusLabelFor = (status: string): string =>
  SERVICE_STATUS_LABEL[status as ServiceStatusKey] ?? status;
const badgeFor = (status: string): string => getBadgeClass(status as ServiceStatusKey);

function cardHtml(tech: TechnicianCard): string {
  const jobBlock = tech.currentJobId && tech.currentJobStatus
    ? `<div class="tc-current-job"><a class="tc-cj-id" href="/admin/requests/detail?code=${encodeURIComponent(tech.currentJobId)}">${esc(tech.currentJobId)}</a><span class="badge ${badgeFor(tech.currentJobStatus)}">${esc(statusLabelFor(tech.currentJobStatus))}</span></div>`
    : tech.availability === 'online'
    ? `<div class="tc-available">${CHECK} Available for assignment</div>`
    : '<div class="tc-idle">Offline — not accepting visits</div>';
  const assignBtn = tech.availability === 'online' && !tech.currentJobId
    ? '<a class="btn btn-primary btn-sm" href="/admin/requests">Assign Job</a>' : '';
  const skills = tech.skills.map((s) => `<span class="skill-chip">${esc(s)}</span>`).join('');
  return `<div class="tc-card" data-availability="${esc(tech.availability)}">
    <div class="tc-card-top">
      <div class="tc-avatar-wrap">
        <div class="tc-avatar" style="background:${esc(tech.avatarHue)}">${esc(tech.initials)}</div>
        <div class="tc-status-dot ${esc(tech.availability)}"></div>
      </div>
      <div class="tc-info">
        <a class="tc-name tc-name-link" href="/admin/technicians/detail?id=${encodeURIComponent(tech.id)}">${esc(tech.name)}</a>
        <div class="tc-area">${PIN}${esc(tech.area)}</div>
      </div>
    </div>
    ${jobBlock}
    <div class="tc-skills">${skills}</div>
    <div class="tc-card-footer">
      <div class="tc-week"><span class="tc-week-num">${tech.completedThisWeek}</span> done this week</div>
      <div class="tc-card-actions">
        <a class="btn btn-ghost btn-sm" href="tel:${esc(tech.phone.replace(/\s/g, ''))}">${PHONE} Call</a>
        ${assignBtn}
      </div>
    </div>
  </div>`;
}

function applyTechTab(kind: string): void {
  document.querySelectorAll('.tc-tab').forEach((t) => t.classList.remove('active'));
  document.getElementById(`tc-tab-${kind}`)?.classList.add('active');
  document.querySelectorAll('.tc-card').forEach((card) => {
    const av = card.getAttribute('data-availability');
    (card as HTMLElement).style.display = (kind === 'all' || av === kind) ? '' : 'none';
  });
}
(window as unknown as { switchTechTab: (kind: string) => void }).switchTechTab = applyTechTab;

function setStatus(text: string): void {
  const grid = document.getElementById('tcGrid');
  if (grid) grid.innerHTML = `<div class="tc-status" style="grid-column: 1 / -1;">${esc(text)}</div>`;
}

async function load(): Promise<void> {
  if (!session) return;
  try {
    const [technicians, requests] = await Promise.all([
      staff.listTechnicians(),
      staff.listAdminRequests(),
    ]);
    const cards = deriveRoster(technicians, requests);
    if (cards.length === 0) { setStatus('No technicians on the roster yet.'); return; }
    const grid = document.getElementById('tcGrid');
    if (!grid) return;
    grid.innerHTML = cards.map(cardHtml).join('');
    const online = cards.filter((c) => c.availability === 'online').length;
    const setText = (id: string, value: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(value);
    };
    setText('tcOnlineCount', online);
    setText('tc-count-all', cards.length);
    setText('tc-count-online', online);
    setText('tc-count-offline', cards.length - online);
    applyTechTab('all');
  } catch (err) {
    if (err instanceof ApiError && err.status === 401) return; // authorizedFetch already redirected to login
    setStatus('Could not load the roster. Please refresh.');
  }
}

if (session) void load();
</script>

<style is:global>
  .tc-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 1.5rem;
  }
  .tc-title { font-family: var(--font-h); font-size: 1.75rem; font-weight: 800; color: var(--navy); }
  .tc-sub { color: var(--graphite-lt); font-size: 0.875rem; margin-top: 0.25rem; }
  .tc-hdr-right { display: flex; align-items: center; gap: 1rem; }
  .tc-online-count {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.875rem; color: var(--graphite-mid);
  }
  .tc-online-count strong { color: var(--navy); }
  .online-dot-big {
    width: 10px; height: 10px; border-radius: 50%; background: #16A34A;
    box-shadow: 0 0 0 3px rgba(22,163,74,0.2);
  }

  /* Transient roster states (loading / empty / error) read as one calm centred line. */
  .tc-status { padding: 2rem; text-align: center; color: var(--graphite-lt); font-size: 0.875rem; }

  /* Tabs */
  .tc-tabs {
    display: flex; gap: 0;
    border-bottom: 2px solid var(--border); margin-bottom: 1.5rem;
  }
  .tc-tab {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.6875rem 1rem; background: none; border: none;
    border-bottom: 2px solid transparent; margin-bottom: -2px;
    font-size: 0.875rem; font-weight: 500;
    color: var(--graphite-mid); cursor: pointer;
  }
  .tc-tab:hover { color: var(--navy); }
  .tc-tab.active { color: var(--teal); font-weight: 700; border-bottom-color: var(--teal); }
  .tc-tab-count {
    font-size: 0.75rem; font-weight: 700;
    background: var(--border); color: var(--graphite-mid);
    padding: 0.0625rem 0.4375rem; border-radius: 20px;
  }
  .online-count { background: #DCFCE7; color: #16A34A; }

  /* Grid */
  .tc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.125rem;
  }

  .tc-card {
    background: var(--pure-white); border: 1px solid var(--border);
    border-radius: 12px; padding: 1.25rem;
    display: flex; flex-direction: column; gap: 1rem;
    position: relative; transition: all 0.15s;
  }
  .tc-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.07); transform: translateY(-1px); }
  /* Business: the name is the card's link target — real anchor, keyboard focusable. */
  /* Technical: ::after stretches the hit area over the card; action buttons stay on top. */
  .tc-name-link { text-decoration: none; color: var(--navy); }
  .tc-name-link:hover { text-decoration: underline; }
  .tc-name-link::after { content: ''; position: absolute; inset: 0; border-radius: 12px; }
  .tc-card:hover .tc-name-link::after { z-index: 0; }
  .tc-card-actions { display: flex; gap: 0.5rem; position: relative; z-index: 1; }

  /* Card top */
  .tc-card-top { display: flex; align-items: center; gap: 0.875rem; }
  .tc-avatar-wrap { position: relative; flex-shrink: 0; }
  .tc-avatar {
    width: 46px; height: 46px; border-radius: 50%;
    color: #fff; font-family: var(--font-h); font-size: 1rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .tc-status-dot {
    position: absolute; bottom: 1px; right: 1px;
    width: 11px; height: 11px; border-radius: 50%;
    border: 2px solid var(--pure-white);
  }
  .tc-status-dot.online  { background: #16A34A; }
  .tc-status-dot.offline { background: #9CA3AF; }

  .tc-info {}
  .tc-name { font-size: 1rem; font-weight: 700; color: var(--navy); }
  .tc-area {
    display: flex; align-items: center; gap: 0.25rem;
    font-size: 0.75rem; color: var(--graphite-lt); margin-top: 0.125rem;
  }

  /* Current job */
  .tc-current-job {
    display: flex; align-items: center; justify-content: space-between;
    background: var(--bg); border-radius: 8px; padding: 0.625rem 0.875rem;
  }
  .tc-cj-id { font-size: 0.875rem; font-weight: 700; color: var(--teal); text-decoration: none; }
  .tc-cj-id:hover { text-decoration: underline; }

  .tc-available {
    display: flex; align-items: center; gap: 0.375rem;
    font-size: 0.8125rem; font-weight: 600; color: #16A34A;
    background: #F0FDF4; border-radius: 8px;
    padding: 0.5rem 0.875rem;
  }
  .tc-idle {
    font-size: 0.8125rem; font-weight: 600; color: var(--graphite-lt);
    background: var(--bg); border-radius: 8px;
    padding: 0.5rem 0.875rem;
  }

  /* Skills */
  .tc-skills { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .skill-chip {
    font-size: 0.75rem; font-weight: 600;
    padding: 0.1875rem 0.5625rem; border-radius: 20px;
    background: var(--bg); color: var(--graphite-mid);
    border: 1px solid var(--border);
  }

  /* Footer */
  .tc-card-footer {
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid var(--border); padding-top: 0.875rem;
  }
  .tc-week { font-size: 0.75rem; color: var(--graphite-lt); }
  .tc-week-num { font-weight: 700; color: var(--navy); }

  @media (max-width: 767px) {
    .tc-header { flex-direction: column; gap: 0.75rem; align-items: stretch; }
    .tc-hdr-right { justify-content: space-between; }

    /* 2-column grid on mobile — shows 2 cards per row, easy to scan */
    .tc-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }

    /* Single column on very small phones */
    @media (max-width: 420px) {
      .tc-grid { grid-template-columns: 1fr; }
    }

    /* Compact card on mobile */
    .tc-card { padding: 1rem; gap: 0.75rem; }
    .tc-name { font-size: 0.9375rem; }

    /* Tabs scroll */
    .tc-tabs { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .tc-tab { white-space: nowrap; }

    /* Footer: stack buttons */
    .tc-card-footer { flex-wrap: wrap; gap: 0.625rem; }
    .tc-card-actions .btn { flex: 1; justify-content: center; }
  }

  @media (max-width: 420px) {
    .tc-hdr-right { align-items: flex-start; flex-direction: column; gap: 0.5rem; }
    .tc-card-footer { align-items: stretch; }
    .tc-card-actions { width: 100%; }
  }
</style>
