---
import AdminDashboardLayout from '../../../layouts/AdminDashboardLayout.astro';

export function getStaticPaths() {
  return [
    { params: { id: 'BT' } },
    { params: { id: 'RK' } },
    { params: { id: 'SR' } },
    { params: { id: 'PS' } },
    { params: { id: 'NG' } },
    { params: { id: 'DS' } },
  ];
}

const { id } = Astro.params;

// Business: Admin technician profile shows one mock record per ID before the API exists.
// Technical: Explicit interfaces keep strict TypeScript happy without changing any markup.
interface TechScheduleItem {
  time: string;
  task: string;
  loc: string;
  reqId: string;
  status: string;
  state: string;
}

interface TechAssignedRequest {
  id: string;
  time: string;
  title: string;
  customer: string;
  status: string;
}

interface TechActivityEntry {
  action: string;
  desc: string;
  time: string;
}

interface TechnicianMock {
  name: string;
  subtitle: string;
  phone: string;
  techId: string;
  joined: string;
  status: string;
  statusLabel: string;
  lastActive: string;
  avatarColor: string;
  banner: { type: string; title: string; desc: string; time: string };
  kpi: {
    visits: string;
    visitsSub: string;
    job: string;
    jobSub: string;
    completed: string;
    completedSub: string;
    next: string;
    nextSub: string;
  };
  schedule: TechScheduleItem[];
  assignedRequests: TechAssignedRequest[];
  skills: string[];
  areas: string[];
  preference: string;
  workload: { label: string; desc: string; level: number };
  activity: TechActivityEntry[];
  notes: string;
}

// Mock data per technician
const techData: Record<string, TechnicianMock> = {
  'BT': {
    name: 'Bikash Thapa',
    subtitle: 'Appliance Repair Technician · Kathmandu Valley',
    phone: '9841 445 220',
    techId: 'TECH-006',
    joined: 'March 2026',
    status: 'online',
    statusLabel: 'Online · Available',
    lastActive: 'Active now',
    avatarColor: 'var(--teal)',
    banner: {
      type: 'available',
      title: 'Available now',
      desc: 'No active job. Ready to receive a new assignment.',
      time: 'Last active: Active now'
    },
    kpi: {
      visits: '3', visitsSub: '2 completed',
      job: 'None', jobSub: 'Available for assignment',
      completed: '11', completedSub: '1 awaiting update',
      next: 'Now', nextSub: 'Ready for assignment'
    },
    schedule: [
      { time: '9:00 AM', task: 'Washing machine inspection', loc: 'Baneshwor', reqId: '#SL-1042', status: 'Completed', state: 'done' },
      { time: '12:30 PM', task: 'Refrigerator repair', loc: 'Koteshwor', reqId: '#SL-1045', status: 'Confirmed', state: 'upcoming' },
      { time: '4:00 PM', task: 'Available slot', loc: 'Open for assignment', reqId: '', status: 'Available', state: 'empty' },
    ],
    assignedRequests: [
      { id: '#SL-1045', time: 'Tomorrow · Afternoon', title: 'TV turns off after a few minutes', customer: 'Rita Shrestha · Kalanki', status: 'Confirmed' },
      { id: '#SL-1039', time: 'Yesterday', title: 'Refrigerator making unusual noise', customer: 'Suresh KC · Koteshwor', status: 'Diagnosis submitted' }
    ],
    skills: ['Washing machines', 'Refrigerators', 'TVs', 'Basic AC diagnosis'],
    areas: ['Baneshwor', 'Koteshwor', 'Chabahil', 'Boudha'],
    preference: 'Full-time · Kathmandu Valley · Same-day visits',
    workload: { label: 'Light workload', desc: '3 visits scheduled today', level: 2 },
    activity: [
      { action: 'Marked online', desc: 'Available to receive assignments', time: 'Today · 8:45 AM' },
      { action: 'Completed washing machine inspection', desc: 'Request #SL-1042', time: 'Today · 10:20 AM' },
      { action: 'Admin assigned refrigerator repair', desc: 'Request #SL-1045', time: 'Yesterday · 4:15 PM' },
      { action: 'Submitted diagnosis', desc: 'Request #SL-1039', time: 'Yesterday · 2:40 PM' }
    ],
    notes: 'Strong with washing machines and refrigerators. Confirm spare-parts availability before assigning complex AC work.'
  },
  'RK': {
    name: 'Ramesh KC',
    subtitle: 'Senior AC Technician · Kathmandu Valley',
    phone: '9802 778 451',
    techId: 'TECH-002',
    joined: 'January 2025',
    status: 'on_visit',
    statusLabel: 'Online · On a visit',
    lastActive: 'Active 5 min ago',
    avatarColor: 'var(--navy)',
    banner: {
      type: 'busy',
      title: 'Currently on a visit',
      desc: 'Working on Request #SL-1044 in Chabahil.',
      time: 'Last active: 5 min ago'
    },
    kpi: {
      visits: '4', visitsSub: '1 completed',
      job: '#SL-1044', jobSub: 'AC diagnosis',
      completed: '8', completedSub: 'All updated',
      next: '3:30 PM', nextSub: 'After current visit'
    },
    schedule: [
      { time: '10:00 AM', task: 'AC Repair', loc: 'Maharajgunj', reqId: '#SL-1038', status: 'Completed', state: 'done' },
      { time: '1:00 PM', task: 'AC diagnosis', loc: 'Chabahil', reqId: '#SL-1044', status: 'In progress', state: 'current' },
      { time: '4:00 PM', task: 'AC Installation', loc: 'Baluwatar', reqId: '#SL-1049', status: 'Confirmed', state: 'upcoming' },
    ],
    assignedRequests: [
      { id: '#SL-1044', time: 'Today · 2-4 PM', title: 'Washing machine is leaking', customer: 'Prakash Adhikari · Chabahil', status: 'In progress' },
    ],
    skills: ['ACs', 'Washing machines'],
    areas: ['Maharajgunj', 'Baluwatar', 'Chabahil'],
    preference: 'Full-time · Morning preferred',
    workload: { label: 'Busy workload', desc: '4 visits scheduled today', level: 4 },
    activity: [
      { action: 'Arrived at location', desc: 'Request #SL-1044', time: 'Today · 1:15 PM' },
      { action: 'Started travel', desc: 'Request #SL-1044', time: 'Today · 12:45 PM' },
      { action: 'Completed AC Repair', desc: 'Request #SL-1038', time: 'Today · 11:30 AM' }
    ],
    notes: 'Expert in AC installations and complex diagnoses.'
  }
};

// Business: Unknown tech IDs must never silently show Bikash Thapa's record.
// Technical: Explicit demo fallback with warning flag (no silent alias).
const rawTech: TechnicianMock | undefined = techData[id ?? ""];
const isUnknownTech = !rawTech;
const tech: TechnicianMock = rawTech ?? techData["BT"] as TechnicianMock;
---

<AdminDashboardLayout title={`${tech.name} - Technicians - Sudhar Lab`} activeNav="technicians">

  <!-- BREADCRUMB -->
  <div class="breadcrumb-row">
    <a href="/admin/technicians" class="breadcrumb-link">Technicians</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
    <span class="breadcrumb-current">{tech.name}</span>
  </div>
  {isUnknownTech && (
    <p class="form-notice form-notice-info" role="status" style="display:block">Unknown demo technician — showing BT as a placeholder. Wire to GET /api/technicians/:id when the backend exists.</p>
  )}

  <div class="profile-layout">
    
    <!-- MAIN COLUMN -->
    <div class="main-col">
      
      <!-- HERO -->
      <div class="hero-card card">
        <div class="hero-content">
          <div class="hero-left">
            <div class="hero-avatar" style={`background-color: ${tech.avatarColor}`}>{id}</div>
            <div class="hero-info">
              <h1 class="hero-name">{tech.name}</h1>
              <div class="hero-sub">{tech.subtitle}</div>
              <div class="hero-meta-row">
                <div class="hero-meta">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  {tech.phone}
                </div>
                <div class="hero-meta">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                  {tech.techId}
                </div>
                <div class="hero-meta">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                  Joined: {tech.joined}
                </div>
              </div>
            </div>
          </div>

          <div class="hero-right">
            <div class="hero-status">
              {tech.status === 'online' && <span class="status-dot green"></span>}
              {tech.status === 'on_visit' && <span class="status-dot blue"></span>}
              <span class="status-text">{tech.statusLabel}</span>
            </div>
            <div class="hero-active-time">{tech.lastActive}</div>
            
            <div class="hero-actions">
              <button class="btn-primary" onclick="alert('Assign request')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                Assign a request
              </button>
              <button class="btn-secondary" onclick="alert('Contact')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                Contact technician
              </button>
              <button class="btn-more">
                More actions
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- BANNER -->
      <div class={`banner-card ${tech.banner.type}`}>
        <div class="banner-left">
          <div class="banner-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <div>
            <div class="banner-title">{tech.banner.title}</div>
            <div class="banner-desc">{tech.banner.desc}</div>
          </div>
        </div>
        <div class="banner-right">{tech.banner.time}</div>
      </div>

      <!-- KPIs -->
      <div class="kpi-grid">
        <div class="kpi-card card">
          <div class="kpi-top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" class="kpi-icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <div class="kpi-val">{tech.kpi.visits}</div>
          </div>
          <div class="kpi-label">Today's visits</div>
          <div class="kpi-sub">{tech.kpi.visitsSub}</div>
        </div>
        <div class="kpi-card card">
          <div class="kpi-top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" class="kpi-icon"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            <div class="kpi-val">{tech.kpi.job}</div>
          </div>
          <div class="kpi-label">Current job</div>
          <div class="kpi-sub teal">{tech.kpi.jobSub}</div>
        </div>
        <div class="kpi-card card">
          <div class="kpi-top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" class="kpi-icon"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <div class="kpi-val">{tech.kpi.completed}</div>
          </div>
          <div class="kpi-label">Completed this week</div>
          <div class="kpi-sub">{tech.kpi.completedSub}</div>
        </div>
        <div class="kpi-card card">
          <div class="kpi-top">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" class="kpi-icon"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <div class="kpi-val">{tech.kpi.next}</div>
          </div>
          <div class="kpi-label">Next available</div>
          <div class="kpi-sub">{tech.kpi.nextSub}</div>
        </div>
      </div>

      <!-- TODAY'S SCHEDULE -->
      <div class="section-card card">
        <div class="section-header">
          <h2 class="section-title">Today's schedule</h2>
          <div class="section-sub">Visits and open time for today</div>
        </div>

        <div class="schedule-list">
          {tech.schedule.map((item, idx) => (
            <div class="sched-row">
              <div class="sched-left">
                <div class="sched-node-wrap">
                  <div class={`sched-node ${item.state}`}>
                    {item.state === 'done' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><polyline points="20 6 9 17 4 12"></polyline></svg>}
                    {item.state === 'current' && <div class="node-inner"></div>}
                  </div>
                  {idx < tech.schedule.length - 1 && <div class={`sched-line ${item.state === 'done' ? 'done' : ''}`}></div>}
                </div>
                <div class="sched-time">{item.time}</div>
              </div>
              <div class="sched-body">
                <div>
                  <div class={`sched-task-title ${item.state === 'empty' ? 'empty' : ''}`}>{item.task}</div>
                  <div class="sched-meta-list">
                    {item.loc && (
                      <span class="sched-meta-item">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        {item.loc}
                      </span>
                    )}
                    {item.reqId && (
                      <span class="sched-meta-item req-link">{item.reqId}</span>
                    )}
                  </div>
                </div>
                <div class="sched-actions">
                  <span class={`status-badge badge-${item.status.toLowerCase().replace(' ', '-')}`}>{item.status}</span>
                  {item.reqId && (
                    <button class="btn-link" onclick={`window.location.href='/admin/requests/${item.reqId.replace('#','')}'`}>Open request</button>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- ASSIGNED REQUESTS -->
      <div class="section-card card">
        <div class="section-header">
          <h2 class="section-title">Assigned requests</h2>
          <div class="section-sub">Recent work assigned to this technician</div>
        </div>

        <div class="assigned-list">
          {tech.assignedRequests.map(req => (
            <div class="assigned-row">
              <div class="assigned-left">
                <div class="assigned-id">{req.id}</div>
                <div class="assigned-time">{req.time}</div>
              </div>
              <div class="assigned-main">
                <div class="assigned-title">{req.title}</div>
                <div class="assigned-customer">{req.customer}</div>
              </div>
              <div class="assigned-right">
                <span class={`status-badge badge-${req.status.toLowerCase().replace(' ', '-')}`}>{req.status}</span>
                <button class="btn-link" onclick={`window.location.href='/admin/requests/${req.id.replace('#','')}'`}>Open request</button>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div><!-- /main-col -->

    <!-- SIDEBAR COLUMN -->
    <div class="side-col">
      
      <!-- TECH INFO CARD -->
      <div class="side-card card">
        <h3 class="side-card-title">Technician information</h3>
        
        <div class="info-group">
          <div class="info-label">Appliance skills</div>
          <div class="chip-list">
            {tech.skills.map(skill => <span class="chip">{skill}</span>)}
          </div>
        </div>

        <div class="info-group">
          <div class="info-label">Service area</div>
          <div class="chip-list">
            {tech.areas.map(area => (
              <span class="chip">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                {area}
              </span>
            ))}
          </div>
        </div>

        <div class="info-group">
          <div class="info-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            Availability preference
          </div>
          <div class="info-text">{tech.preference}</div>
        </div>
      </div>

      <!-- WORKLOAD CARD -->
      <div class="side-card card">
        <h3 class="side-card-title with-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Workload
        </h3>
        <div class="workload-label">{tech.workload.label}</div>
        <div class="workload-desc">{tech.workload.desc}</div>
        <div class="workload-bar">
          {Array.from({ length: 5 }).map((_: unknown, i: number) => (
            <div class={`workload-segment ${i < tech.workload.level ? 'filled' : ''}`}></div>
          ))}
        </div>
      </div>

      <!-- RECENT ACTIVITY CARD -->
      <div class="side-card card">
        <h3 class="side-card-title with-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          Recent activity
        </h3>
        <div class="activity-timeline">
          {tech.activity.map((act, i) => (
            <div class="act-row">
              <div class="act-node-wrap">
                <div class={`act-node ${i === 0 ? 'solid' : ''}`}></div>
                {i < tech.activity.length - 1 && <div class="act-line"></div>}
              </div>
              <div class="act-body">
                <div class="act-title">{act.action}</div>
                <div class="act-desc">{act.desc}</div>
                <div class="act-time">{act.time}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- INTERNAL NOTES -->
      <div class="side-card card internal-notes-card">
        <h3 class="side-card-title with-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Internal notes
        </h3>
        <div class="notes-sub">Visible only to Sudhar Lab admins</div>
        <p class="notes-text">{tech.notes}</p>
      </div>

    </div>

  </div>

</AdminDashboardLayout>

<style is:global>
  /* BREADCRUMB */
  .breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--graphite-mid);
  }
  .breadcrumb-row svg { color: var(--graphite-lt); }
  .breadcrumb-link {
    color: var(--graphite-mid);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s;
  }
  .breadcrumb-link:hover { color: var(--teal); }
  .breadcrumb-current { color: var(--navy); font-weight: 600; }

  /* LAYOUT */
  .profile-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .main-col { display: flex; flex-direction: column; gap: 1.5rem; }
  .side-col { display: flex; flex-direction: column; gap: 1.5rem; }

  /* CARD BASE */
  .card {
    background: var(--pure-white);
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  /* HERO */
  .hero-card { padding: 1.5rem 2rem; }
  .hero-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .hero-left {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  .hero-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    align-items: center;
