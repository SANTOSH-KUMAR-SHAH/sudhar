---
import AdminDashboardLayout from '../../../layouts/AdminDashboardLayout.astro';
import StatusBadge from '../../../components/common/StatusBadge.astro';
import {
  DEMO_REQUESTS,
  REQUEST_STEPS,
  getDemoRequestRecord,
  getDemoTechnician,
  getRequestById,
} from '../../../lib/demo-data';

// Business: One service case, shown end to end — this page never keeps a second copy of it.
// Technical: getStaticPaths derives from the demo store, so every built path has a real
// record and unknown URLs hit the 404 page instead of a placeholder case.
export function getStaticPaths() {
  return DEMO_REQUESTS.map((r) => ({ params: { id: r.id } }));
}

const { id } = Astro.params;
const req = getRequestById(id ?? '');
const record = getDemoRequestRecord(id ?? '');
if (!req || !record) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Business: The technician shown on the case is joined from the assignment, not retyped.
const assignedTechnician = record.technicianId ? getDemoTechnician(record.technicianId) : undefined;
// Business: Next-step buttons do real things when the target exists (call, assign, view tech).
// Technical: tel:/in-app hrefs are resolved server-side; anything else renders a disabled button.
const nextActionHref =
  req.nextAction === 'Call and confirm' || req.nextAction === 'Follow up with customer'
    ? `tel:${req.phone.replace(/\s/g, '')}`
    : req.nextAction === 'Assign technician'
      ? '/admin/technicians'
      : req.nextAction === 'View technician' && assignedTechnician
        ? `/admin/technicians/${assignedTechnician.id}`
        : null;

---

<AdminDashboardLayout title={`${req.title} - Sudhar Lab Admin`} activeNav="requests">

  <!-- BREADCRUMB HEADER -->
  <div class="breadcrumb-row">
    <a href="/admin/requests" class="breadcrumb-link">Requests</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="9 18 15 12 9 6"></polyline></svg>
    <span class="breadcrumb-current tnum">#{id}</span>
  </div>

  <div class="request-layout">

    <!-- MAIN COLUMN -->
    <div class="main-col">

      <!-- HERO -->
      <div class="req-hero">
        <div class="hero-left">
          <div class="hero-top">
            <h1 class="req-title">{req.title}</h1>
            <StatusBadge status={req.status} />
          </div>
          <div class="hero-meta">
            <span class="meta-chip">{req.customerName}</span>
            <span class="dot-sep">·</span>
            <span class="meta-chip">{req.address.split(',')[0]}</span>
            <span class="dot-sep">·</span>
            <span class="meta-chip">Received {req.receivedAgo}</span>
          </div>
        </div>
        <div class="hero-actions">
          <a class="btn-call" href={`tel:${req.phone.replace(/\s/g, '')}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Call customer
          </a>
          <div class="more-actions-wrap">
            <button class="btn-more" onclick="this.nextElementSibling.classList.toggle('open')">
              More actions
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="more-dropdown">
              <button class="dropdown-item" type="button" disabled title="Available after backend API">Mark as cancelled</button>
              <button class="dropdown-item" type="button" disabled title="Available after backend API">Reassign technician</button>
              <button class="dropdown-item danger" type="button" disabled title="Available after backend API">Delete request</button>
            </div>
          </div>
        </div>
      </div>

      <!-- STATUS PROGRESS TRACKER -->
      <div class="progress-tracker card">
        {REQUEST_STEPS.map((step, i) => (
          <div class={`progress-step ${i + 1 < req.currentStep ? 'done' : ''} ${i + 1 === req.currentStep ? 'active' : ''}`}>
            <div class="step-circle">
              {i + 1 < req.currentStep ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"></polyline></svg>
              ) : (
                <span>{i + 1}</span>
              )}
            </div>
            {i < REQUEST_STEPS.length - 1 && <div class={`step-line ${i + 1 < req.currentStep ? 'done' : ''}`}></div>}
            <div class="step-label">{step}</div>
          </div>
        ))}
      </div>

      <!-- REQUEST DETAILS -->
      <div class="card section-card">
        <h2 class="section-title">Request details</h2>
        <div class="details-grid">
          <div class="details-left">
            <div class="detail-row">
              <div class="detail-label">Appliance type</div>
              <div class="detail-value">{req.applianceType}</div>
            </div>
            <div class="detail-row">
              <div class="detail-label">Brand</div>
              <div class="detail-value">{req.brand}</div>
            </div>
            <div class="detail-row">
              <div class="detail-label">Model</div>
              <div class="detail-value">{req.model}</div>
            </div>
            <div class="detail-row">
              <div class="detail-label">Problem</div>
              <div class="detail-value">{req.problem}</div>
            </div>
            <div class="detail-row">
              <div class="detail-label">Preferred visit</div>
              <div class="detail-value">{req.preferredVisit}</div>
            </div>
            <div class="detail-row">
              <div class="detail-label">Submitted</div>
              <div class="detail-value">{req.submitted}</div>
            </div>
            <div class="detail-row">
              <div class="detail-label">Address</div>
              <div class="detail-value">{req.address}</div>
            </div>
            <div class="detail-row">
              <div class="detail-label">Extra notes</div>
              <div class="detail-value">{req.extraNotes}</div>
            </div>
          </div>
          <div class="details-right">
            <div class="detail-label">Problem description</div>
            <p class="problem-desc">{req.problemDesc}</p>

            {req.photoCount > 0 && (
              <div class="attachments-section">
                <div class="detail-label">Attachments</div>
                <div class="photo-grid">
                  {Array.from({length: req.photoCount}).map(() => (
                    <div class="photo-thumb-lg"></div>
                  ))}
                </div>
                <span class="view-attach-link is-disabled" aria-disabled="true" title="Photo viewer arrives with private Storage + signed URLs">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
                  View attachments
                </span>
                <div class="photo-count-label">{req.photoCount} photos</div>
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- ACTIVITY TIMELINE -->
      <div class="card section-card">
        <h2 class="section-title">Activity timeline</h2>
        <div class="activity-timeline">
          {req.timeline.map((entry) => (
            <div class={`timeline-event ${entry.done ? 'done' : ''} ${entry.current ? 'current' : ''}`}>
              <div class="tl-icon">
                {entry.done && !entry.current && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><polyline points="20 6 9 17 4 12"></polyline></svg>
                )}
                {entry.current && (
                  <div class="tl-dot-inner"></div>
                )}
              </div>
              <div class="tl-body">
                <div class="tl-title-row">
                  <span class="tl-title">{entry.title}</span>
                  {entry.current && <span class="next-action-badge">Next action</span>}
                </div>
                <div class="tl-desc">{entry.desc}</div>
                {entry.time && <div class="tl-time">{entry.time}</div>}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- DIAGNOSIS SECTION -->
      <div class="card section-card">
        <h2 class="section-title">Diagnosis and repair</h2>
        {record.diagnosis ? (
          <div class="details-grid">
            <div class="details-left">
              <div class="detail-row">
                <div class="detail-label">Fault identified</div>
                <div class="detail-value">{record.diagnosis.fault}</div>
              </div>
              <div class="detail-row">
                <div class="detail-label">Proposed repair</div>
                <div class="detail-value">{record.diagnosis.proposal}</div>
              </div>
            </div>
            <div class="details-right">
              <div class="detail-row">
                <div class="detail-label">Submitted by</div>
                <div class="detail-value">{assignedTechnician?.name ?? 'Technician'} · {record.diagnosis.submittedAt}</div>
              </div>
              <div class="detail-row">
                <div class="detail-label">Approval</div>
                <div class="detail-value">{req.status === 'PRICE_APPROVAL' ? 'Waiting for customer approval' : 'Customer approved — repair proceeding'}</div>
              </div>
            </div>
          </div>
        ) : (
          <div class="diagnosis-empty">
            <div class="diagnosis-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="32" height="32"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
            </div>
            <div>
              <div class="diagnosis-title">Diagnosis not submitted yet</div>
              <div class="diagnosis-desc">The technician's findings and repair price will appear here after the visit.</div>
              <div class="diagnosis-locked">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                Available after technician visit
              </div>
            </div>
          </div>
        )}
      </div>

    </div><!-- /main-col -->

    <!-- RIGHT SIDEBAR -->
    <aside class="sidebar-col">

      <!-- CUSTOMER CARD -->
      <div class="side-card">
        <h3 class="side-card-title">Customer</h3>
        <div class="side-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span class="side-value">{req.customerName}</span>
        </div>
        <div class="side-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span class="side-value">{req.phone}</span>
        </div>
        <div class="side-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          <span class="side-value">{req.address}</span>
        </div>
        <div class="side-field">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span class="side-label-inline">Preferred visit:</span>
          <span class="side-value">{req.preferredVisit}</span>
        </div>
        <a class="btn-side-call" href={`tel:${req.phone.replace(/\s/g, '')}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Call customer
        </a>
        <a class="side-link" href={`/admin/customers/${record.customerId}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          Open customer record
        </a>
      </div>

      <!-- APPLIANCE CARD -->
      <div class="side-card">
        <h3 class="side-card-title">Appliance</h3>
        <div class="side-appliance">
          <div class="side-appliance-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28"><rect x="2" y="2" width="20" height="20" rx="2"/><circle cx="12" cy="13" r="4"/><path d="M5 5h2"/></svg>
          </div>
          <div>
            <div class="side-value">{req.applianceType}</div>
            <div class="side-meta">{req.brand}</div>
            <div class="side-meta">{req.model === 'Not provided' ? 'Model not provided' : `Model ${req.model}`}</div>
            <div class="side-meta">Problem: {req.problem}</div>
          </div>
        </div>
      </div>

      <!-- NEXT STEP CARD -->
      <div class="side-card next-step-card">
        <div class="next-step-header">
          <div class="next-step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <h3 class="side-card-title" style="margin-bottom:0">Next step</h3>
        </div>
        <p class="next-step-desc">{req.nextStep}</p>
        {nextActionHref ? (
          <a class="btn-next-action" href={nextActionHref}>
            {nextActionHref.startsWith('tel:') ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.35 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.13 6.13l.95-.88a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            )}
            {req.nextAction}
          </a>
        ) : (
          <button class="btn-next-action" type="button" disabled title="Available after backend API">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12"></polyline></svg>
            {req.nextAction}
          </button>
        )}
        <span class="side-cancel-link is-disabled" aria-disabled="true" title="Cancellation follows Order-Confirmed rules — wire to the API when the backend exists">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
          Mark as cancelled
        </span>
      </div>

      <!-- INTERNAL NOTE -->
      {req.internalNote && (
        <div class="side-card internal-note-card">
          <div class="internal-note-header">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span class="internal-note-label">Internal note</span>
          </div>
          <div class="internal-note-sub">Only visible to Sudhar Lab admins</div>
          <p class="internal-note-text">{req.internalNote}</p>
          <span class="side-link is-disabled" aria-disabled="true" title="Note editing arrives with the backend API">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Edit note
          </span>
        </div>
      )}

      <!-- METADATA -->
      <div class="side-card metadata-card">
        <div class="meta-row"><span class="meta-key">Request ID</span><span class="meta-val">#{id}</span></div>
        <div class="meta-row"><span class="meta-key">Created</span><span class="meta-val">{req.createdAt}</span></div>
        <div class="meta-row"><span class="meta-key">Last updated</span><span class="meta-val">{req.lastUpdated}</span></div>
        <div class="meta-row"><span class="meta-key">Source</span><span class="meta-val">{req.source}</span></div>
      </div>

    </aside><!-- /sidebar-col -->

  </div>

</AdminDashboardLayout>

<style is:global>
  /* LAYOUT */
  .request-layout {
    display: grid;
    /* Technical: minmax(0,1fr) — content can never widen the main track past the viewport. */
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .main-col { display: flex; flex-direction: column; gap: 1.25rem; }
  .sidebar-col { display: flex; flex-direction: column; gap: 1rem; }

  /* HERO */
  .req-hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-top {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .req-title {
    font-family: var(--font-h);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: -0.02em;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--graphite-mid);
    flex-wrap: wrap;
  }
  .dot-sep { color: var(--graphite-lt); }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-shrink: 0;
  }
  .btn-call {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--teal);
    color: var(--pure-white);
    text-decoration: none;
    border: none;
    padding: 0.625rem 1.125rem;
    border-radius: 6px;
    font-family: var(--font-b);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.2s;
  }
  .btn-call:hover { background-color: var(--teal-hover); }

  .more-actions-wrap { position: relative; }
  .btn-more {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    background: var(--pure-white);
    border: 1px solid var(--border);
    padding: 0.625rem 1rem;
    border-radius: 6px;
    font-family: var(--font-b);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--navy);
    cursor: pointer;
    white-space: nowrap;
  }
  .more-dropdown {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    background: var(--pure-white);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    min-width: 180px;
    z-index: 50;
    overflow: hidden;
  }
  .more-dropdown.open { display: block; }
  .dropdown-item {
    display: block;
    width: 100%;
    padding: 0.75rem 1rem;
    background: none;
    border: none;
    text-align: left;
    font-family: var(--font-b);
    font-size: 0.875rem;
    color: var(--navy);
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .dropdown-item:hover { background-color: var(--bg-off); }
  .dropdown-item.danger { color: #EF4444; }

  /* PROGRESS TRACKER */
  .progress-tracker {
    display: flex;
    align-items: flex-start;
    padding: 1.25rem 1.5rem 1.75rem;
    gap: 0;
    overflow-x: auto;
  }
  .progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    min-width: 80px;
    position: relative;
  }
  .step-circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--pure-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--graphite-lt);
    z-index: 2;
    flex-shrink: 0;
  }
  .progress-step.done .step-circle {
    background: var(--teal);
    border-color: var(--teal);
    color: var(--pure-white);
  }
