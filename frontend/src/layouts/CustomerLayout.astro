    }

    .faq-a-inner {
      padding: 0 20px 20px;
      font-size: 13px;
      color: var(--graphite-mid);
      line-height: 1.6;
    }

    /* FAQ Banner */
    .faq-banner {
      margin-top: 64px;
      background: #eef7f8;
      border-radius: 12px;
      padding: 40px 48px;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

    .faq-banner-content {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 32px;
      width: 100%;
    }

    .faq-banner-icon {
      width: 64px;
      height: 64px;
    }

    .faq-banner-text h3 {
      font-family: var(--font-h);
      font-size: 20px;
      font-weight: 800;
      color: var(--navy-deep);
      margin-bottom: 4px;
    }

    .faq-banner-text p {
      font-size: 14.5px;
      color: var(--graphite-mid);
    }

    .faq-banner-btns {
      margin-left: auto;
      margin-right: 250px;
      /* Space for image */
      position: relative;
      z-index: 2;
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .faq-banner-img {
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 400px;
      z-index: 1;
      overflow: hidden;
    }

    .faq-banner-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      clip-path: ellipse(70% 100% at 70% 50%);
