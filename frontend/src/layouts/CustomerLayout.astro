    }

    .ft-watermark {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 450px;
      opacity: 0.2;
      pointer-events: none;
      z-index: 1;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .footer-bottom-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
