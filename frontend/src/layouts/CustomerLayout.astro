    }

    .ft-bottom-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .ft-line-decor {
      width: 48px;
      height: 1px;
      background: var(--teal);
    }

    .ft-bottom-left .ft-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
    }

    .ft-bottom-text {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: rgba(255, 255, 255, 0.7);
    }

    .ft-copyright {
      font-size: 12px;
      line-height: 1.6;
