---
import '../styles/tailwind.css';
---
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sudhar Lab â€” Home Appliance Repair & Maintenance in Kathmandu</title>
  <meta name="description"
    content="Sudhar Lab provides trusted home appliance repair and maintenance for TVs, washing machines, ACs, and refrigerators in Kathmandu. Diagnosis first. Price explained. Repair only with your approval." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=Caveat:wght@600&display=swap"
    rel="stylesheet" />

  <style is:global>
    /* ================================================
       DESIGN TOKENS
    ================================================ */
    :root {
      --navy: #10263D;
      --navy-deep: #0A1E30;
      --teal: #0C7C82;
      --teal-hover: #0E9198;
      --gold: #E8A324;
      --white: #F7F6F2;
      --graphite: #2B2E31;
      --graphite-mid: #4A4E52;
      --graphite-lt: #7C8186;
      --border: #E0DDD7;
      --bg-off: #EFEDE8;

      --font-h: 'Outfit', sans-serif;
      --font-b: 'Inter', sans-serif;

      --ease: cubic-bezier(0.4, 0, 0.2, 1);
      --ease-out: cubic-bezier(0, 0, 0.2, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

      --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.07);
      --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.10);
      --shadow-lg: 0 24px 56px rgba(0, 0, 0, 0.15);
      --shadow-xl: 0 40px 80px rgba(0, 0, 0, 0.20);
    }



    /* ================================================
       CUSTOM SCROLLBAR
    ================================================ */
    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #0A1E30;
    }

    ::-webkit-scrollbar-thumb {
      background: var(--teal);
      border-radius: 3px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--teal-hover);
    }

    /* ================================================
       RESET
    ================================================ */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: var(--font-b);
      color: var(--graphite);
      background: var(--white);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }


    img {
      display: block;
      max-width: 100%;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    ul,
    ol {
      list-style: none;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
      font-family: inherit;
    }

    input,
    textarea,
    select {
      font-family: inherit;
    }

    ::selection {
      background: rgba(12, 124, 130, 0.18);
    }

    /* ================================================
       UTILITY
    ================================================ */
    .eyebrow {
      display: inline-block;
      font-family: var(--font-h);
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.20em;
      text-transform: uppercase;
      color: var(--teal);
    }

    .eyebrow--muted {
      color: rgba(247, 246, 242, 0.50);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 48px;
    }

    /* ================================================
       BUTTONS
    ================================================ */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-h);
      font-size: 14.5px;
      font-weight: 700;
      letter-spacing: 0.01em;
      padding: 14px 28px;
      border-radius: 40px;
      transition: transform 0.22s var(--ease), box-shadow 0.22s var(--ease), background 0.22s, border-color 0.22s, color 0.22s;
      white-space: nowrap;
      line-height: 1;
    }

    .btn:active {
      transform: scale(0.98) !important;
    }

    .btn-teal {
      background: var(--teal);
      color: var(--white);
    }

    .btn-teal:hover {
      background: var(--teal-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(12, 124, 130, 0.38);
    }

    .btn-ghost-white {
      background: transparent;
      color: var(--white);
      border: 1.5px solid rgba(247, 246, 242, 0.35);
    }

    .btn-ghost-white:hover {
      background: rgba(247, 246, 242, 0.08);
      border-color: rgba(247, 246, 242, 0.65);
    }

    .btn-ghost-navy {
      background: transparent;
      color: var(--navy);
      border: 1.5px solid var(--navy);
    }

    .btn-ghost-navy:hover {
      background: var(--navy);
      color: var(--white);
    }

    .btn-ghost-teal {
      background: transparent;
      color: var(--teal);
      border: 1.5px solid var(--teal);
    }

    .btn-ghost-teal:hover {
      background: var(--teal);
      color: var(--white);
    }

    /* ================================================
       NAVIGATION
    ================================================ */
    #nav {
      position: fixed;
      top: 24px;
      left: 50%;
      transform: translateX(-50%);
      width: 90%;
      max-width: 1200px;
      z-index: 900;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 32px;
      background: transparent;
      border-radius: 9999px;
      transition: padding 0.4s cubic-bezier(0.32, 0.72, 0, 1), background 0.4s cubic-bezier(0.32, 0.72, 0, 1), backdrop-filter 0.4s, box-shadow 0.4s, top 0.4s cubic-bezier(0.32, 0.72, 0, 1);
    }

    #nav.stuck {
      top: 16px;
      padding: 12px 28px;
      background: rgba(247, 246, 242, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08), inset 0 1px 1px rgba(255, 255, 255, 0.6);
      border: 1px solid rgba(0, 0, 0, 0.04);
    }

    .nav-logo {
      display: flex;
      align-items: center;
      text-decoration: none;
    }

    .nav-logo img {
      /* Large enough for the wordmark to be easily readable */
      height: 48px;
      width: auto;
      max-width: 200px;
      display: block;
      opacity: 0.95;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    /* Hide old text-based logo elements if they still render */
    .nav-logo-name,
    .nav-logo-sub {
      display: none;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .nav-links a {
      font-family: var(--font-h);
      font-size: 13.5px;
      font-weight: 600;
      color: rgba(247, 246, 242, 0.85); /* white */
      transition: color 0.18s;
      letter-spacing: 0.01em;
    }

    .nav-links a:hover {
      color: var(--white);
    }

    #nav.stuck .nav-links a {
      color: var(--navy);
    }

    #nav.stuck .nav-links a:hover {
      color: var(--teal);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    /* The "Double-Bezel" Outer Shell */
    .double-bezel {
      display: flex;
      align-items: center;
      padding: 4px;
      background: rgba(255, 255, 255, 0.08); /* transparent state shell */
      border-radius: 9999px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      transition: all 0.5s cubic-bezier(0.32, 0.72, 0, 1);
      cursor: pointer;
    }

    .double-bezel:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: rgba(255, 255, 255, 0.25);
    }

    .double-bezel:active {
      transform: scale(0.96); /* Magnetic press physics */
    }

    /* Scrolled state outer shell */
    #nav.stuck .double-bezel {
      background: rgba(0, 0, 0, 0.03);
      border-color: rgba(0, 0, 0, 0.06);
    }
    
    #nav.stuck .double-bezel:hover {
      background: rgba(0, 0, 0, 0.06);
      border-color: rgba(0, 0, 0, 0.1);
    }

    /* The Inner Core CTA button inside the bezel */
    .nav-cta-btn {
      font-size: 13px;
      padding: 10px 20px;
      margin: 0; /* Override any global margins */
      /* Inner Core Highlight */
      box-shadow: inset 0 1px 1px rgba(255,255,255,0.25);
    }

    /* The Inner Core Call button inside the bezel */
    .nav-call {
      font-family: var(--font-h);
      font-size: 13.5px;
      font-weight: 700;
      color: var(--white);
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 10px 18px;
      border-radius: 9999px;
      background: transparent;
      transition: color 0.18s;
    }

    #nav.stuck .nav-call {
      color: var(--navy);
    }

    /* ================================================
       HERO  â€”  Full-bleed editorial
    ================================================ */
    .hero {
      position: relative;
      height: 100vh;
      min-height: 600px;
      max-height: 1000px;
      display: flex;
      align-items: flex-end;
      /* text sits at the bottom */
      overflow: hidden;
      background: var(--navy-deep);
      box-shadow: inset 0px -12px 24px rgba(0, 0, 0, 0.4); /* Micro-depth transition to light section below */
    }

    /* Full-bleed background image */
    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .hero-bg img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
    }

    /* â”€â”€ HERO OVERLAY SYSTEM â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
       OLD: One flat rgba(8,18,28, 0.92) scrim that killed the photo entirely.
       NEW: 3-layer cinematic system used by premium brands (Linear, Stripe etc.)
         Layer A: Directional vignette â€” darkens edges, leaves center breathable.
         Layer B: Teal ambient glow â€” brand-colored depth source on the right.
         Layer C: Film grain â€” gives photo a physical, high-end, tactile quality.
    â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */

    /* Layer A: Directional vignette â€” REPLACES the old flat scrim.
       Left side darkens for text legibility.
       Bottom darkens to anchor the composition.
       Center-right stays bright so the photo reads as REAL, not blocked. */
    .hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 2;
      background:
        /* Left text zone â€” strong but not wall-like */
        linear-gradient(100deg,
          rgba(6, 14, 22, 0.88) 0%,
          rgba(6, 14, 22, 0.65) 28%,
          rgba(6, 14, 22, 0.18) 52%,
          transparent 68%),
        /* Bottom anchor â€” pulls composition down, very natural */
        linear-gradient(to top,
          rgba(6, 14, 22, 0.72) 0%,
          rgba(6, 14, 22, 0.25) 22%,
          transparent 48%),
        /* Top feather â€” very subtle, keeps sky from blowing out */
        linear-gradient(to bottom,
          rgba(6, 14, 22, 0.30) 0%,
          transparent 20%);
    }

    /* Layer B: Brand-colored ambient glow on the right (depth source)
       Subtle teal radial that makes the photo feel 3-dimensional and on-brand. */
    .hero-bg::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        radial-gradient(ellipse 55% 70% at 80% 45%,
          rgba(12, 124, 130, 0.12) 0%,
          transparent 100%);
    }

    /* fallback when no image */
    .hero-bg-fallback {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, var(--navy-deep) 0%, var(--navy) 100%);
    }

    /* Text content */
    .hero-inner {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 140px 56px 72px;
    }

    .hero-h1 {
      font-family: var(--font-h);
      font-size: clamp(48px, 7vw, 88px);
      font-weight: 900;
      color: var(--white);
      line-height: 1.03;
      letter-spacing: -0.03em;
      margin-bottom: 36px;
      max-width: 600px;
    }

    .hero-h1 em {
      font-style: normal;
      color: var(--teal);
    }

    .hero-mobile-break {
      display: none;
    }

    .hero-btns {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .hero-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0;
      font-family: var(--font-h);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: var(--teal);
      color: var(--white);
      padding: 16px 32px;
      border-radius: 4px;
      transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    }

    .hero-btn-primary:hover {
      background: var(--teal-hover);
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(12, 124, 130, 0.40);
    }

    .hero-btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0;
      font-family: var(--font-h);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: transparent;
      color: var(--white);
      padding: 15px 32px;
      border-radius: 4px;
      border: 1.5px solid rgba(247, 246, 242, 0.45);
      transition: background 0.2s, border-color 0.2s;
    }

    .hero-btn-secondary:hover {
      background: rgba(255, 255, 255, 0.10);
      border-color: rgba(247, 246, 242, 0.80);
    }

    /* ================================================
       HERO RIBBON & LANDSCAPE
    ================================================ */
    .hero-ribbon {
      background: #081521;
      border-top: 1px solid rgba(255, 255, 255, 0.04);
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      position: relative;
      z-index: 10;
    }

    .ribbon-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 100px;
    }

    .ribbon-left {
      display: flex;
      align-items: center;
      gap: 36px;
      flex: 1;
    }

    .ribbon-feature {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .ribbon-feature-icon {
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
    }

    .ribbon-feature-text {
      font-size: 11.5px;
      font-weight: 500;
      color: rgba(247, 246, 242, 0.85);
      line-height: 1.3;
      max-width: 100px;
    }

    .ribbon-divider {
      width: 1px;
      height: 60px;
      background: rgba(255, 255, 255, 0.1);
      margin: 0 40px;
    }

    .ribbon-right {
      display: flex;
      align-items: center;
      gap: 40px;
    }

    .ribbon-services-label {
      font-family: var(--font-h);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.15em;
      color: rgba(247, 246, 242, 0.5);
      text-transform: uppercase;
      align-self: flex-start;
      margin-top: 6px;
    }

    .ribbon-service-icons {
      display: flex;
      gap: 36px;
    }

    .ribbon-service-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      color: rgba(247, 246, 242, 0.6);
      transition: color 0.2s;
      cursor: pointer;
    }

    .ribbon-service-item:hover {
      color: var(--white);
    }

    .ribbon-service-item svg {
      width: 24px;
      height: 24px;
      stroke-width: 1.2;
    }

    .ribbon-service-item span {
      font-size: 10px;
      font-weight: 500;
    }

    .hero-landscape {
      background: var(--bg-off);
      padding: 60px 0;
      min-height: 320px;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

    .landscape-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 48px;
      position: relative;
      z-index: 2;
    }

    .landscape-mountains {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      top: 0;
      background: url('/hero2.png') no-repeat right bottom;
      background-size: cover;
      pointer-events: none;
      z-index: 1;
    }

    /* ================================================
       SECTION SHELLS
    ================================================ */
    .sec {
      padding: 100px 0;
    }

    .sec--white {
      background: var(--white);
    }

    .sec--off {
      background: var(--bg-off);
    }

    .sec--navy {
      background: var(--navy);
    }

    .sec--deep {
      background: var(--navy-deep);
    }

    .sec-head {
      margin-bottom: 40px;
    }

    .sec-head .eyebrow {
      margin-bottom: 14px;
    }

    .sec-head h2 {
      font-family: var(--font-h);
      font-size: clamp(28px, 3.2vw, 42px);
      font-weight: 800;
      color: var(--navy);
      letter-spacing: -0.022em;
      line-height: 1.15;
      margin-bottom: 14px;
    }

    .sec-head h2.light {
      color: var(--white);
    }

    .sec-head p {
      font-size: 16px;
      color: var(--graphite-mid);
      line-height: 1.68;
      max-width: 540px;
    }

    .sec-head p.light {
      color: rgba(247, 246, 242, 0.60);
    }

    .sec-head--center {
      text-align: center;
    }

    .sec-head--center p {
      margin: 0 auto;
    }

    /* ================================================
       SERVICES SECTION
    ================================================ */
    .services-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 32px;
    }

    .svc-card {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      cursor: pointer;
      background: var(--white);
      border: 1.5px solid rgba(0, 0, 0, 0.05);
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04), 0 0 0 0 rgba(12, 124, 130, 0);
      transition: transform 0.30s var(--ease), box-shadow 0.30s var(--ease), border-color 0.30s;
      display: flex;
      outline: none;
      min-height: 200px;
    }

    /* Shimmer sweep on hover */
    .svc-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.25) 50%, transparent 70%);
      transform: translateX(-100%);
      transition: transform 0.55s ease;
      pointer-events: none;
    }

    .svc-card:hover::after {
      transform: translateX(100%);
    }

    .svc-card:hover,
    .svc-card:focus-visible {
      border-color: rgba(12, 124, 130, 0.5);
      background: linear-gradient(145deg, #fff 60%, rgba(12, 124, 130, 0.04));
      box-shadow: 0 20px 48px rgba(12, 124, 130, 0.12), 0 0 0 1px rgba(12, 124, 130, 0.15);
      transform: translateY(-6px);
    }

    .svc-content {
      flex: 1;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .svc-teal-dash {
      width: 24px;
      height: 2.5px;
      background: var(--teal);
      margin-bottom: 16px;
    }

    .svc-title {
      font-family: var(--font-h);
      font-size: 26px;
      font-weight: 800;
      color: var(--navy-deep);
      margin-bottom: 12px;
      letter-spacing: -0.01em;
    }

    .svc-hint {
      font-size: 14px;
      color: var(--graphite-mid);
      line-height: 1.5;
      margin-bottom: 24px;
      max-width: 200px;
    }

    /* Business: Service card hover glow + shimmer is the primary delight cue. */
    /* Technical: Single .svc-action definition lives below; hover glow lives on .svc-card:hover. */
    .svc-img {
      width: 42%;
      position: relative;
      overflow: hidden;
    }

    .svc-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s var(--ease);
    }

    .svc-card:hover .svc-img img {
      transform: scale(1.05);
    }

    /* Business: Unsure strip uses the tinted card style defined below. */
    /* Technical: Removed duplicate container so only one .services-unsure rule wins. */
    .services-unsure-label {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: var(--font-h);
      font-size: 15px;
      font-weight: 700;
      color: var(--navy-deep);
    }

    .services-unsure-label svg {
      color: var(--navy-deep);
    }

    .services-unsure-divider {
      width: 1px;
      height: 24px;
      background: var(--border);
    }

    /* Business: Unsure buttons use the canonical row style below. */
    /* Technical: Removed duplicate .services-unsure-btns to keep one source. */
    .btn-outline-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border: 1px solid var(--border);
      border-radius: 40px;
      font-family: var(--font-h);
      font-size: 12px;
      font-weight: 600;
      color: var(--graphite-mid);
      background: var(--white);
      transition: all 0.2s;
    }

    .btn-outline-pill:hover {
      border-color: var(--teal);
      color: var(--teal);
      background: rgba(12, 124, 130, 0.03);
    }

    .btn-outline-pill svg {
      stroke-width: 2;
      width: 14px;
      height: 14px;
    }

    .btn-outline-pill .teal-icon {
      color: var(--teal);
    }

    /* Business: Keep secondary contact actions readable against the dark closing CTA.
       Technical: Override the shared white pill background only inside the dark final CTA. */
    .final-cta .btn-outline-pill {
      background: transparent;
    }

    /* Keep sticky navigation from covering the start of a section after an in-page jump. */
    #services,
    #request,
    #how-it-works,
    #trust,
    #faq,
    #contact {
      scroll-margin-top: 76px;
    }

    /* Business: Start-request hint fades up on hover/focus, always visible on touch. */
    /* Technical: Single canonical .svc-action; mobile override forces opacity 1. */
    .svc-action {
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-h);
      font-size: 12.5px;
      font-weight: 700;
      color: var(--teal);
      margin-top: auto;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
    }

    .svc-card:hover .svc-action,
    .svc-card:focus-visible .svc-action {
      opacity: 1;
      transform: translateY(0);
    }

    @media (hover: none) {
      .svc-action {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .svc-action-arrow {
      transition: transform 0.2s var(--ease);
    }

    .svc-card:hover .svc-action-arrow {
      transform: translateX(4px);
    }

    .services-unsure {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 28px 36px;
      background: rgba(12, 124, 130, 0.06);
      border: 1.5px solid rgba(12, 124, 130, 0.18);
      border-radius: 12px;
    }

    .services-unsure p {
      font-family: var(--font-h);
      font-size: 15px;
      font-weight: 600;
      color: var(--graphite);
    }

    .services-unsure-btns {
      display: flex;
      gap: 12px;
      flex-shrink: 0;
    }

    /* ================================================
       QUICK REQUEST FORM
    ================================================ */
    .qr-wrap {
      background: var(--bg-off);
      padding: 100px 0;
    }

    .qr-inner {
      max-width: 1160px;
      margin: 0 auto;
      padding: 0 48px;
      display: grid;
      grid-template-columns: 4fr 5fr;
      gap: 60px;
      align-items: start;
    }

    /* Left side */
    .qr-left .eyebrow {
      margin-bottom: 24px;
      color: var(--graphite-mid);
    }

    .qr-left h2 {
      font-family: var(--font-h);
      font-size: clamp(32px, 3.8vw, 48px);
      font-weight: 800;
      color: var(--navy-deep);
      letter-spacing: -0.022em;
      line-height: 1.15;
      margin-bottom: 20px;
    }

    .qr-desc {
      font-size: 16.5px;
      color: var(--graphite-mid);
      line-height: 1.6;
      margin-bottom: 28px;
      max-width: 380px;
    }

    .qr-callout {
      background: rgba(12, 124, 130, 0.06);
      border-radius: 8px;
      padding: 16px 20px;
      display: flex;
      gap: 16px;
      margin-bottom: 32px;
    }

    .qr-callout-icon {
      width: 24px;
      height: 24px;
      background: var(--teal);
      color: var(--white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-h);
      font-size: 12px;
      font-weight: 700;
      flex-shrink: 0;
    }

    .qr-callout-title {
      font-family: var(--font-h);
      font-size: 13.5px;
      font-weight: 700;
      color: var(--teal);
      margin-bottom: 4px;
    }

    .qr-callout-sub {
      font-size: 13px;
      color: var(--graphite-mid);
    }

    .qr-trust-line {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--navy-deep);
      margin-bottom: 40px;
    }

    .qr-trust-line svg {
      color: var(--navy-deep);
      stroke-width: 2;
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .qr-trust-dot {
      color: var(--graphite-lt);
      font-size: 20px;
      line-height: 0;
      margin: 0 4px;
    }

    .qr-img-wrap {
      position: relative;
      margin-bottom: 40px;
      /* Fade out smoothly on the right edge so the text blends into the background */
      mask-image: linear-gradient(to right, black 80%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, black 80%, transparent 100%);
    }

    .qr-img-wrap img {
      width: 100%;
      display: block;
    }

    .qr-handwriting {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%) rotate(-6deg);
      font-family: "Caveat", cursive, sans-serif;
      font-size: 24px;
      color: var(--navy-deep);
      line-height: 1.3;
    }

    .qr-handwriting-swoosh {
      margin-top: 4px;
      width: 80px;
    }

    .qr-handwriting-swoosh svg {
      stroke: var(--teal);
      stroke-width: 3;
      fill: none;
      width: 100%;
      overflow: visible;
      stroke-linecap: round;
    }

    .qr-bottom-contact {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .qr-bottom-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-h);
      font-size: 13.5px;
      font-weight: 700;
      color: var(--navy-deep);
    }

    /* Right side form card */
    .form-card {
      background: var(--white);
      border-radius: 16px;
      padding: 48px;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.06), 0 0 0 1px rgba(0, 0, 0, 0.04);
    }

    /* Progress */
    .fp {
      display: flex;
      align-items: flex-start;
      position: relative;
      margin-bottom: 40px;
    }

    .fp-track {
      position: absolute;
      top: 13px;
      left: 13px;
      right: 13px;
      height: 2px;
      background: rgba(0, 0, 0, 0.08);
    }

    .fp-fill {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      background: var(--teal);
      transition: width 0.45s var(--ease);
      width: 0%;
    }

    .fp-step {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      position: relative;
      z-index: 1;
    }

    .fp-circle {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-h);
      font-size: 11px;
      font-weight: 700;
      color: var(--white);
      transition: all 0.3s var(--ease);
    }

    .fp-circle.is-active {
      background: var(--teal);
    }

    .fp-circle.is-done {
      background: var(--teal);
    }

    .fp-label {
      font-family: var(--font-h);
      font-size: 11.5px;
      font-weight: 600;
      color: var(--graphite-mid);
    }

    .fp-label.is-active {
      color: var(--navy-deep);
    }

    /* Form steps */
    .fs {
      display: none;
    }

    .fs.is-active {
      display: block;
    }

    .fs h3 {
      font-family: var(--font-h);
      font-size: 32px;
      font-weight: 800;
      color: var(--navy-deep);
      margin-bottom: 28px;
      letter-spacing: -0.01em;
    }

    /* Appliance picker */
    .app-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-bottom: 28px;
    }

    .app-opt {
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--white);
      cursor: pointer;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: all 0.2s;
      outline: none;
    }

    .app-opt:hover {
      border-color: var(--teal);
    }

    .app-opt.is-sel {
      border-color: var(--teal);
      background: rgba(12, 124, 130, 0.03);
    }

    .app-opt-img {
      width: 100%;
      height: 70px;
      padding: 12px 12px 4px 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .app-opt-img img {
      max-height: 100%;
      max-width: 100%;
      object-fit: contain;
    }

    .app-opt-label {
      font-size: 11px;
      font-weight: 600;
      font-family: var(--font-h);
      color: var(--navy-deep);
      padding: 8px 4px 14px;
      text-align: center;
    }

    .app-opt-check {
      position: absolute;
      bottom: 8px;
      right: 8px;
      width: 18px;
      height: 18px;
      background: var(--teal);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: scale(0.5);
      transition: all 0.2s;
    }

    .app-opt.is-sel .app-opt-check {
      opacity: 1;
      transform: scale(1);
    }

    .app-opt-check svg {
      width: 10px;
      height: 10px;
      color: white;
      stroke-width: 3;
    }

    /* Fields */
    .field-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    .field {
      margin-bottom: 24px;
    }

    .field label {
      display: block;
      font-family: var(--font-h);
      font-size: 13.5px;
      font-weight: 700;
      color: var(--navy-deep);
      margin-bottom: 8px;
    }

    .field label .opt {
      font-weight: 500;
      color: var(--graphite-lt);
    }

    .field input,
    .field textarea,
    .field select {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 6px;
      font-size: 14px;
      color: var(--graphite);
      background: var(--bg-off);
      transition: border-color 0.2s, box-shadow 0.2s;
      outline: none;
      appearance: none;
    }

    .field input::placeholder,
    .field textarea::placeholder {
      color: var(--graphite-lt);
    }

    .field input:focus,
    .field textarea:focus,
    .field select:focus {
      border-color: var(--teal);
      background: var(--white);
      box-shadow: 0 0 0 3px rgba(12, 124, 130, 0.12);
    }

    .field input.err {
      border-color: #d94040;
    }

    .field textarea {
      resize: vertical;
      min-height: 110px;
      line-height: 1.6;
    }

    .field-hint {
      font-size: 12px;
      color: var(--graphite-mid);
      margin-top: 8px;
    }

    .file-upload {
      border: 1px dashed rgba(12, 124, 130, 0.3);
      background: rgba(12, 124, 130, 0.02);
      border-radius: 8px;
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--teal);
      cursor: pointer;
      margin-bottom: 28px;
      transition: background 0.2s;
    }

    .file-upload:hover {
      background: rgba(12, 124, 130, 0.05);
    }

    .file-upload span {
      color: var(--graphite-lt);
      font-weight: 500;
    }

    /* Time picker */
    .time-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 24px;
    }

    .time-opt {
      padding: 14px 12px;
      border: 1px solid var(--border);
      border-radius: 6px;
      text-align: center;
      cursor: pointer;
      font-family: var(--font-h);
      font-size: 13.5px;
      font-weight: 600;
      color: var(--graphite);
      transition: all 0.2s;
      user-select: none;
      background: var(--white);
    }

    .time-opt:hover {
      border-color: var(--teal);
      background: rgba(12, 124, 130, 0.03);
    }

    .time-opt.is-sel {
      border-color: var(--teal);
      background: rgba(12, 124, 130, 0.08);
      color: var(--teal);
    }

    /* Summary box */
    .summary-box {
      background: rgba(12, 124, 130, 0.04);
      border-radius: 10px;
      padding: 24px;
      margin-bottom: 24px;
    }

    .summary-title {
      font-family: var(--font-h);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--navy-deep);
      margin-bottom: 16px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
      padding: 6px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    }

    .summary-row:last-child {
      border-bottom: none;
    }

    .summary-row span:first-child {
      color: var(--graphite-mid);
    }

    .summary-row span:last-child {
      font-weight: 600;
      color: var(--navy-deep);
    }

    /* Form nav */
    .form-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 12px;
    }

    .btn-prev {
      padding: 13px 18px;
      color: var(--graphite-mid);
      font-family: var(--font-h);
      font-size: 13.5px;
      font-weight: 700;
      transition: color 0.2s;
      background: none;
      border: none;
      cursor: pointer;
    }

    .btn-prev:hover {
      color: var(--navy-deep);
    }

    .btn-next,
    .btn-submit {
      padding: 16px 48px;
      background: var(--teal);
      color: var(--white);
      border-radius: 40px;
      font-family: var(--font-h);
      font-size: 14.5px;
      font-weight: 700;
      transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
      letter-spacing: 0.01em;
      border: none;
      cursor: pointer;
    }

    .btn-next:hover,
    .btn-submit:hover {
      background: var(--teal-hover);
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(12, 124, 130, 0.25);
    }

    .form-footer-link {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--teal);
      text-decoration: none;
    }

    .form-footer-link svg {
      width: 16px;
      height: 16px;
      stroke-width: 2.5;
    }

    .qr-form-bottom-trust {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid rgba(0, 0, 0, 0.06);
    }

    .qr-form-bottom-trust svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      color: var(--navy-deep);
      margin-top: 2px;
    }

    .qr-form-bottom-title {
      font-family: var(--font-h);
      font-size: 13px;
      font-weight: 700;
      color: var(--navy-deep);
      margin-bottom: 4px;
    }

    .qr-form-bottom-sub {
      font-size: 11.5px;
      color: var(--graphite-mid);
      line-height: 1.4;
    }

    /* Success */
    .form-success {
      display: none;
      text-align: center;
      padding: 20px 10px;
    }

    .success-ring {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(12, 124, 130, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      margin: 0 auto 20px;
    }

    .success-ref-num {
      font-family: var(--font-h);
      font-size: 26px;
      font-weight: 800;
      color: var(--teal);
      letter-spacing: 0.06em;
      margin-bottom: 6px;
    }

    .success-ref-label {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--graphite-lt);
      margin-bottom: 20px;
    }

    .success-msg {
      font-size: 14.5px;
      color: var(--graphite-mid);
      line-height: 1.68;
      margin-bottom: 24px;
    }

    .success-msg strong {
      color: var(--graphite);
    }

    /* ================================================
       HOW IT WORKS (Sticky Scroll Storyboard)
    ================================================ */

    /* Outer: provides scroll distance â€” 5 steps Ã— ~40vh each */
    .hiw-scroll-outer {
      position: relative;
      height: auto;
      margin-bottom: 56px;
    }

    /* The two columns scroll normally; only the photo column pins. */
    .hiw-storyboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
      margin-bottom: 0;
    }

    /* On tablet/mobile: collapse the outer, release the sticky */
    @media (max-width: 991px) {
      .hiw-scroll-outer { height: auto; margin-bottom: 32px; }
      .hiw-storyboard-grid {
        position: relative;
        top: 0;
        grid-template-columns: 1fr;
        gap: 32px;
      }
    }

    /* Left: image column â€” no longer needs its own sticky */
    .hiw-media-column {
      position: sticky;
      top: 100px;
      align-self: start;
    }

    .hiw-media-frame {
      position: relative;
      width: 100%;
      height: 480px;
      border-radius: 24px;
      overflow: hidden;
      background: var(--navy-deep);
      box-shadow: 0 20px 50px rgba(16, 38, 61, 0.15), 0 4px 12px rgba(0, 0, 0, 0.05);
      border: 1px solid rgba(12, 124, 130, 0.15);
    }

    @media (max-width: 991px) {
      .hiw-media-column {
        position: relative;
        top: 0;
      }

      .hiw-media-frame {
        height: 320px;
      }
    }

    @media (max-width: 576px) {
      .hiw-media-frame {
        height: 260px;
      }
    }

    .hiw-slide-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      /* No transition on exit â€” disappears instantly so two images never overlap */
      transition: none;
      z-index: 1;
    }

    .hiw-slide-img.is-active {
      opacity: 1;
      z-index: 2;
      /* Only the incoming image gets a smooth fade-in */
      transition: opacity 0.35s ease;
    }

    /* Overlay visual elements over the photo frame */
    .hiw-media-overlay-top {
      display: none !important;
      position: absolute;
      top: 20px;
      left: 20px;
      right: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 10;
      pointer-events: none;
    }

    .hiw-step-pill {
      background: rgba(16, 38, 61, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      color: var(--gold);
      font-family: var(--font-h);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 8px 16px;
      border-radius: 30px;
      border: 1px solid rgba(232, 163, 36, 0.3);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .hiw-status-live {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      color: var(--navy-deep);
      font-family: var(--font-h);
      font-size: 11.5px;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 30px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .hiw-status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10B981;
      box-shadow: 0 0 10px #10B981;
      animation: hiwPulse 2s infinite;
    }

    @keyframes hiwPulse {
      0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      }

      70% {
        transform: scale(1);
        box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
      }

      100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .hiw-media-overlay-bottom {
      display: none !important;
      position: absolute;
      bottom: 20px;
      left: 20px;
      right: 20px;
      z-index: 10;
      pointer-events: none;
    }

    .hiw-active-caption-box {
      background: rgba(16, 38, 61, 0.88);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 14px;
      padding: 16px 20px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--white);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    }

    .hiw-caption-tag {
      font-size: 10.5px;
      font-weight: 700;
      color: var(--teal);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: 4px;
      display: block;
    }

    .hiw-caption-title {
      font-family: var(--font-h);
      font-size: 16px;
      font-weight: 800;
      color: var(--white);
      line-height: 1.3;
    }

    /* Right: Interactive Step Cards List */
    .hiw-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
      /* Business: Give each step scroll room so pinned image advances 1→6. */
      /* Technical: Vertical padding lengthens sticky journey without changing design. */
      padding: 10vh 0;
    }

    .hiw-item {
      position: relative;
      background: var(--white);
      border-radius: 16px;
      padding: 22px 24px;
      cursor: pointer;
      border: 1.5px solid rgba(0, 0, 0, 0.05);
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.02);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
      min-height: 104px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .hiw-item:hover {
      border-color: rgba(12, 124, 130, 0.3);
      transform: translateX(4px);
      box-shadow: 0 8px 24px rgba(12, 124, 130, 0.08);
    }

    .hiw-item.is-active {
      background: #ffffff;
      border-color: var(--teal);
      box-shadow: 0 12px 32px rgba(12, 124, 130, 0.12), 0 2px 6px rgba(12, 124, 130, 0.05);
      transform: translateX(6px);
    }

    /* Progress bar on the left edge of card */
    .hiw-item-progress-bar {
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: 4px;
      background: var(--teal);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .hiw-item.is-active .hiw-item-progress-bar {
      opacity: 1;
    }

    .hiw-item-head {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .hiw-item-num {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(12, 124, 130, 0.08);
      color: var(--teal);
      font-family: var(--font-h);
      font-size: 13px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.3s ease;
    }

    .hiw-item.is-active .hiw-item-num {
      background: var(--teal);
      color: var(--white);
      box-shadow: 0 4px 14px rgba(12, 124, 130, 0.35);
    }

    .hiw-item-title {
      font-family: var(--font-h);
      font-size: 16px;
      font-weight: 800;
      color: var(--navy-deep);
      margin: 0;
      line-height: 1.3;
      flex-grow: 1;
    }

    .hiw-item-chevron {
      width: 20px;
      height: 20px;
      color: var(--graphite-lt);
      transition: transform 0.3s, color 0.3s;
      flex-shrink: 0;
    }

    .hiw-item.is-active .hiw-item-chevron {
      transform: rotate(90deg);
      color: var(--teal);
    }

    .hiw-item-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, margin-top 0.3s ease;
      opacity: 0;
      margin-top: 0;
    }

    .hiw-item.is-active .hiw-item-body {
      max-height: 120px;
      opacity: 1;
      margin-top: 12px;
    }

    .hiw-item-desc {
      font-size: 13.5px;
      color: var(--graphite-mid);
      line-height: 1.6;
      padding-left: 52px;
      margin: 0;
    }

    @media (max-width: 576px) {
      .hiw-item-desc {
        padding-left: 0;
      }
    }

    /* ================================================
       MOBILE HOW IT WORKS â€” Swipe Card Carousel
    ================================================ */
    .hiw-mobile-carousel {
      display: none;
      /* Hidden on desktop */
    }

    @media (max-width: 768px) {

      /* Hide desktop storyboard on mobile */
      .hiw-storyboard-grid {
        display: none;
      }

      /* Show mobile carousel */
      .hiw-mobile-carousel {
        display: block;
        margin-bottom: 32px;
      }

      /* Outer track wrapper */
      .hiw-mob-track-wrap {
        overflow: hidden;
        border-radius: 20px;
        position: relative;
        touch-action: pan-y;
      }

      /* Sliding track */
      .hiw-mob-track {
        display: flex;
        transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
        will-change: transform;
      }

      /* Each slide card */
      .hiw-mob-card {
        width: 100%;
        min-width: 0;
        flex: 0 0 100%;
        background: var(--white);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(16, 38, 61, 0.10);
        border: 1.5px solid rgba(12, 124, 130, 0.1);
        flex-shrink: 0;
      }

      /* Photo area inside card */
      .hiw-mob-photo {
        position: relative;
        height: 230px;
        overflow: hidden;
        background: var(--navy-deep);
      }

      .hiw-mob-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      /* Gradient scrim over photo */
      .hiw-mob-photo::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 60%;
        background: linear-gradient(to top, rgba(10, 30, 48, 0.75) 0%, transparent 100%);
        pointer-events: none;
      }

      /* Step pill badge on photo */
      .hiw-mob-pill {
        display: none !important;
        position: absolute;
        top: 14px;
        left: 14px;
        background: rgba(16, 38, 61, 0.88);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        color: var(--gold);
        font-family: var(--font-h);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 6px 12px;
        border-radius: 30px;
        border: 1px solid rgba(232, 163, 36, 0.3);
        z-index: 2;
      }

      /* Live badge on photo */
      .hiw-mob-live {
        display: none !important;
        position: absolute;
        top: 14px;
        right: 14px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 30px;
        font-family: var(--font-h);
        font-size: 10.5px;
        font-weight: 700;
        color: var(--navy-deep);
        z-index: 2;
      }

      .hiw-mob-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10B981;
        box-shadow: 0 0 8px #10B981;
        animation: hiwPulse 2s infinite;
        flex-shrink: 0;
      }

      /* Text content below photo */
      .hiw-mob-body {
        padding: 22px 20px 24px;
      }

      .hiw-mob-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--teal);
        color: var(--white);
        font-family: var(--font-h);
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 12px;
        box-shadow: 0 4px 12px rgba(12, 124, 130, 0.3);
      }

      .hiw-mob-title {
        font-family: var(--font-h);
        font-size: 20px;
        font-weight: 800;
        color: var(--navy-deep);
        letter-spacing: -0.015em;
        line-height: 1.2;
        margin-bottom: 10px;
      }

      .hiw-mob-desc {
        font-size: 14.5px;
        color: var(--graphite-mid);
        line-height: 1.6;
      }

      /* Dot navigation */
      .hiw-mob-dots {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
      }

      .hiw-mob-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: rgba(12, 124, 130, 0.2);
        border: none;
        padding: 0;
        cursor: pointer;
        transition: all 0.3s var(--ease);
        touch-action: manipulation;
      }

      .hiw-mob-dot.is-active {
        width: 24px;
        border-radius: 4px;
        background: var(--teal);
      }

      /* Prev/Next arrow buttons */
      .hiw-mob-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        padding: 0 4px;
      }

      .hiw-mob-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1.5px solid rgba(12, 124, 130, 0.25);
        background: var(--white);
        color: var(--teal);
        cursor: pointer;
        transition: all 0.2s;
        touch-action: manipulation;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      }

      .hiw-mob-arrow:active {
        background: var(--teal);
        color: var(--white);
        transform: scale(0.93);
      }

      .hiw-mob-arrow:disabled {
        opacity: 0.3;
        pointer-events: none;
      }

      .hiw-mob-arrow svg {
        width: 18px;
        height: 18px;
        stroke-width: 2.5;
      }

      .hiw-mob-counter {
        font-family: var(--font-h);
        font-size: 12px;
        font-weight: 700;
        color: var(--graphite-mid);
        letter-spacing: 0.05em;
      }
    }

    /* Reassurance strip */
    .hiw-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 32px 40px;
      background: rgba(12, 124, 130, 0.06);
      border-radius: 12px;
    }

    .hiw-strip-left {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .hiw-strip-icon {
      width: 56px;
      height: 56px;
      flex-shrink: 0;
    }

    .hiw-strip-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .hiw-strip-text h4 {
      font-family: var(--font-h);
      font-size: 18px;
      font-weight: 800;
      color: var(--navy-deep);
      margin-bottom: 6px;
      letter-spacing: -0.01em;
    }

    .hiw-strip-text p {
      font-size: 14px;
      color: var(--graphite-mid);
    }

    .hiw-strip-btns {
      display: flex;
      gap: 12px;
      flex-shrink: 0;
      align-items: center;
    }

    @media (max-width: 768px) {
      #how-it-works {
        padding: 64px 0 !important;
      }

      .hiw-strip {
        flex-direction: column;
        align-items: stretch;
        gap: 20px;
        padding: 24px 20px;
      }

      .hiw-strip-left {
        align-items: flex-start;
        gap: 14px;
      }

      .hiw-strip-icon {
        width: 44px;
        height: 44px;
      }

      .hiw-strip-text h4 {
        font-size: 16px;
        line-height: 1.3;
      }

      .hiw-strip-text p {
        font-size: 13px;
        line-height: 1.5;
      }

      .hiw-strip-btns {
        width: 100%;
        flex-direction: column;
        align-items: stretch;
      }

      .hiw-strip-btns > a {
        width: 100%;
        justify-content: center;
        text-align: center;
      }
    }

    /* ================================================
       TRUST SECTION
    ================================================ */
    .trust-sec {
      background: var(--navy-deep);
      padding: 100px 0 120px;
      position: relative;
      overflow: hidden;
      box-shadow: 
        inset 0px 12px 24px rgba(0, 0, 0, 0.35),
        inset 0px -12px 24px rgba(0, 0, 0, 0.35); /* Micro-depth transitions to light sections above/below */
    }

    /* Background topography lines (optional decoration) */
    .trust-bg-lines {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      pointer-events: none;
      opacity: 0.15;
      background-image:
        radial-gradient(circle at 0% 50%, transparent 20%, rgba(255, 255, 255, 0.2) 21%, transparent 22%),
        radial-gradient(circle at 0% 50%, transparent 40%, rgba(255, 255, 255, 0.2) 41%, transparent 42%),
        radial-gradient(circle at 100% 50%, transparent 20%, rgba(255, 255, 255, 0.2) 21%, transparent 22%),
        radial-gradient(circle at 100% 50%, transparent 40%, rgba(255, 255, 255, 0.2) 41%, transparent 42%);
      background-size: 100% 100%;
    }

    .trust-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 80px;
      row-gap: 60px;
      margin-bottom: 80px;
      position: relative;
    }

    .trust-connecting-line {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      pointer-events: none;
      z-index: 0;
    }

    .trust-connecting-line svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .trust-block {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .trust-icon-wrap {
      width: 140px;
      height: 140px;
      flex-shrink: 0;
      border-radius: 50%;
      border: 1px solid rgba(12, 124, 130, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      background: var(--navy-deep);
      box-shadow: inset 0 0 40px rgba(12, 124, 130, 0.1);
    }

    .trust-icon-wrap::before {
      content: '';
      position: absolute;
      top: -6px;
      left: -6px;
      right: -6px;
      bottom: -6px;
      border-radius: 50%;
      border: 1px dashed rgba(12, 124, 130, 0.2);
    }

    .trust-icon-wrap svg {
      width: 60%;
      height: 60%;
    }

    .trust-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 1px solid var(--gold);
      color: var(--gold);
      font-family: var(--font-h);
      font-size: 10px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .trust-title {
      font-family: var(--font-h);
      font-size: 22px;
      font-weight: 700;
      color: var(--white);
      margin-bottom: 12px;
      letter-spacing: -0.01em;
    }

    .trust-desc {
      font-size: 14.5px;
      color: rgba(255, 255, 255, 0.65);
      line-height: 1.6;
    }

    /* Divider */
    .trust-divider {
      height: 1px;
      background: rgba(255, 255, 255, 0.1);
      margin: 80px 0 40px;
    }

    /* Trust proof cards */
    .trust-cards-head {
      margin-bottom: 32px;
    }

    .trust-proof {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 24px;
    }

    .tp-card {
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.02);
      transition: border-color 0.2s, background 0.2s;
      display: flex;
      flex-direction: row;
      align-items: stretch;
      height: 120px;
    }

    .tp-card:hover {
      border-color: rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.04);
    }

    .tp-img {
      width: 45%;
      position: relative;
      background: var(--navy);
    }

    .tp-img img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      display: block;
    }

    .tp-body {
      width: 55%;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 12px;
    }

    .tp-icon {
      color: var(--white);
    }

    .tp-icon svg {
      width: 20px;
      height: 20px;
      stroke-width: 1.5;
    }

    .tp-label {
      font-family: var(--font-h);
      font-size: 13.5px;
      font-weight: 600;
      color: var(--white);
      line-height: 1.4;
    }

    .trust-footer-note {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.4);
    }

    .trust-cta {
      display: flex;
      justify-content: center;
      margin-top: 64px;
    }

    .trust-cta-btns {
      display: flex;
      gap: 16px;
    }

    /* ================================================
       FAQ
    ================================================ */
    .sec-faq {
      background: var(--bg-off);
      padding: 100px 0;
    }

    /* Mobile tabs â€” hidden on desktop */
    .faq-mobile-tabs {
      display: none;
    }

    .faq-tab {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 24px;
      background: transparent;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 8px;
      font-family: var(--font-h);
      font-size: 13.5px;
      font-weight: 600;
      color: var(--navy-deep);
      transition: all 0.2s;
      cursor: pointer;
    }

    .faq-tab.is-active {
      background: rgba(12, 124, 130, 0.05);
      border-color: var(--teal);
      color: var(--teal);
    }

    .faq-tab svg {
      width: 18px;
      height: 18px;
      stroke-width: 2;
    }

    /* Desktop: 3-column grid with column headers */
    .faq-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    /* Desktop columns always visible */
    .faq-desktop-col {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .faq-col-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 20px;
      background: rgba(255, 255, 255, 0.5);
      border-radius: 8px;
      margin-bottom: 8px;
      font-family: var(--font-h);
      font-weight: 700;
      color: var(--navy-deep);
      font-size: 15px;
    }

    .faq-col-header svg {
      width: 22px;
      height: 22px;
      color: var(--teal);
    }

    .faq-item {
