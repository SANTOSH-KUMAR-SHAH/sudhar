<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sudhar Lab — Home Appliance Repair & Maintenance in Kathmandu</title>
  <link rel="icon" type="image/png" href="/logo.png" />
  <meta name="description"
    content="Sudhar Lab provides trusted home appliance repair and maintenance for TVs, washing machines, ACs, and refrigerators in Kathmandu. Diagnosis first. Price explained. Repair only with your approval." />
  <link rel="canonical" href="https://sudhar-lab.example/" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Sudhar Lab — Home Appliance Repair & Maintenance in Kathmandu" />
  <meta property="og:description"
    content="Tell us what is wrong. We confirm your request, inspect the appliance at your home, explain the price, and repair only with your approval." />
  <meta property="og:image" content="https://sudhar-lab.example/dhero.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Kalam:wght@400;700&display=swap"
    rel="stylesheet" />
</head>

