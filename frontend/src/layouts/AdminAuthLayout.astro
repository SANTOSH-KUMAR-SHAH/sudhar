---
import '../styles/tailwind.css';
const { title = "Admin Portal - Sudhar Lab" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="icon" type="image/png" href="/logo.png" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

  <style is:global>
    /* Technical: Brand values mirror @theme in styles/tailwind.css (canonical source). */
    :root {
      --navy: #10263D;
      --teal: #0C7C82;
      --teal-light: #E9F6F7;
      --teal-hover: #0E9198;
      --bg-off: #F8F7F3; /* Off-white from the design */
      --pure-white: #FFFFFF;
      --graphite: #2B2E31;
      --graphite-mid: #4A4E52;
      --graphite-lt: #7C8186;
      --border: #E5E7EB;

      --font-h: 'Space Grotesk', 'IBM Plex Sans', sans-serif;
      --font-b: 'IBM Plex Sans', 'Space Grotesk', sans-serif;
      --font-fig: 'IBM Plex Mono', ui-monospace, monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-b);
      color: var(--navy);
      background-color: var(--bg-off);
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
    }

    .auth-container {
      display: flex;
      width: 100%;
      height: 100vh;
      overflow: hidden;
    }

    /* Left Side: Navy Information Panel */
    .auth-sidebar {
      flex: 1;
      background-color: var(--navy);
      color: var(--pure-white);
      display: flex;
      flex-direction: column;
      padding: 4rem;
      position: relative;
      overflow: hidden;
      justify-content: space-between;
    }

    .auth-sidebar::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url('/admin-login.png');
      background-size: cover;
      background-position: top center; /* Shifted up so it doesn't overlap bottom text */
      background-repeat: no-repeat;
      opacity: 1;
      z-index: 1;
    }

    .auth-sidebar::after {
      content: '';
      position: absolute;
      inset: 0;
      /* Bottom darkens for text, right edge feathers into the form panel divider.
         Top left stays bright so the illustration reads as a window, not a filter. */
      background:
        linear-gradient(to top,
          rgba(6, 14, 22, 0.97) 0%,
          rgba(6, 14, 22, 0.75) 18%,
          rgba(6, 14, 22, 0.20) 40%,
          transparent 60%),
        /* Right feather â€” softens hard edge between panels */
        linear-gradient(to left,
          rgba(6, 14, 22, 0.40) 0%,
          transparent 25%),
        /* Subtle top darkening â€” keeps header area anchored */
        linear-gradient(to bottom,
          rgba(6, 14, 22, 0.35) 0%,
          transparent 18%);
      z-index: 2;
    }

    /* Teal brand ambient glow â€” bottom left, ties to Sudhar Lab identity */
    .auth-sidebar .sidebar-content + * {
      display: none; /* cleanup */
    }

    /* Right Side: Off-white Form Panel */
    .auth-main {
      flex: 1;
      background-color: var(--bg-off);
      display: flex;
      flex-direction: column;
      padding: 4rem;
      position: relative;
      overflow-y: auto;
    }

    /* Safe vertical centering trick for main panel */
    .auth-main::before,
    .auth-main::after {
      content: '';
      flex: 1;
    }

    @media (max-width: 900px) {
      .auth-container {
        flex-direction: column;
        height: 100dvh;
        min-height: 100dvh;
        overflow: hidden;
      }
      .auth-sidebar {
        flex: 0 0 32%;
        padding: 1.5rem;
        display: flex;
        justify-content: flex-start;
      }
      .auth-main {
        flex: 1;
        padding: 2rem 1.5rem 1rem;
        border-radius: 24px 24px 0 0;
        margin-top: -24px;
        z-index: 10;
        position: relative;
        overflow-y: auto;
        justify-content: flex-start;
      }
    }

    @media (max-width: 480px) {
      .auth-main {
        padding: 1.5rem 1.25rem 1rem;
      }
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <slot />
  </div>
</body>
</html>
