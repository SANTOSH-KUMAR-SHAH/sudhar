  <div class="qr-wrap" id="request" aria-label="Request service">
    <div class="qr-inner">

      <!-- Left: explanation -->
      <div class="qr-left reveal">
        <div class="hero-eyebrow-row" style="margin-bottom: 16px;">
          <div class="hero-eyebrow-bar" style="width:24px;"></div>
          <span class="eyebrow" style="color:var(--graphite-mid);">START WITH THE PROBLEM</span>
        </div>
        <h2>Tell us what's wrong.</h2>
        <p class="qr-desc">
          Choose your appliance and give us a few details.<br>We'll call to confirm your home visit.
        </p>

        <div class="qr-callout">
          <div class="qr-callout-icon">i</div>
          <div>
            <div class="qr-callout-title">You don't need to know the technical fault.</div>
            <div class="qr-callout-sub">Just tell us what happened.</div>
          </div>
        </div>

        <div class="qr-trust-line">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <polyline points="9 12 11 14 15 10"></polyline>
          </svg>
          <span>Diagnosis first</span>
          <span class="qr-trust-dot">·</span>
          <span>Price explained</span>
          <span class="qr-trust-dot">·</span>
          <span>Repair only after approval</span>
        </div>

        <div class="qr-img-wrap">
          <img src="/form.png" alt="Sudhar Lab service request form" loading="lazy" />
        </div>

        <div class="qr-bottom-contact">
          <div class="qr-bottom-label">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round" style="color:var(--navy-deep);">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
              </path>
            </svg>
            Prefer to talk?
          </div>
          <a href="tel:+977XXXXXXXXXX" class="btn-outline-pill">
            <svg class="teal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
              stroke-linejoin="round">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
              </path>
            </svg>
            Call Sudhar Lab
          </a>
          <a href="https://wa.me/977XXXXXXXXXX" class="btn-outline-pill" target="_blank" rel="noopener noreferrer">
            <svg class="teal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
              stroke-linejoin="round">
              <path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
              </path>
            </svg>
            WhatsApp Us
          </a>
        </div>
      </div>

      <!-- Right: form -->
      <div class="form-card reveal d2" role="region" aria-label="Service request form">

        <!-- Progress indicator -->
        <div class="fp" role="progressbar" aria-label="Form progress" aria-valuemin="1" aria-valuemax="3"
          aria-valuenow="1">
          <div class="fp-track">
            <div class="fp-fill" id="fpFill" style="width:0%"></div>
          </div>
          <div class="fp-step">
            <div class="fp-circle is-active" id="fc1">1</div>
            <span class="fp-label is-active" id="fl1">Appliance</span>
          </div>
          <div class="fp-step">
            <div class="fp-circle" id="fc2">2</div>
            <span class="fp-label" id="fl2">Contact</span>
          </div>
          <div class="fp-step">
            <div class="fp-circle" id="fc3">3</div>
            <span class="fp-label" id="fl3">Visit</span>
          </div>
        </div>

        <form id="srForm" novalidate>

          <!-- STEP 1 -->
          <div class="fs is-active" id="fs1">
            <h3>What needs help?</h3>

            <div class="app-grid" id="appGrid">
              <div class="app-opt is-sel" onclick="chooseApp(this,'TV')" tabindex="0">
                <div class="app-opt-img"><img src="/tv.png" alt="TV" /></div>
                <div class="app-opt-label">TV</div>
                <div class="app-opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg></div>
              </div>
              <div class="app-opt" onclick="chooseApp(this,'Washing Machine')" tabindex="0">
                <div class="app-opt-img"><img src="/washing.png" alt="Washing Machine" /></div>
                <div class="app-opt-label">Washing Machine</div>
                <div class="app-opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg></div>
              </div>
              <div class="app-opt" onclick="chooseApp(this,'AC')" tabindex="0">
                <div class="app-opt-img"><img src="/ac.png" alt="AC" /></div>
                <div class="app-opt-label">AC</div>
                <div class="app-opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg></div>
              </div>
              <div class="app-opt" onclick="chooseApp(this,'Refrigerator')" tabindex="0">
                <div class="app-opt-img"><img src="/fridge.png" alt="Refrigerator" /></div>
                <div class="app-opt-label">Refrigerator</div>
                <div class="app-opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg></div>
              </div>
            </div>

            <div class="field-row">
              <div class="field" style="margin-bottom:0">
                <label for="f-brand">Brand</label>
                <input type="text" id="f-brand" name="brand" placeholder="Example: LG, Samsung, Sony"
                  autocomplete="off" />
              </div>
              <div class="field" style="margin-bottom:0">
                <label for="f-model">Model <span class="opt">(optional)</span></label>
                <input type="text" id="f-model" name="model" placeholder="Enter model if you know" autocomplete="off" />
              </div>
            </div>

            <div class="field">
              <label for="f-problem">What is happening?</label>
              <textarea id="f-problem" name="problem" placeholder="Example: The washing machine is not draining..."
                required></textarea>
              <p class="field-hint">Not sure? Describe what you see, hear, or smell.</p>
            </div>

            <div class="file-upload">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
              Add a photo or video <span>(optional)</span>
            </div>

            <div class="form-nav">
              <button type="button" class="btn-next" onclick="toStep(2)">Continue →</button>
              <a href="tel:+977XXXXXXXXXX" class="form-footer-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                  </path>
                </svg>
                Need help? Call Us
              </a>
            </div>

            <div class="qr-form-bottom-trust">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
              <div>
                <div class="qr-form-bottom-title">We'll review your request and call you to confirm the details.</div>
                <div class="qr-form-bottom-sub">Home inspection/service fee applies. Repair price is discussed after
                  diagnosis.</div>
              </div>
            </div>
          </div>

          <!-- STEP 2 -->
          <div class="fs" id="fs2">
            <h3>Your contact details</h3>

            <div class="field">
              <label for="f-name">Full name <span style="color:#d94040">*</span></label>
              <input type="text" id="f-name" name="name" placeholder="Your full name" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="f-phone">Phone number <span style="color:#d94040">*</span></label>
              <input type="tel" id="f-phone" name="phone" placeholder="98XX XXX XXX" autocomplete="tel" required />
            </div>

            <div class="field">
              <label for="f-address">Street / Tole <span class="opt">(optional)</span></label>
              <input type="text" id="f-address" name="address" placeholder="Street or tole name"
                autocomplete="street-address" />
            </div>

            <div class="field">
              <label for="f-area">Area / Location <span style="color:#d94040">*</span></label>
              <input type="text" id="f-area" name="area" placeholder="e.g. Baneshwor, Lalitpur, Bhaktapur" required />
            </div>

            <div class="form-nav">
              <button type="button" class="btn-prev" onclick="toStep(1)">← Back</button>
              <button type="button" class="btn-next" onclick="toStep(3)">Continue → Visit</button>
            </div>
          </div>

          <!-- STEP 3 -->
          <div class="fs" id="fs3">
            <h3>When can we visit?</h3>

            <div class="field">
              <label for="f-date">Preferred date <span class="opt">(optional)</span></label>
              <input type="date" id="f-date" name="date" />
            </div>

            <div class="field">
              <label>Preferred time <span class="opt">(optional)</span></label>
              <div class="time-row">
                <div class="time-opt" onclick="pickTime(this,'Morning')" tabindex="0">🌅 Morning</div>
                <div class="time-opt" onclick="pickTime(this,'Afternoon')" tabindex="0">☀️ Afternoon</div>
                <div class="time-opt" onclick="pickTime(this,'Evening')" tabindex="0">🌆 Evening</div>
              </div>
            </div>

            <div class="field">
              <label for="f-notes">Extra notes <span class="opt">(optional)</span></label>
              <input type="text" id="f-notes" name="notes" placeholder="Anything else that might help our team" />
            </div>

            <div class="summary-box" id="sumBox">
              <div class="summary-title">Your Request Summary</div>
              <div class="summary-row"><span>Appliance</span><span id="sum-app">—</span></div>
              <div class="summary-row"><span>Name</span><span id="sum-name">—</span></div>
              <div class="summary-row"><span>Phone</span><span id="sum-phone">—</span></div>
              <div class="summary-row"><span>Area</span><span id="sum-area">—</span></div>
            </div>

            <div class="fee-note">
              ⚠️ A home inspection / service fee applies. The repair price is discussed separately after diagnosis.
            </div>

            <div class="form-nav">
              <button type="button" class="btn-prev" onclick="toStep(2)">← Back</button>
              <button type="button" class="btn-submit" onclick="submitRequest()">Send Service Request ✓</button>
            </div>
          </div>

        </form>

        <!-- Success state -->
        <div class="form-success" id="formSuccess" aria-live="polite">
          <div class="success-ring">✅</div>
          <div class="success-ref-num" id="successRef">SL-000001</div>
          <div class="success-ref-label">Your Request Number</div>
          <p class="success-msg">
            Our team will review your request and <strong>call you to confirm</strong> the details and visit time.
            A technician will be assigned after the confirmation call.
          </p>
          <a href="tel:+977XXXXXXXXXX" class="btn btn-teal" style="margin:0 auto;font-size:14px;padding:13px 24px;">📞
            Call Us Now</a>
        </div>
      </div>

    </div>
  </div>
