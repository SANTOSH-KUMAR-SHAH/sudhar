---
import { SITE_PHONE_DISPLAY, SITE_PHONE_HREF, SITE_WHATSAPP_HREF, SITE_EMAIL, SITE_EMAIL_HREF } from '../../lib/site';
---
  <footer aria-label="Site footer">
    <div class="footer-top reveal">
      <div class="ft-col">
        <div class="ft-logo">
          <span class="ft-logo-chip">
            <img src="/logo.png" alt="Sudhar Lab"
              style="height: 46px; width: auto; display: block;" />
          </span>
        </div>
        <div class="ft-tagline">HOME APPLIANCE REPAIR & MAINTENANCE</div>
        <p class="ft-desc">Kathmandu's trusted partner for home appliance care.</p>
        <div class="ft-yellow-bar"></div>
      </div>

      <div class="ft-col">
        <h4>CONTACT</h4>
        <div class="ft-links">
          <a href={SITE_PHONE_HREF} class="ft-link">
            <span class="ft-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                </path>
              </svg></span>
            {SITE_PHONE_DISPLAY}
          </a>
          <a href={SITE_WHATSAPP_HREF} class="ft-link ft-link-teal" target="_blank" rel="noopener noreferrer">
            <span class="ft-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                </path>
              </svg></span>
            WhatsApp Us
          </a>
          <a href={SITE_EMAIL_HREF} class="ft-link">
            <span class="ft-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="var(--white)" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg></span>
            {SITE_EMAIL}
          </a>
          <a href="#contact" class="ft-link ft-link-teal">
            <span class="ft-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg></span>
            Contact Us
          </a>
        </div>
      </div>

      <div class="ft-col">
        <h4>SERVICES</h4>
        <div class="ft-links">
          <a href="#services" class="ft-link"><span class="ft-link-chevron">></span> TV Repair</a>
          <a href="#services" class="ft-link"><span class="ft-link-chevron">></span> Washing Machine Repair</a>
          <a href="#services" class="ft-link"><span class="ft-link-chevron">></span> AC Repair</a>
          <a href="#services" class="ft-link"><span class="ft-link-chevron">></span> Refrigerator Repair</a>
        </div>
      </div>

      <div class="ft-col">
        <h4>COMPANY</h4>
        <div class="ft-links">
          <a href="#trust" class="ft-link"><span class="ft-link-chevron">></span> About Us</a>
          <a href="#how-it-works" class="ft-link"><span class="ft-link-chevron">></span> How It Works</a>
          <a href="#faq" class="ft-link"><span class="ft-link-chevron">></span> FAQ</a>
          <a href="#contact" class="ft-link"><span class="ft-link-chevron">></span> Contact</a>
        </div>
      </div>

      <div class="ft-col">
        <h4>LEGAL</h4>
        <div class="ft-links">
          <!-- Business: Legal pages are drafted at launch; until then show intent, never a dead link. -->
          <!-- Technical: span.ft-link--soon keeps row rhythm; .ft-link:hover only targets <a>. -->
          <span class="ft-link ft-link--soon"><span class="ft-link-chevron">></span> Privacy Policy</span>
          <span class="ft-link ft-link--soon"><span class="ft-link-chevron">></span> Terms</span>
          <span class="ft-link ft-link--soon"><span class="ft-link-chevron">></span> Accessibility</span>
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-inner">
        <div class="ft-bottom-left reveal">
          <div class="ft-line-decor"></div>
          <div class="ft-dot"></div>
          <div class="ft-bottom-text">DIAGNOSE · EXPLAIN · REPAIR · SUPPORT</div>
          <div class="ft-line-decor"></div>
        </div>
        <div class="ft-copyright reveal">
          © 2026 Sudhar Lab. All rights reserved.<br>Kathmandu, Nepal
        </div>
      </div>
    </div>
  </footer>
