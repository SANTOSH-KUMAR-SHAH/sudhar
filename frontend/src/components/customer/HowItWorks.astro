---
import { SITE_PHONE_HREF } from '../../lib/site';
---
  <section id="how-it-works" aria-label="How it works" style="background: var(--bg-off); padding: 100px 0;">
    <div class="container" style="max-width: 1200px;">

      <!-- Section Header -->
      <div class="sec-head reveal" style="max-width:640px; margin:0 0 52px;">
        <div class="hero-eyebrow-row" style="margin-bottom: 16px;">
          <div class="hero-eyebrow-bar" style="width:24px; background:var(--gold);"></div>
          <span class="eyebrow" style="color:var(--graphite-mid);">OUR SIMPLE PROCESS</span>
        </div>
        <h2 style="color: var(--navy-deep); margin-bottom: 16px;">
          From request to repair, we keep it clear.
        </h2>
        <p style="font-size: 16px; color: var(--graphite-mid); line-height: 1.6;">
          Tell us what happened. We'll confirm the details, send the right technician, and explain the repair before any
          work begins.
        </p>
      </div>

      <!-- ─ MOBILE ONLY: Swipeable Step Carousel ─ -->
      <div class="hiw-mobile-carousel" aria-label="How it works steps" id="hiwMobileCarousel">
        <div class="hiw-mob-track-wrap" id="hiwMobTrackWrap">
          <div class="hiw-mob-track" id="hiwMobTrack">

            <!-- Card 1 -->
            <div class="hiw-mob-card">
              <div class="hiw-mob-photo">
                <div class="hiw-mob-bg" style="background-image:url('/step1.png')" aria-hidden="true"></div>
                <img src="/step1.png" alt="Customer submits service request on phone" loading="lazy" />
                <span class="hiw-mob-pill">STEP 01 OF 06</span>
                <div class="hiw-mob-live">
                  <span class="hiw-mob-live-dot"></span>
                  <span>Live Status</span>
                </div>
              </div>
              <div class="hiw-mob-body">
                <div class="hiw-mob-num">01</div>
                <div class="hiw-mob-title">You submit a request</div>
                <p class="hiw-mob-desc">Take a quick photo of the issue and fill out our simple form. Takes under 60 seconds — no model number or technical knowledge needed.</p>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="hiw-mob-card">
              <div class="hiw-mob-photo">
                <div class="hiw-mob-bg" style="background-image:url('/step2.png')" aria-hidden="true"></div>
                <img src="/step2.png" alt="Sudhar Lab team calls to confirm request" loading="lazy" />
                <span class="hiw-mob-pill">STEP 02 OF 06</span>
                <div class="hiw-mob-live">
                  <span class="hiw-mob-live-dot"></span>
                  <span>Live Status</span>
                </div>
              </div>
              <div class="hiw-mob-body">
                <div class="hiw-mob-num">02</div>
                <div class="hiw-mob-title">We call to confirm</div>
                <p class="hiw-mob-desc">A Sudhar Lab team member calls you directly to verify the details, confirm your address, and agree on a visit time that suits you.</p>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="hiw-mob-card">
              <div class="hiw-mob-photo">
                <div class="hiw-mob-bg" style="background-image:url('/step3.png')" aria-hidden="true"></div>
                <img src="/step3.png" alt="Technician dispatched to customer home" loading="lazy" />
                <span class="hiw-mob-pill">STEP 03 OF 06</span>
                <div class="hiw-mob-live">
                  <span class="hiw-mob-live-dot"></span>
                  <span>Live Status</span>
                </div>
              </div>
              <div class="hiw-mob-body">
                <div class="hiw-mob-num">03</div>
                <div class="hiw-mob-title">Technician arrives at your door</div>
                <p class="hiw-mob-desc">A verified Sudhar Lab technician is dispatched with tools and travels directly to your home, ready for the job on arrival.</p>
              </div>
            </div>

            <!-- Card 4 -->
            <div class="hiw-mob-card">
              <div class="hiw-mob-photo">
                <div class="hiw-mob-bg" style="background-image:url('/step4.png')" aria-hidden="true"></div>
                <img src="/step4.png" alt="Technician inspects and diagnoses the appliance" loading="lazy" />
                <span class="hiw-mob-pill">STEP 04 OF 06</span>
                <div class="hiw-mob-live">
                  <span class="hiw-mob-live-dot"></span>
                  <span>Live Status</span>
                </div>
              </div>
              <div class="hiw-mob-body">
                <div class="hiw-mob-num">04</div>
                <div class="hiw-mob-title">We inspect and diagnose</div>
                <p class="hiw-mob-desc">The technician thoroughly examines the appliance in front of you, identifies the exact fault, and records the findings on their tablet.</p>
              </div>
            </div>

            <!-- Card 5 -->
            <div class="hiw-mob-card">
              <div class="hiw-mob-photo">
                <div class="hiw-mob-bg" style="background-image:url('/step5.png')" aria-hidden="true"></div>
                <img src="/step5.png" alt="Repair quote discussed with customer and office" loading="lazy" />
                <span class="hiw-mob-pill">STEP 05 OF 06</span>
                <div class="hiw-mob-live">
                  <span class="hiw-mob-live-dot"></span>
                  <span>Live Status</span>
                </div>
              </div>
              <div class="hiw-mob-body">
                <div class="hiw-mob-num">05</div>
                <div class="hiw-mob-title">We present the repair quote</div>
                <p class="hiw-mob-desc">The technician and our office coordinate to give you a clear, itemised repair estimate. No hidden fees. The decision is entirely yours.</p>
              </div>
            </div>

            <!-- Card 6 -->
            <div class="hiw-mob-card">
              <div class="hiw-mob-photo">
                <div class="hiw-mob-bg" style="background-image:url('/step6.png')" aria-hidden="true"></div>
                <img src="/step6.png" alt="Customer approves and repair begins" loading="lazy" />
                <span class="hiw-mob-pill">STEP 06 OF 06</span>
                <div class="hiw-mob-live">
                  <span class="hiw-mob-live-dot"></span>
                  <span>Live Status</span>
                </div>
              </div>
              <div class="hiw-mob-body">
                <div class="hiw-mob-num">06</div>
                <div class="hiw-mob-title">You approve — repair begins</div>
                <p class="hiw-mob-desc">You review the details on the technician's tablet and give the go-ahead. Work starts immediately, right there in your home.</p>
              </div>
            </div>

          </div><!-- /track -->
        </div><!-- /track-wrap -->

        <!-- Navigation row -->
        <div class="hiw-mob-nav">
          <button class="hiw-mob-arrow" id="hiwMobPrev" aria-label="Previous step">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>

          <div class="hiw-mob-dots" id="hiwMobDots">
            <button class="hiw-mob-dot is-active" data-idx="0" aria-label="Step 1"></button>
            <button class="hiw-mob-dot" data-idx="1" aria-label="Step 2"></button>
            <button class="hiw-mob-dot" data-idx="2" aria-label="Step 3"></button>
            <button class="hiw-mob-dot" data-idx="3" aria-label="Step 4"></button>
            <button class="hiw-mob-dot" data-idx="4" aria-label="Step 5"></button>
            <button class="hiw-mob-dot" data-idx="5" aria-label="Step 6"></button>
          </div>

          <button class="hiw-mob-arrow" id="hiwMobNext" aria-label="Next step">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>

      </div><!-- /hiw-mobile-carousel -->

      <!-- Sticky Scroll Container (Desktop Only) -->
      <div class="hiw-scroll-outer" id="hiwScrollOuter">
      <div class="hiw-storyboard-grid" id="hiwStoryboard">

        <!-- Left: Sticky Interactive Photo Viewport -->
        <div class="hiw-media-column">
          <div class="hiw-media-frame">

            <!-- Dynamic Images: blurred self-fill behind each full photo -->
            <div class="hiw-slide is-active" id="hiwImg0">
              <div class="hiw-slide-bg" style="background-image:url('/step1.png')" aria-hidden="true"></div>
              <img src="/step1.png" alt="Customer submits request on phone" class="hiw-slide-img" loading="lazy" />
            </div>
            <div class="hiw-slide" id="hiwImg1">
              <div class="hiw-slide-bg" style="background-image:url('/step2.png')" aria-hidden="true"></div>
              <img src="/step2.png" alt="Sudhar Lab calls to confirm" class="hiw-slide-img" loading="lazy" />
            </div>
            <div class="hiw-slide" id="hiwImg2">
              <div class="hiw-slide-bg" style="background-image:url('/step3.png')" aria-hidden="true"></div>
              <img src="/step3.png" alt="Technician arrives at door" class="hiw-slide-img" loading="lazy" />
            </div>
            <div class="hiw-slide" id="hiwImg3">
              <div class="hiw-slide-bg" style="background-image:url('/step4.png')" aria-hidden="true"></div>
              <img src="/step4.png" alt="Technician inspects the appliance" class="hiw-slide-img" loading="lazy" />
            </div>
            <div class="hiw-slide" id="hiwImg4">
              <div class="hiw-slide-bg" style="background-image:url('/step5.png')" aria-hidden="true"></div>
              <img src="/step5.png" alt="Repair quote presented to customer" class="hiw-slide-img" loading="lazy" />
            </div>
            <div class="hiw-slide" id="hiwImg5">
              <div class="hiw-slide-bg" style="background-image:url('/step6.png')" aria-hidden="true"></div>
              <img src="/step6.png" alt="Customer approves and repair begins" class="hiw-slide-img" loading="lazy" />
            </div>

            <!-- Top Floating Overlay Badges -->
            <div class="hiw-media-overlay-top">
              <span class="hiw-step-pill" id="hiwStepPill">STEP 01 OF 06</span>
              <div class="hiw-status-live">
                <span class="hiw-status-dot"></span>
                <span>Live Status</span>
              </div>
            </div>

            <!-- Bottom Floating Caption Box -->
            <div class="hiw-media-overlay-bottom">
              <div class="hiw-active-caption-box">
                <span class="hiw-caption-tag" id="hiwCapTag">Step 01 • Instant Online Form</span>
                <div class="hiw-caption-title" id="hiwCapTitle">You submit a request</div>
              </div>
            </div>

          </div>
        </div>

        <!-- Right: Interactive Step Navigator Cards -->
        <div class="hiw-list reveal d1" id="hiwList">

          <!-- Step 1 -->
          <div class="hiw-item is-active" onclick="setHiwStep(0, true)" tabindex="0" role="button" aria-expanded="true">
            <div class="hiw-item-progress-bar"></div>
            <div class="hiw-item-head">
              <div class="hiw-item-num">01</div>
              <h3 class="hiw-item-title">You submit a request</h3>
              <svg class="hiw-item-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
            <div class="hiw-item-body">
              <p class="hiw-item-desc">Take a quick photo of the issue and fill out our simple form. Takes under 60 seconds — no model number or technical knowledge needed.</p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="hiw-item" onclick="setHiwStep(1, true)" tabindex="0" role="button" aria-expanded="false">
            <div class="hiw-item-progress-bar"></div>
            <div class="hiw-item-head">
              <div class="hiw-item-num">02</div>
              <h3 class="hiw-item-title">We call to confirm</h3>
              <svg class="hiw-item-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
            <div class="hiw-item-body">
              <p class="hiw-item-desc">A Sudhar Lab team member calls you directly to verify the details, confirm your address, and agree on a visit time that suits you.</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="hiw-item" onclick="setHiwStep(2, true)" tabindex="0" role="button" aria-expanded="false">
            <div class="hiw-item-progress-bar"></div>
            <div class="hiw-item-head">
              <div class="hiw-item-num">03</div>
              <h3 class="hiw-item-title">Technician arrives at your door</h3>
              <svg class="hiw-item-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
            <div class="hiw-item-body">
              <p class="hiw-item-desc">A verified Sudhar Lab technician is dispatched with tools and travels directly to your home, ready for the job on arrival.</p>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="hiw-item" onclick="setHiwStep(3, true)" tabindex="0" role="button" aria-expanded="false">
            <div class="hiw-item-progress-bar"></div>
            <div class="hiw-item-head">
              <div class="hiw-item-num">04</div>
              <h3 class="hiw-item-title">We inspect and diagnose</h3>
              <svg class="hiw-item-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
            <div class="hiw-item-body">
              <p class="hiw-item-desc">The technician thoroughly examines the appliance in front of you, identifies the exact fault, and records the findings on their tablet.</p>
            </div>
          </div>

          <!-- Step 5 -->
          <div class="hiw-item" onclick="setHiwStep(4, true)" tabindex="0" role="button" aria-expanded="false">
            <div class="hiw-item-progress-bar"></div>
            <div class="hiw-item-head">
              <div class="hiw-item-num">05</div>
              <h3 class="hiw-item-title">We present the repair quote</h3>
              <svg class="hiw-item-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
            <div class="hiw-item-body">
              <p class="hiw-item-desc">The technician and our office coordinate to give you a clear, itemised repair estimate. No hidden fees. The decision is entirely yours.</p>
            </div>
          </div>

          <!-- Step 6 -->
          <div class="hiw-item" onclick="setHiwStep(5, true)" tabindex="0" role="button" aria-expanded="false">
            <div class="hiw-item-progress-bar"></div>
            <div class="hiw-item-head">
              <div class="hiw-item-num">06</div>
              <h3 class="hiw-item-title">You approve — repair begins</h3>
              <svg class="hiw-item-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
            <div class="hiw-item-body">
              <p class="hiw-item-desc">You review the details on the technician's tablet and give the go-ahead. Work starts immediately, right there in your home.</p>
            </div>
          </div>

        </div>

      </div><!-- /hiw-storyboard-grid -->
      </div><!-- /hiw-scroll-outer -->

      <!-- Reassurance Strip -->
      <div class="hiw-strip reveal">
        <div class="hiw-strip-left">
          <div class="hiw-strip-icon">
            <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="50" cy="50" r="50" fill="none" />
              <path
                d="M40 70C34.4772 70 30 65.5228 30 60V50C30 38.9543 38.9543 30 50 30C61.0457 30 70 38.9543 70 50V60C70 65.5228 65.5228 70 60 70H40Z"
                fill="#0C7C82" opacity="0.1" />
              <path
                d="M40 70C34.4772 70 30 65.5228 30 60V50C30 38.9543 38.9543 30 50 30C61.0457 30 70 38.9543 70 50V60C70 65.5228 65.5228 70 60 70H40Z"
                stroke="#0C7C82" stroke-width="3" stroke-linecap="round" />
              <path d="M30 55H25C22.2386 55 20 52.7614 20 50C20 47.2386 22.2386 45 25 45H30" stroke="#0C7C82"
                stroke-width="3" stroke-linecap="round" />
              <path d="M70 55H75C77.7614 55 80 52.7614 80 50C80 47.2386 77.7614 45 75 45H70" stroke="#0C7C82"
                stroke-width="3" stroke-linecap="round" />
              <path d="M40 45C40 45 42 50 50 50C58 50 60 45 60 45" stroke="#0C7C82" stroke-width="3"
                stroke-linecap="round" />
              <path d="M75 65C83 60 88 50 88 40" stroke="#0C7C82" stroke-width="3" stroke-linecap="round"
                stroke-dasharray="2 4" />
            </svg>
          </div>
          <div class="hiw-strip-text">
            <h4>Not sure what information to provide?</h4>
            <p>That's okay. Just describe what happened and our team will guide you.</p>
          </div>
        </div>
        <div class="hiw-strip-btns">
          <a href="#request" class="btn btn-teal" style="font-size:14px;padding:14px 28px;">Get My Appliance Checked
            &rarr;</a>
          <a href={SITE_PHONE_HREF} class="btn-outline-pill">
            <svg class="teal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
              stroke-linejoin="round">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
              </path>
            </svg>
            Call Us
          </a>
        </div>
      </div>
    </div>
  </section>
